    "test:consumer-governance": "node scripts/test-consumer-governance.mjs",
    "test:sync-all-transaction": "node scripts/test-sync-all-transaction.mjs",
    "release:bom": "node scripts/build-release-bom.mjs",
    "release:verify": "node scripts/build-release-bom.mjs --verify",
    "test:release-supply-chain": "node scripts/test-release-bom.mjs",
    "test:workflow-security": "node --test scripts/test-workflow-security.mjs",
    "test:governance-anchor": "node --test scripts/test-governance-anchor-preflight.mjs",
    "test:privileged-change-authorization": "node --test scripts/test-privileged-change-authorization.mjs",
    "test:consumer-source-harness": "node --test scripts/test-consumer-source-harness.mjs",
