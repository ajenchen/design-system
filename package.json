    "governance:metadata:check": "node scripts/generate-governance-metadata.mjs --check",
    "governance:plugin-aliases:generate": "node scripts/sync-plugin-aliases.mjs --generate",
    "governance:plugin-aliases:check": "node scripts/sync-plugin-aliases.mjs --check",
    "governance:doctor": "node packages/governance/bin/governance.mjs doctor --repo . --role ds-author --hooks-off",
    "governance:attest": "node packages/governance/bin/governance.mjs attest --repo . --role ds-author --hooks-off",
    "test:governance-control-plane": "npm -w @qijenchen/governance test",
    "test:governance-harnesses": "node infra/governance/bin/run-harnesses.mjs",
    "test:gate-meta-isolation": "node scripts/test-run-gate-meta-tests-isolation.mjs",
