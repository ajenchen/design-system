{
  "name": "ui-playground",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:4.0.9-24@sha256:21f15d367bfc5ceadabb9989be48029cba1e6bd80da323405232614a267a9c45",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {}
  },
  "forwardPorts": [6006, 5173],
  "portsAttributes": {
    "6006": { "label": "Storybook", "onAutoForward": "openPreview" },
    "5173": { "label": "Vite Dev", "onAutoForward": "notify" }
  },
  "postCreateCommand": ["node", ".devcontainer/post-create.mjs"],
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "remoteUser": "node"
}
