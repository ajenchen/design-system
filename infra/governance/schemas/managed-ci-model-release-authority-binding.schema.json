{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/managed-ci-model-release-authority-binding-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "requestModelId", "observedResponseModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "modelIdentityPolicyDigest", "modelReleaseValidFrom", "modelReleaseValidUntil", "providerInvocationWindow", "exchangeInvocationObservations", "authorityReceipt", "sourceReadback", "revocationReadback", "auditReadback"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "managed-ci-model-release-authority-binding-v1"},
    "requestModelId": {"$ref": "#/$defs/modelId"},
    "observedResponseModelId": {"$ref": "#/$defs/modelId"},
    "modelReleaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"},
    "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
    "modelIdentityPolicyDigest": {"$ref": "#/$defs/sha256"},
    "modelReleaseValidFrom": {"$ref": "#/$defs/time"},
    "modelReleaseValidUntil": {"$ref": "#/$defs/time"},
    "providerInvocationWindow": {"$ref": "#/$defs/window"},
    "exchangeInvocationObservations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exchangeObservation"}},
    "authorityReceipt": {"$ref": "#/$defs/authorityReceipt"},
    "sourceReadback": {"$ref": "#/$defs/sourceReadback"},
    "revocationReadback": {"$ref": "#/$defs/revocationReadback"},
    "auditReadback": {"$ref": "#/$defs/auditReadback"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "modelId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "providerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,256}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "time": {"type": "string", "format": "date-time"},
    "window": {"type": "object", "additionalProperties": false, "required": ["startedAt", "finishedAt"], "properties": {"startedAt": {"$ref": "#/$defs/time"}, "finishedAt": {"$ref": "#/$defs/time"}}},
    "exchangeObservation": {"type": "object", "additionalProperties": false, "required": ["shardId", "providerRunId", "responseSha256", "observedAt"], "properties": {"shardId": {"$ref": "#/$defs/sha256"}, "providerRunId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[\\x21-\\x7e]+$"}, "responseSha256": {"$ref": "#/$defs/sha256"}, "observedAt": {"$ref": "#/$defs/time"}}},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,120}$"},
    "issuerKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "issuerSubject": {"type": "string", "minLength": 1, "maxLength": 512},
    "validator": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1024}, {"type": "null"}]},
    "authorityReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "receiptId", "tenantId", "providerId", "requestModelId", "observedResponseModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "modelIdentityPolicyDigest", "modelReleaseValidFrom", "modelReleaseValidUntil", "providerInvocationWindowDigest", "exchangeInvocationObservationsDigest", "sourceReadbackDigest", "revocationReadbackDigest", "replayLedgerReceiptDigest", "issuedAt", "expiresAt", "nonce", "issuerKeyId", "issuerSubject", "signatureAlgorithm", "signature"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "managed-ci-model-release-authority-receipt-v1"},
        "receiptId": {"$ref": "#/$defs/identifier"}, "tenantId": {"const": "ajenchen-design-system"}, "providerId": {"$ref": "#/$defs/providerId"},
        "requestModelId": {"$ref": "#/$defs/modelId"}, "observedResponseModelId": {"$ref": "#/$defs/modelId"}, "modelReleaseId": {"type": "string"},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"}, "modelIdentityPolicyDigest": {"$ref": "#/$defs/sha256"},
        "modelReleaseValidFrom": {"$ref": "#/$defs/time"}, "modelReleaseValidUntil": {"$ref": "#/$defs/time"},
        "providerInvocationWindowDigest": {"$ref": "#/$defs/sha256"}, "exchangeInvocationObservationsDigest": {"$ref": "#/$defs/sha256"},
        "sourceReadbackDigest": {"$ref": "#/$defs/sha256"}, "revocationReadbackDigest": {"$ref": "#/$defs/sha256"}, "replayLedgerReceiptDigest": {"$ref": "#/$defs/sha256"},
        "issuedAt": {"$ref": "#/$defs/time"}, "expiresAt": {"$ref": "#/$defs/time"}, "nonce": {"$ref": "#/$defs/nonce"},
        "issuerKeyId": {"$ref": "#/$defs/issuerKeyId"}, "issuerSubject": {"$ref": "#/$defs/issuerSubject"}, "signatureAlgorithm": {"const": "Ed25519"}, "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "sourceReadback": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "readbackId", "providerId", "requestModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "modelIdentityPolicyDigest", "sourceUrl", "sourceHost", "finalUrl", "redirectCount", "tlsVersion", "etag", "lastModified", "bodySha256", "bodyBytes", "retrievedAt", "expiresAt", "nonce", "issuerKeyId", "issuerSubject", "signatureAlgorithm", "signature"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "managed-ci-model-release-source-readback-v1"}, "readbackId": {"$ref": "#/$defs/identifier"},
        "providerId": {"$ref": "#/$defs/providerId"}, "requestModelId": {"$ref": "#/$defs/modelId"}, "modelReleaseId": {"type": "string"},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"}, "modelIdentityPolicyDigest": {"$ref": "#/$defs/sha256"},
        "sourceUrl": {"type": "string", "format": "uri"}, "sourceHost": {"type": "string", "format": "hostname"}, "finalUrl": {"type": "string", "format": "uri"},
        "redirectCount": {"const": 0}, "tlsVersion": {"const": "TLSv1.3"}, "etag": {"$ref": "#/$defs/validator"}, "lastModified": {"$ref": "#/$defs/validator"},
        "bodySha256": {"$ref": "#/$defs/sha256"}, "bodyBytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "retrievedAt": {"$ref": "#/$defs/time"}, "expiresAt": {"$ref": "#/$defs/time"}, "nonce": {"$ref": "#/$defs/nonce"},
        "issuerKeyId": {"$ref": "#/$defs/issuerKeyId"}, "issuerSubject": {"$ref": "#/$defs/issuerSubject"}, "signatureAlgorithm": {"const": "Ed25519"}, "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "revocationReadback": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "readbackId", "providerId", "requestModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "registryUrl", "registryHost", "finalUrl", "redirectCount", "tlsVersion", "etag", "lastModified", "bodySha256", "bodyBytes", "status", "checkedAt", "expiresAt", "nonce", "issuerKeyId", "issuerSubject", "signatureAlgorithm", "signature"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "managed-ci-model-release-revocation-readback-v1"}, "readbackId": {"$ref": "#/$defs/identifier"},
        "providerId": {"$ref": "#/$defs/providerId"}, "requestModelId": {"$ref": "#/$defs/modelId"}, "modelReleaseId": {"type": "string"},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
        "registryUrl": {"type": "string", "format": "uri"}, "registryHost": {"type": "string", "format": "hostname"}, "finalUrl": {"type": "string", "format": "uri"},
        "redirectCount": {"const": 0}, "tlsVersion": {"const": "TLSv1.3"}, "etag": {"$ref": "#/$defs/validator"}, "lastModified": {"$ref": "#/$defs/validator"},
        "bodySha256": {"$ref": "#/$defs/sha256"}, "bodyBytes": {"type": "integer", "minimum": 1, "maximum": 4194304}, "status": {"const": "not-revoked"},
        "checkedAt": {"$ref": "#/$defs/time"}, "expiresAt": {"$ref": "#/$defs/time"}, "nonce": {"$ref": "#/$defs/nonce"},
        "issuerKeyId": {"$ref": "#/$defs/issuerKeyId"}, "issuerSubject": {"$ref": "#/$defs/issuerSubject"}, "signatureAlgorithm": {"const": "Ed25519"}, "signature": {"$ref": "#/$defs/signature"}
      }
    },
    "auditReadback": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "readbackId", "eventId", "receiptId", "tenantId", "providerId", "requestModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "auditUrl", "auditHost", "finalUrl", "redirectCount", "tlsVersion", "appendOnly", "eventHeadDigest", "authorityReceiptDigest", "sourceReadbackDigest", "revocationReadbackDigest", "replayLedgerReceiptDigest", "observedAt", "expiresAt", "nonce", "issuerKeyId", "issuerSubject", "signatureAlgorithm", "signature"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "managed-ci-model-release-audit-readback-v1"}, "readbackId": {"$ref": "#/$defs/identifier"}, "eventId": {"$ref": "#/$defs/identifier"}, "receiptId": {"$ref": "#/$defs/identifier"}, "tenantId": {"const": "ajenchen-design-system"},
        "providerId": {"$ref": "#/$defs/providerId"}, "requestModelId": {"$ref": "#/$defs/modelId"}, "modelReleaseId": {"type": "string"},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
        "auditUrl": {"type": "string", "format": "uri"}, "auditHost": {"type": "string", "format": "hostname"}, "finalUrl": {"type": "string", "format": "uri"},
        "redirectCount": {"const": 0}, "tlsVersion": {"const": "TLSv1.3"}, "appendOnly": {"const": true}, "eventHeadDigest": {"$ref": "#/$defs/sha256"},
        "authorityReceiptDigest": {"$ref": "#/$defs/sha256"}, "sourceReadbackDigest": {"$ref": "#/$defs/sha256"}, "revocationReadbackDigest": {"$ref": "#/$defs/sha256"}, "replayLedgerReceiptDigest": {"$ref": "#/$defs/sha256"},
        "observedAt": {"$ref": "#/$defs/time"}, "expiresAt": {"$ref": "#/$defs/time"}, "nonce": {"$ref": "#/$defs/nonce"},
        "issuerKeyId": {"$ref": "#/$defs/issuerKeyId"}, "issuerSubject": {"$ref": "#/$defs/issuerSubject"}, "signatureAlgorithm": {"const": "Ed25519"}, "signature": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
