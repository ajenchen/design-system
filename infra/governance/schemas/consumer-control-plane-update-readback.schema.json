{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/consumer-control-plane-update-readback-v1.schema.json",
  "title": "Issuer-registry quorum-signed external GitHub observer receipt for a reviewed consumer control-plane update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "kind", "repositoryId", "repository", "protocolId",
    "protocolSpecificationSha256", "protocolSchemaSha256", "protocolImplementationSha256",
    "controlPlaneImplementationSha256", "controlPlanePolicySha256",
    "controlPlanePlanSchemaSha256", "controlPlaneSnapshotVerificationSchemaSha256",
    "controlPlaneReadbackSchemaSha256", "controlPlaneReadbackVerificationSchemaSha256",
    "controlPlaneAcceptanceProposalSchemaSha256", "controlPlaneBaselineReceiptSchemaSha256",
    "managedReposSchemaSha256", "engineClosureSha256", "updateMode", "sourceProfile",
    "postUpdateProfile", "sequence", "predecessorReadbackSha256",
    "baseDefaultBranchHeadSha", "pullRequestNumber", "pullRequestHeadSha",
    "mergeCommitSha", "mergeTreeSha", "defaultBranchHeadSha",
    "candidateSourceCommit", "candidateSourceTree", "version",
    "candidateReleaseSha256", "releaseBomSha256", "consumerLockSha256",
    "forkCorpusLockSha256", "templateStaticTreeSha256", "candidateCorpusReceiptSha256",
    "fullSnapshotPlanDigest", "currentSnapshotTreeSha256", "baseSnapshotTreeSha256",
    "incomingSnapshotTreeSha256", "materializedGovernanceTreeSha256",
    "snapshotVerificationDigest", "requiredChecks", "requiredChecksComplete",
    "requiredApprovingReviewCount", "reviews", "reviewsComplete",
    "dismissStaleReviewsRequired", "ordinaryUpdaterUsed", "candidateCodeExecuted", "eligible",
    "mergedAt", "observedAt", "issuerRegistryDigest", "quorum", "nonce",
    "issuedAt", "expiresAt", "signatures"
  ],
  "properties": {
    "$schema": {"const": "https://qijenchen.dev/schemas/consumer-control-plane-update-readback-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "consumer-governance-control-plane-update-readback"},
    "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "protocolId": {"const": "protected-base-reconstruction-v2"},
    "protocolSpecificationSha256": {"$ref": "#/$defs/sha256"},
    "protocolSchemaSha256": {"$ref": "#/$defs/sha256"},
    "protocolImplementationSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneImplementationSha256": {"$ref": "#/$defs/sha256"},
    "controlPlanePolicySha256": {"$ref": "#/$defs/sha256"},
    "controlPlanePlanSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneSnapshotVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneReadbackSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneReadbackVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneAcceptanceProposalSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneBaselineReceiptSchemaSha256": {"$ref": "#/$defs/sha256"},
    "managedReposSchemaSha256": {"$ref": "#/$defs/sha256"},
    "engineClosureSha256": {"$ref": "#/$defs/sha256"},
    "updateMode": {"const": "recurring-reviewed-full-snapshot-pr"},
    "sourceProfile": {"type": "string", "minLength": 1},
    "postUpdateProfile": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "predecessorReadbackSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "baseDefaultBranchHeadSha": {"$ref": "#/$defs/gitOid"},
    "pullRequestNumber": {"type": "integer", "minimum": 1},
    "pullRequestHeadSha": {"$ref": "#/$defs/gitOid"},
    "mergeCommitSha": {"$ref": "#/$defs/gitOid"},
    "mergeTreeSha": {"$ref": "#/$defs/gitOid"},
    "defaultBranchHeadSha": {"$ref": "#/$defs/gitOid"},
    "candidateSourceCommit": {"$ref": "#/$defs/gitOid"},
    "candidateSourceTree": {"$ref": "#/$defs/gitOid"},
    "version": {"type": "string", "minLength": 1},
    "candidateReleaseSha256": {"$ref": "#/$defs/sha256"},
    "releaseBomSha256": {"$ref": "#/$defs/sha256"},
    "consumerLockSha256": {"$ref": "#/$defs/sha256"},
    "forkCorpusLockSha256": {"$ref": "#/$defs/sha256"},
    "templateStaticTreeSha256": {"$ref": "#/$defs/sha256"},
    "candidateCorpusReceiptSha256": {"$ref": "#/$defs/sha256"},
    "fullSnapshotPlanDigest": {"$ref": "#/$defs/sha256"},
    "currentSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "baseSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "incomingSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "materializedGovernanceTreeSha256": {"$ref": "#/$defs/sha256"},
    "snapshotVerificationDigest": {"$ref": "#/$defs/sha256"},
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/requiredCheck"}
    },
    "requiredChecksComplete": {"const": true},
    "requiredApprovingReviewCount": {"const": 0},
    "reviews": {
      "type": "array",
      "maxItems": 0,
      "items": {"$ref": "#/$defs/review"}
    },
    "reviewsComplete": {"const": true},
    "dismissStaleReviewsRequired": {"const": true},
    "ordinaryUpdaterUsed": {"const": false},
    "candidateCodeExecuted": {"const": false},
    "eligible": {"const": true},
    "mergedAt": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "minLength": 1},
    "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
    "quorum": {"type": "integer", "minimum": 1, "maximum": 5},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$"},
    "issuedAt": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "minLength": 1},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/signature"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context", "status", "conclusion", "headSha", "workflowIdentityDigest",
        "runId", "runAttempt", "completedAt"
      ],
      "properties": {
        "context": {"type": "string", "minLength": 1, "maxLength": 512},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "headSha": {"$ref": "#/$defs/gitOid"},
        "workflowIdentityDigest": {"$ref": "#/$defs/sha256"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "completedAt": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "state", "commitSha", "reviewDigest", "submittedAt"],
      "properties": {
        "actorId": {"type": "string", "minLength": 1, "maxLength": 512},
        "state": {"const": "APPROVED"},
        "commitSha": {"$ref": "#/$defs/gitOid"},
        "reviewDigest": {"$ref": "#/$defs/sha256"},
        "submittedAt": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerKeyId", "subject", "signature"],
      "properties": {
        "signerKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "subject": {"type": "string", "minLength": 1, "maxLength": 512},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
