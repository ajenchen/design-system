{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-ledger-writer-receipt-v1.schema.json",
  "title": "Readback receipt for a protected external-ledger pull request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "completedAt",
    "mutationBoundary",
    "evidenceRole",
    "artifact",
    "artifactIdentityDigest",
    "writerApp",
    "handoff",
    "planDigest",
    "repository",
    "base",
    "head",
    "pullRequest",
    "receiptDigest"
  ],
  "properties": {
    "$schema": {"const": "../schemas/external-ledger-writer-receipt.schema.json"},
    "schemaVersion": {"enum": [1, 2]},
    "kind": {"const": "external-ledger-writer-pr-readback"},
    "completedAt": {"type": "string", "format": "date-time"},
    "mutationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential",
        "environment",
        "directDefaultBranchWritePerformed",
        "mergePerformed",
        "reviewPerformed",
        "candidateCodeExecuted",
        "branchCreated",
        "pullRequestCreated"
      ],
      "properties": {
        "credential": {"const": "dedicated-governance-writer-app"},
        "environment": {"const": "governance-external-ledger"},
        "directDefaultBranchWritePerformed": {"const": false},
        "mergePerformed": {"const": false},
        "reviewPerformed": {"const": false},
        "candidateCodeExecuted": {"const": false},
        "branchCreated": {"type": "boolean"},
        "pullRequestCreated": {"type": "boolean"}
      }
    },
    "evidenceRole": {
      "const": {
        "transientRunArtifact": true,
        "retentionDays": 30,
        "canonicalAuthority": false,
        "mutationAuthority": false,
        "mergeAuthority": false,
        "reconstructableFromProtectedGit": true,
        "durableTruth": "protected-git-commit-pr-and-merged-ledger"
      }
    },
    "artifact": {"$ref": "#/$defs/artifact"},
    "artifactIdentityDigest": {"$ref": "#/$defs/sha256"},
    "writerApp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "appSlug",
        "installationId",
        "desiredAppId",
        "signedProbeAppId",
        "signedProbeInstallationId",
        "signedActivationEvidenceSha256",
        "signedActivationObservedAt",
        "signedActivationExpiresAt",
        "actionSha",
        "tokenRepositorySelection",
        "requestedPermissions"
      ],
      "properties": {
        "appId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "appSlug": {"const": "qijenchen-governance-writer"},
        "installationId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "desiredAppId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "signedProbeAppId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "signedProbeInstallationId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "signedActivationEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "signedActivationObservedAt": {"type": "string", "format": "date-time"},
        "signedActivationExpiresAt": {"type": "string", "format": "date-time"},
        "actionSha": {"const": "fee1f7d63c2ff003460e3d139729b119787bc349"},
        "tokenRepositorySelection": {
          "type": "array",
          "prefixItems": [{"$ref": "#/$defs/repository"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "requestedPermissions": {
          "const": {"contents": "write", "pullRequests": "write"}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "bytesSha256",
        "operation",
        "validUntil",
        "validitySemantics"
      ],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "bytesSha256": {"$ref": "#/$defs/sha256"},
        "operation": {"enum": ["external-runtime-certification", "external-activation", "provider-review-capability-certification"]},
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "description": "Writer materialization/readback envelope only; never a merge, review, or approval authority."
        },
        "validitySemantics": {
          "const": "writer-materialization-envelope-only-not-merge-authorization"
        }
      }
    },
    "planDigest": {"$ref": "#/$defs/sha256"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "owner", "defaultBranch"],
      "properties": {
        "fullName": {"$ref": "#/$defs/repository"},
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "defaultBranch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "base": {"$ref": "#/$defs/gitReadback"},
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "commit",
        "tree",
        "parent",
        "commitMessageSha256",
        "author",
        "committer",
        "treeClosure",
        "files"
      ],
      "properties": {
        "ref": {"type": "string", "pattern": "^refs/heads/governance/external-ledger/"},
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"},
        "parent": {"$ref": "#/$defs/gitOid"},
        "commitMessageSha256": {"$ref": "#/$defs/sha256"},
        "author": {"$ref": "#/$defs/gitIdentity"},
        "committer": {"$ref": "#/$defs/gitIdentity"},
        "treeClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseTree", "headTree", "changes", "changedPathCount"],
          "properties": {
            "baseTree": {"$ref": "#/$defs/gitOid"},
            "headTree": {"$ref": "#/$defs/gitOid"},
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "baseState", "mode", "type", "blobSha"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "baseState": {"enum": ["absent", "existing-different"]},
                  "mode": {"const": "100644"},
                  "type": {"const": "blob"},
                  "blobSha": {"$ref": "#/$defs/gitOid"}
                }
              }
            },
            "changedPathCount": {"type": "integer", "minimum": 1, "maximum": 4}
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/fileReadback"}
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url",
        "state",
        "draft",
        "author",
        "baseRef",
        "baseCommit",
        "headRef",
        "headCommit",
        "repository",
        "owner",
        "crossRepository",
        "maintainerCanModify",
        "titleSha256",
        "bodySha256"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"},
        "state": {"const": "open"},
        "draft": {"const": false},
        "author": {"const": "qijenchen-governance-writer[bot]"},
        "baseRef": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
        "baseCommit": {"$ref": "#/$defs/gitOid"},
        "headRef": {"type": "string", "pattern": "^refs/heads/governance/external-ledger/"},
        "headCommit": {"$ref": "#/$defs/gitOid"},
        "repository": {"$ref": "#/$defs/repository"},
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "crossRepository": {"const": false},
        "maintainerCanModify": {"const": false},
        "titleSha256": {"$ref": "#/$defs/sha256"},
        "bodySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "handoff": {
            "type": "object",
            "properties": {
              "operation": {"const": "provider-review-capability-certification"}
            },
            "required": ["operation"]
          }
        },
        "required": ["handoff"]
      },
      "then": {
        "type": "object",
        "properties": {
          "schemaVersion": {"const": 2},
          "base": {
            "type": "object",
            "required": ["ledgers"],
            "properties": {
              "ledgers": {
                "$ref": "#/$defs/gitReadback/properties/ledgers"
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "schemaVersion": {"const": 1},
          "base": {
            "type": "object",
            "required": ["ledger"],
            "properties": {
              "ledger": {
                "$ref": "#/$defs/gitReadback/properties/ledger"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runAttempt", "id", "digest", "name"],
      "properties": {
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "digest": {"$ref": "#/$defs/sha256"},
        "name": {"type": "string", "pattern": "^external-ledger-[1-9][0-9]*-[1-9][0-9]*$"}
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "date"],
      "properties": {
        "name": {"const": "Qijenchen Governance Writer App"},
        "email": {"const": "qijenchen-governance-writer[bot]@users.noreply.github.com"},
        "date": {"type": "string", "format": "date-time"}
      }
    },
    "ledgerReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blobSha", "bytesSha256", "semanticSha256"],
      "properties": {
        "blobSha": {"$ref": "#/$defs/gitOid"},
        "bytesSha256": {"$ref": "#/$defs/sha256"},
        "semanticSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "blobSha", "bytesSha256", "semanticSha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "mode": {"const": "100644"},
        "blobSha": {"$ref": "#/$defs/gitOid"},
        "bytesSha256": {"$ref": "#/$defs/sha256"},
        "semanticSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "gitReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit", "tree"],
      "properties": {
        "ref": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"},
        "ledger": {"$ref": "#/$defs/ledgerReadback"},
        "ledgers": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/namedLedgerReadback"},
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "const": "infra/governance/providers/certifications.json"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/namedLedgerReadback"},
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "const": "infra/governance/providers/review-capability-certifications.json"
                    }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "namedLedgerReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blobSha", "bytesSha256", "semanticSha256"],
      "properties": {
        "path": {"type": "string"},
        "blobSha": {"$ref": "#/$defs/gitOid"},
        "bytesSha256": {"$ref": "#/$defs/sha256"},
        "semanticSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
