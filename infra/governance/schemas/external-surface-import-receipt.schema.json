{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-surface-import-receipt-v1.schema.json",
  "title": "Verified content-addressed external surface import receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "verificationStatus", "externalMutationPerformed", "sourceBytesSha256", "artifact", "surface", "receiptDigest"],
  "properties": {
    "$schema": {"const": "../schemas/external-surface-import-receipt.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-surface-import-receipt"},
    "verificationStatus": {"const": "verified"},
    "externalMutationPerformed": {"const": false},
    "sourceBytesSha256": {"$ref": "#/$defs/sha256"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "artifactSha256", "evidenceDigest"],
      "properties": {
        "reference": {"type": "string", "pattern": "^infra/governance/evidence/external-runtime/[a-f0-9]{64}\\.json$"},
        "artifactSha256": {"$ref": "#/$defs/sha256"},
        "evidenceDigest": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "repositoryId", "repositoryRole", "runId", "targetId", "validUntil"],
      "properties": {
        "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repositoryRole": {"enum": ["authority", "template-mirror", "product-consumer"]},
        "runId": {"type": "string", "format": "uuid"},
        "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "validUntil": {"type": "string", "format": "date-time"}
      }
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
