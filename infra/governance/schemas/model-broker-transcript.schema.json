{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/model-broker-transcript-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "runId", "manifestSha256", "task", "provider", "coverage", "broker", "managedAttestationDigest", "shardSet", "exchanges", "reduction", "outcome"],
  "properties": {
    "schemaVersion": {"const": 1},
    "evidenceKind": {"const": "deep-audit-model-broker-transcript"},
    "runId": {"$ref": "#/$defs/runId"},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "task": {"$ref": "#/$defs/task"},
    "provider": {"$ref": "#/$defs/provider"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "broker": {"$ref": "#/$defs/broker"},
    "managedAttestationDigest": {"$ref": "#/$defs/sha256"},
    "shardSet": {"$ref": "#/$defs/shardSet"},
    "exchanges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/exchange"}},
    "reduction": {"$ref": "#/$defs/reduction"},
    "outcome": {"oneOf": [{"$ref": "#/$defs/judgmentOutcome"}, {"$ref": "#/$defs/a1bOutcome"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"task": {"type": "object", "properties": {"kind": {"const": "judgment"}}, "required": ["kind"]}}},
      "then": {
        "properties": {
          "task": {"type": "object", "properties": {"subject": {"type": "integer", "minimum": 1, "maximum": 91}}},
          "outcome": {"$ref": "#/$defs/judgmentOutcome"}
        }
      },
      "else": {
        "properties": {
          "task": {"type": "object", "properties": {"subject": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}}},
          "outcome": {"$ref": "#/$defs/a1bOutcome"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "providerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["kind", "subject"],
      "properties": {"kind": {"enum": ["judgment", "component-a1b"]}, "subject": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 91}, {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}]}}
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["providerId", "runtime", "requestModelId", "modelReleaseId", "modelReleaseBindingDigest", "modelReleaseRegistryDigest", "runtimeCertificationDigest", "modelReleaseAuthorityBinding", "effectivePromotionBindingDigest", "modelAuthorityPolicyDigest", "modelAuthorityBindingSchemaDigest", "modelAuthorityIssuerRegistryDigest"],
      "properties": {
        "providerId": {"$ref": "#/$defs/providerId"},
        "runtime": {"type": "string", "minLength": 1},
        "requestModelId": {"type": "string", "minLength": 1},
        "modelReleaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"},
        "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
        "runtimeCertificationDigest": {"$ref": "#/$defs/sha256"},
        "modelReleaseAuthorityBinding": {"$ref": "https://qijenchen.dev/schemas/managed-ci-model-release-authority-binding-v1.json"},
        "effectivePromotionBindingDigest": {"$ref": "#/$defs/sha256"},
        "modelAuthorityPolicyDigest": {"$ref": "#/$defs/sha256"},
        "modelAuthorityBindingSchemaDigest": {"$ref": "#/$defs/sha256"},
        "modelAuthorityIssuerRegistryDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["inventoryPaths", "inventoryDigest", "filesScanned"],
      "properties": {"inventoryPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "filesScanned": {"type": "integer", "minimum": 1}}
    },
    "broker": {
      "type": "object", "additionalProperties": false,
      "required": ["planDigest", "invocationRegistryDigest", "brokerProfileDigest", "selectedProfileDigest", "modelIdentityPolicyDigest", "resultSchemaSha256", "transportKind", "endpoint", "repositoryAccess", "toolAccess", "workingDirectory", "shardSetDigest", "shardCount", "reductionDigest"],
      "properties": {
        "planDigest": {"$ref": "#/$defs/sha256"}, "invocationRegistryDigest": {"$ref": "#/$defs/sha256"}, "brokerProfileDigest": {"$ref": "#/$defs/sha256"}, "selectedProfileDigest": {"$ref": "#/$defs/sha256"}, "modelIdentityPolicyDigest": {"$ref": "#/$defs/sha256"}, "resultSchemaSha256": {"$ref": "#/$defs/sha256"},
        "transportKind": {"const": "provider-https-json-api"}, "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"}, "repositoryAccess": {"const": "forbidden"}, "toolAccess": {"const": "none-tools-field-omitted"}, "workingDirectory": {"const": "not-applicable-repository-unmounted"},
        "shardSetDigest": {"$ref": "#/$defs/sha256"}, "shardCount": {"type": "integer", "minimum": 1}, "reductionDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "header": {
      "type": "object", "additionalProperties": false, "required": ["name", "value"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "value": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$"}}
    },
    "credential": {
      "type": "object", "additionalProperties": false, "required": ["mode", "header", "scheme"],
      "properties": {"mode": {"const": "managed-oidc-secret-broker"}, "header": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "scheme": {"type": "string", "minLength": 1}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["transportKind", "method", "url", "redirectPolicy", "egressAllowedHosts", "staticHeaders", "credential", "bodyEncoding", "bodyCanonicalJson", "bodyBytes", "bodySha256", "instructionSha256", "dataSha256"],
      "properties": {
        "transportKind": {"const": "provider-https-json-api"},
        "method": {"const": "POST"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "redirectPolicy": {"const": "error"},
        "egressAllowedHosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"}},
        "staticHeaders": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/header"}},
        "credential": {"$ref": "#/$defs/credential"},
        "bodyEncoding": {"const": "canonical-json"},
        "bodyCanonicalJson": {"type": "string", "minLength": 2},
        "bodyBytes": {"type": "integer", "minimum": 2},
        "bodySha256": {"$ref": "#/$defs/sha256"},
        "instructionSha256": {"$ref": "#/$defs/sha256"},
        "dataSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false, "required": ["encoding", "canonicalJson", "bytes", "sha256"],
      "properties": {"encoding": {"const": "canonical-json"}, "canonicalJson": {"type": "string", "minLength": 2}, "bytes": {"type": "integer", "minimum": 2}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "exchange": {
      "type": "object", "additionalProperties": false,
      "required": ["shardId", "batchDigest", "request", "response", "providerRunId", "authorityObservedAt", "requestedModelId", "observedResponseModelId", "terminalObservations", "responseSha256", "resultSchemaSha256", "result"],
      "properties": {
        "shardId": {"$ref": "#/$defs/sha256"},
        "batchDigest": {"$ref": "#/$defs/sha256"},
        "request": {"$ref": "#/$defs/request"},
        "response": {"$ref": "#/$defs/response"},
        "providerRunId": {"type": "string", "minLength": 1},
        "authorityObservedAt": {"type": "string", "format": "date-time"},
        "requestedModelId": {"type": "string", "minLength": 1},
        "observedResponseModelId": {"type": "string", "minLength": 1},
        "terminalObservations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["pointer", "canonicalJson"],
            "properties": {"pointer": {"type": "string", "pattern": "^/"}, "canonicalJson": {"type": "string", "minLength": 1}}
          }
        },
        "responseSha256": {"$ref": "#/$defs/sha256"},
        "resultSchemaSha256": {"$ref": "#/$defs/sha256"},
        "result": {"$ref": "https://qijenchen.dev/schemas/model-broker-shard-result-v1.json"}
      }
    },
    "shardIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "manifestSha256", "head", "tree", "indexDigest", "worktreeFingerprint", "inventoryDigest", "rubricDigest", "providerIdentityDigest", "coverageInventoryDigest", "taskKind", "subject", "brokerPlanDigest", "modelEvidencePlanDigest", "resultSchemaSha256", "sourceSetDigest", "sourceChunkCount", "totalSourceBytes", "inputArtifactSetDigest", "dependencySourceInventoryDigest", "dependencySourceStatus", "dependencySourceFindingsDigest", "dependencySourceDispositionDigest", "dependencySourceUniverseCount", "dependencySourceMaterializedReachableCount", "dependencySourceNotApplicableCount", "dependencySourceUnknownCount", "maxClaimsPerShard"],
      "properties": {
        "runId": {"$ref": "#/$defs/runId"}, "manifestSha256": {"$ref": "#/$defs/sha256"}, "head": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "indexDigest": {"$ref": "#/$defs/sha256"}, "worktreeFingerprint": {"$ref": "#/$defs/sha256"}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "rubricDigest": {"$ref": "#/$defs/sha256"}, "providerIdentityDigest": {"$ref": "#/$defs/sha256"}, "coverageInventoryDigest": {"$ref": "#/$defs/sha256"},
        "taskKind": {"enum": ["judgment", "component-a1b"]}, "subject": {}, "brokerPlanDigest": {"$ref": "#/$defs/sha256"}, "modelEvidencePlanDigest": {"$ref": "#/$defs/sha256"}, "resultSchemaSha256": {"$ref": "#/$defs/sha256"},
        "sourceSetDigest": {"$ref": "#/$defs/sha256"}, "sourceChunkCount": {"type": "integer", "minimum": 1}, "totalSourceBytes": {"type": "integer", "minimum": 0}, "inputArtifactSetDigest": {"$ref": "#/$defs/sha256"},
        "dependencySourceInventoryDigest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "dependencySourceStatus": {"enum": ["verified", "unverifiable", null]}, "dependencySourceFindingsDigest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "dependencySourceDispositionDigest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "dependencySourceUniverseCount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "dependencySourceMaterializedReachableCount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "dependencySourceNotApplicableCount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "dependencySourceUnknownCount": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "maxClaimsPerShard": {"type": "integer", "minimum": 1}
      }
    },
    "inputArtifactSet": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "evidenceKind", "manifestSha256", "head", "tree", "indexDigest", "worktreeFingerprint", "inventoryDigest", "rubricDigest", "providerIdentityDigest", "coverageInventoryDigest", "taskKind", "subject", "brokerPlanDigest", "modelEvidencePlanDigest", "resultSchemaSha256", "sourceSetDigest", "sourceChunkCount", "totalSourceBytes", "artifactSetDigest"],
      "properties": {
        "schemaVersion": {"const": 1}, "evidenceKind": {"const": "deep-audit-model-input-artifact-set"},
        "manifestSha256": {"$ref": "#/$defs/sha256"}, "head": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "indexDigest": {"$ref": "#/$defs/sha256"}, "worktreeFingerprint": {"$ref": "#/$defs/sha256"}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "rubricDigest": {"$ref": "#/$defs/sha256"}, "providerIdentityDigest": {"$ref": "#/$defs/sha256"}, "coverageInventoryDigest": {"$ref": "#/$defs/sha256"},
        "taskKind": {"enum": ["judgment", "component-a1b"]}, "subject": {}, "brokerPlanDigest": {"$ref": "#/$defs/sha256"}, "modelEvidencePlanDigest": {"$ref": "#/$defs/sha256"}, "resultSchemaSha256": {"$ref": "#/$defs/sha256"},
        "sourceSetDigest": {"$ref": "#/$defs/sha256"}, "sourceChunkCount": {"type": "integer", "minimum": 1}, "totalSourceBytes": {"type": "integer", "minimum": 0}, "artifactSetDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "shardSet": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "evidenceKind", "identity", "inputArtifactSet", "shardCount", "shardIds", "shardSetDigest", "shards"],
      "properties": {
        "schemaVersion": {"const": 1}, "evidenceKind": {"const": "deep-audit-content-shard-set"}, "identity": {"$ref": "#/$defs/shardIdentity"},
        "inputArtifactSet": {"$ref": "#/$defs/inputArtifactSet"}, "shardCount": {"type": "integer", "minimum": 1}, "shardIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "shardSetDigest": {"$ref": "#/$defs/sha256"}, "shards": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "reduction": {
      "type": "object", "additionalProperties": false, "required": ["shardCount", "shardResultDigest", "findings", "dependencySourceStatus", "claimStatus"],
      "properties": {
        "shardCount": {"type": "integer", "minimum": 1}, "shardResultDigest": {"$ref": "#/$defs/sha256"}, "findings": {"type": "array"},
        "dependencySourceStatus": {"enum": ["verified", "unverifiable", null]}, "claimStatus": {"enum": ["closed", "unverifiable", null]}
      }
    },
    "severity": {"enum": ["blocking", "material", "marginal"]},
    "judgmentFinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "severity", "rule", "problem", "recommendation"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "line": {"type": "integer", "minimum": 1}, "severity": {"$ref": "#/$defs/severity"}, "rule": {"type": "string", "minLength": 1}, "problem": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}
    },
    "falseClaim": {
      "type": "object", "additionalProperties": false, "required": ["claimId", "path", "line", "severity", "claim", "actual", "recommendation"],
      "properties": {"claimId": {"$ref": "#/$defs/sha256"}, "path": {"$ref": "#/$defs/safePath"}, "line": {"type": "integer", "minimum": 1}, "severity": {"$ref": "#/$defs/severity"}, "claim": {"type": "string", "minLength": 1}, "actual": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}
    },
    "claimReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "status", "claimInventoryDigest", "claimCount", "verdictDigest", "verifiedCount", "falseCount", "unverifiableCount", "supportingSourceSetDigest", "supportingSourceCount", "dependencySourceFindingsDigest", "dependencySourceFindingCount"],
      "properties": {
        "schemaVersion": {"const": 1}, "status": {"enum": ["verified", "unverifiable"]}, "claimInventoryDigest": {"$ref": "#/$defs/sha256"}, "claimCount": {"type": "integer", "minimum": 1}, "verdictDigest": {"$ref": "#/$defs/sha256"},
        "verifiedCount": {"type": "integer", "minimum": 0}, "falseCount": {"type": "integer", "minimum": 0}, "unverifiableCount": {"type": "integer", "minimum": 0}, "supportingSourceSetDigest": {"$ref": "#/$defs/sha256"}, "supportingSourceCount": {"type": "integer", "minimum": 1}, "dependencySourceFindingsDigest": {"$ref": "#/$defs/sha256"}, "dependencySourceFindingCount": {"type": "integer", "minimum": 0}
      }
    },
    "judgmentOutcome": {
      "type": "object", "additionalProperties": false, "required": ["kind", "dim", "findings"],
      "properties": {"kind": {"const": "judgment"}, "dim": {"type": "integer", "minimum": 1, "maximum": 91}, "findings": {"type": "array", "items": {"$ref": "#/$defs/judgmentFinding"}}}
    },
    "a1bOutcome": {
      "type": "object", "additionalProperties": false, "required": ["kind", "component", "claimsVerified", "falseClaims", "claimReceipt"],
      "properties": {"kind": {"const": "component-a1b"}, "component": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}, "claimsVerified": {"type": "integer", "minimum": 1}, "falseClaims": {"type": "array", "items": {"$ref": "#/$defs/falseClaim"}}, "claimReceipt": {"$ref": "#/$defs/claimReceipt"}}
    }
  }
}
