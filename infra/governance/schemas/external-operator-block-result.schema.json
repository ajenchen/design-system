{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-operator-block-result-v1.schema.json",
  "title": "Typed external operator blocker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "ready", "externalMutationPerformed", "blockers"],
  "properties": {
    "$schema": {"const": "../schemas/external-operator-block-result.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-operator-block-result"},
    "ready": {"const": false},
    "externalMutationPerformed": {"const": false},
    "blockers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "detail": {"type": "string", "minLength": 1, "maxLength": 12000}
        }
      }
    }
  }
}
