{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/consumer-control-plane-update-readback-verification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "kind", "readOnly", "mutationAuthorized",
    "candidateCodeExecuted", "repositoryId", "inventorySha256",
    "candidateReleaseSha256", "releaseBomSha256", "protocolId",
    "protocolSpecificationSha256", "protocolSchemaSha256",
    "protocolImplementationSha256", "controlPlaneImplementationSha256",
    "controlPlanePolicySha256", "controlPlanePlanSchemaSha256",
    "controlPlaneSnapshotVerificationSchemaSha256", "controlPlaneReadbackSchemaSha256",
    "controlPlaneReadbackVerificationSchemaSha256",
    "controlPlaneAcceptanceProposalSchemaSha256",
    "controlPlaneBaselineReceiptSchemaSha256", "managedReposSchemaSha256",
    "engineClosureSha256", "sourceProfile", "postUpdateProfile", "sequence",
    "predecessorReadbackSha256", "planDigest", "snapshotVerificationDigest",
    "materializedSnapshotTreeSha256", "materializedGitTreeSha", "baselineEvidenceSha256",
    "baseSnapshotTreeSha256", "incomingSnapshotTreeSha256",
    "candidateCorpusReceiptSha256", "mergeCommitSha", "mergeTreeSha",
    "issuerRegistryDigest", "observerNonce", "acceptedControlPlaneReadbackSha256",
    "verificationDigest"
  ],
  "properties": {
    "$schema": {"const": "https://qijenchen.dev/schemas/consumer-control-plane-update-readback-verification-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "consumer-control-plane-update-independent-readback-verification"},
    "readOnly": {"const": true},
    "mutationAuthorized": {"const": false},
    "candidateCodeExecuted": {"const": false},
    "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "inventorySha256": {"$ref": "#/$defs/sha256"},
    "candidateReleaseSha256": {"$ref": "#/$defs/sha256"},
    "releaseBomSha256": {"$ref": "#/$defs/sha256"},
    "protocolId": {"const": "protected-base-reconstruction-v2"},
    "protocolSpecificationSha256": {"$ref": "#/$defs/sha256"},
    "protocolSchemaSha256": {"$ref": "#/$defs/sha256"},
    "protocolImplementationSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneImplementationSha256": {"$ref": "#/$defs/sha256"},
    "controlPlanePolicySha256": {"$ref": "#/$defs/sha256"},
    "controlPlanePlanSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneSnapshotVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneReadbackSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneReadbackVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneAcceptanceProposalSchemaSha256": {"$ref": "#/$defs/sha256"},
    "controlPlaneBaselineReceiptSchemaSha256": {"$ref": "#/$defs/sha256"},
    "managedReposSchemaSha256": {"$ref": "#/$defs/sha256"},
    "engineClosureSha256": {"$ref": "#/$defs/sha256"},
    "sourceProfile": {"type": "string", "minLength": 1},
    "postUpdateProfile": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "predecessorReadbackSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "planDigest": {"$ref": "#/$defs/sha256"},
    "snapshotVerificationDigest": {"$ref": "#/$defs/sha256"},
    "materializedSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "materializedGitTreeSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "baselineEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "baseSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "incomingSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
    "candidateCorpusReceiptSha256": {"$ref": "#/$defs/sha256"},
    "mergeCommitSha": {"$ref": "#/$defs/gitOid"},
    "mergeTreeSha": {"$ref": "#/$defs/gitOid"},
    "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
    "observerNonce": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$"},
    "acceptedControlPlaneReadbackSha256": {"$ref": "#/$defs/sha256"},
    "verificationDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"}
  }
}
