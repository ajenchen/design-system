{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/consumer-control-plane-update-plan-v1.schema.json",
  "title": "Digest-bound recurring reviewed consumer control-plane update plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "kind", "readOnly", "mutationAuthorized", "repeatable",
    "candidateCodeExecutionAllowed", "repository", "candidate", "protocol", "sourceBindings", "roots",
    "actions", "conflicts", "preserved", "protectedControlPlaneChanges", "expectedSnapshot",
    "summary", "reviewReady", "planDigest"
  ],
  "properties": {
    "$schema": {"const": "https://qijenchen.dev/schemas/consumer-control-plane-update-plan-v1.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "consumer-governance-reviewed-control-plane-update-plan"},
    "readOnly": {"const": true},
    "mutationAuthorized": {"const": false},
    "repeatable": {"const": true},
    "candidateCodeExecutionAllowed": {"const": false},
    "repository": {"$ref": "#/$defs/repository"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "sourceBindings": {"$ref": "#/$defs/sourceBindings"},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "base", "incoming"],
      "properties": {
        "current": {"$ref": "#/$defs/manifest"},
        "base": {"$ref": "#/$defs/manifest"},
        "incoming": {"$ref": "#/$defs/manifest"}
      }
    },
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "preserved": {"type": "array", "items": {"$ref": "#/$defs/preserved"}},
    "protectedControlPlaneChanges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/protectedChange"}
    },
    "expectedSnapshot": {"$ref": "#/$defs/manifest"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "conflicts", "preserved", "protectedControlPlaneChanges", "expectedEntries"],
      "properties": {
        "actions": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0},
        "preserved": {"type": "integer", "minimum": 0},
        "protectedControlPlaneChanges": {"type": "integer", "minimum": 1},
        "expectedEntries": {"type": "integer", "minimum": 0}
      }
    },
    "reviewReady": {"type": "boolean"},
    "planDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f\\u007f\\\\]+$"
    },
    "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
    "ownershipMode": {"enum": ["authority", "generated", "upstream-managed", "three-way", "consumer-owned", "ambiguous"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "mode": {"$ref": "#/$defs/mode"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "state": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/entry"}]},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSha256", "entryCount", "entries"],
      "properties": {
        "treeSha256": {"$ref": "#/$defs/sha256"},
        "entryCount": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "acceptedControlPlaneUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "readbackSha256", "predecessorReadbackSha256",
        "candidateReleaseSha256", "version", "baselineEvidenceSha256",
        "baseSnapshotTreeSha256", "incomingSnapshotTreeSha256",
        "materializedSnapshotTreeSha256", "candidateCorpusReceiptSha256",
        "mergeCommitSha", "mergeTreeSha", "issuerRegistryDigest"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "readbackSha256": {"$ref": "#/$defs/sha256"},
        "predecessorReadbackSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "candidateReleaseSha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "baselineEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "baseSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
        "incomingSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
        "materializedSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
        "candidateCorpusReceiptSha256": {"$ref": "#/$defs/sha256"},
        "mergeCommitSha": {"$ref": "#/$defs/gitOid"},
        "mergeTreeSha": {"$ref": "#/$defs/gitOid"},
        "issuerRegistryDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "github", "inventorySha256", "ownershipPolicy", "sourceProfile",
        "postUpdateProfile", "acceptedBootstrapReadbackSha256", "acceptedControlPlaneUpdate",
        "nextSequence", "predecessorReadbackSha256"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "inventorySha256": {"$ref": "#/$defs/sha256"},
        "ownershipPolicy": {"type": "string", "minLength": 1},
        "sourceProfile": {
          "enum": [
            "new-snapshot-v2", "reviewed-bootstrap-established-v2",
            "new-snapshot-control-plane-established-v2",
            "reviewed-bootstrap-control-plane-established-v2"
          ]
        },
        "postUpdateProfile": {
          "enum": [
            "new-snapshot-control-plane-established-v2",
            "reviewed-bootstrap-control-plane-established-v2"
          ]
        },
        "acceptedBootstrapReadbackSha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "acceptedControlPlaneUpdate": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/acceptedControlPlaneUpdate"}]
        },
        "nextSequence": {"type": "integer", "minimum": 1},
        "predecessorReadbackSha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "sourceCommit", "sourceTree", "candidateReleaseSha256", "releaseBomSha256",
        "consumerLockSha256", "forkCorpusLockSha256", "templateStaticTreeSha256",
        "candidateCorpusReceiptSha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"$ref": "#/$defs/gitOid"},
        "sourceTree": {"$ref": "#/$defs/gitOid"},
        "candidateReleaseSha256": {"$ref": "#/$defs/sha256"},
        "releaseBomSha256": {"$ref": "#/$defs/sha256"},
        "consumerLockSha256": {"$ref": "#/$defs/sha256"},
        "forkCorpusLockSha256": {"$ref": "#/$defs/sha256"},
        "templateStaticTreeSha256": {"$ref": "#/$defs/sha256"},
        "candidateCorpusReceiptSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolId", "specificationSha256", "schemaSha256", "implementationSha256",
        "controlPlaneImplementationSha256", "controlPlanePolicySha256", "controlPlanePlanSchemaSha256",
        "controlPlaneSnapshotVerificationSchemaSha256", "controlPlaneReadbackSchemaSha256",
        "controlPlaneReadbackVerificationSchemaSha256", "controlPlaneAcceptanceProposalSchemaSha256",
        "controlPlaneBaselineReceiptSchemaSha256", "managedReposSchemaSha256",
        "engineClosureSha256", "updateMode", "evidenceContract"
      ],
      "properties": {
        "protocolId": {"const": "protected-base-reconstruction-v2"},
        "specificationSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"},
        "implementationSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneImplementationSha256": {"$ref": "#/$defs/sha256"},
        "controlPlanePolicySha256": {"$ref": "#/$defs/sha256"},
        "controlPlanePlanSchemaSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneSnapshotVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneReadbackSchemaSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneReadbackVerificationSchemaSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneAcceptanceProposalSchemaSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneBaselineReceiptSchemaSha256": {"$ref": "#/$defs/sha256"},
        "managedReposSchemaSha256": {"$ref": "#/$defs/sha256"},
        "engineClosureSha256": {"$ref": "#/$defs/sha256"},
        "updateMode": {"const": "recurring-reviewed-full-snapshot-pr"},
        "evidenceContract": {"const": "consumer-governance-control-plane-update-readback-v1"}
      }
    },
    "gitSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectFormat", "commit", "tree"],
      "properties": {
        "objectFormat": {"enum": ["sha1", "sha256"]},
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"}
      }
    },
    "baselineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidenceSha256", "baseSnapshotTreeSha256"],
      "properties": {
        "kind": {"enum": ["signed-external-baseline-receipt", "accepted-control-plane-predecessor"]},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "baseSnapshotTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "kind", "candidateReleaseSha256", "releaseBomSha256",
        "scaffoldLockSha256", "templateStaticTreeSha256", "consumerLockSha256",
        "forkCorpusLockSha256", "incomingSnapshotTreeSha256", "entryCount",
        "receiptSha256"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "bom-bound-product-template-candidate-corpus"},
        "candidateReleaseSha256": {"$ref": "#/$defs/sha256"},
        "releaseBomSha256": {"$ref": "#/$defs/sha256"},
        "scaffoldLockSha256": {"$ref": "#/$defs/sha256"},
        "templateStaticTreeSha256": {"$ref": "#/$defs/sha256"},
        "consumerLockSha256": {"$ref": "#/$defs/sha256"},
        "forkCorpusLockSha256": {"$ref": "#/$defs/sha256"},
        "incomingSnapshotTreeSha256": {"$ref": "#/$defs/sha256"},
        "entryCount": {"type": "integer", "minimum": 1},
        "receiptSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentGit", "baseGit", "baseline", "candidateCorpus"],
      "properties": {
        "currentGit": {"$ref": "#/$defs/gitSnapshot"},
        "baseGit": {"$ref": "#/$defs/gitSnapshot"},
        "baseline": {"$ref": "#/$defs/baselineBinding"},
        "candidateCorpus": {"$ref": "#/$defs/candidateCorpus"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownershipMode", "owner", "operation", "reason", "base", "current", "incoming"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "ownershipMode": {"enum": ["generated", "upstream-managed", "three-way"]},
        "owner": {"type": "string", "minLength": 1},
        "operation": {"enum": ["replace", "delete"]},
        "reason": {"enum": ["reviewed-full-snapshot-replacement", "three-way-incoming-change"]},
        "base": {"$ref": "#/$defs/state"},
        "current": {"$ref": "#/$defs/state"},
        "incoming": {"$ref": "#/$defs/state"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownershipMode", "owner", "reason", "base", "current", "incoming"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "ownershipMode": {"$ref": "#/$defs/ownershipMode"},
        "owner": {"type": ["string", "null"]},
        "reason": {"enum": ["ambiguous-ownership", "incoming-touches-non-upstream-owned-path", "three-way-content-conflict"]},
        "base": {"$ref": "#/$defs/state"},
        "current": {"$ref": "#/$defs/state"},
        "incoming": {"$ref": "#/$defs/state"}
      }
    },
    "preserved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownershipMode", "owner", "reason", "base", "current", "incoming"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "ownershipMode": {"enum": ["authority", "generated", "upstream-managed", "three-way", "consumer-owned"]},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"enum": ["consumer-or-authority-owned", "already-at-reviewed-snapshot", "three-way-consumer-only-change"]},
        "base": {"$ref": "#/$defs/state"},
        "current": {"$ref": "#/$defs/state"},
        "incoming": {"$ref": "#/$defs/state"}
      }
    },
    "protectedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["protected-path", "package-scripts"]},
        "path": {"enum": [".npmrc", ".github/", "governance/bin/", "scripts/", "package.json#scripts"]}
      }
    }
  }
}
