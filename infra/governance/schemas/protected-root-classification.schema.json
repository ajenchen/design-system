{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/protected-root-classification-v1.json",
  "title": "Exhaustive governance protected-root classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "providerProjectionPolicy", "providerRegistryPath", "protectedRoots", "entries"],
  "properties": {
    "$schema": { "const": "schemas/protected-root-classification.schema.json" },
    "schemaVersion": { "const": 1 },
    "providerProjectionPolicy": { "const": "derive-active-generated-views" },
    "providerRegistryPath": { "$ref": "#/$defs/path" },
    "protectedRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "match", "classification", "excludes", "allowAbsent", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "$ref": "#/$defs/path" },
          "match": { "enum": ["file", "tree"] },
          "classification": { "enum": ["canonical-source", "generated-output", "non-authority-exclusion"] },
          "excludes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          },
          "allowAbsent": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
