{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-activation-signing-request-v1.schema.json",
  "title": "Offline external activation completion-attestor signing request",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "readOnly", "externalMutationAuthorized", "algorithm", "signatureDomain", "requiredRole", "requiredQuorum", "ledger", "models", "requirementId", "eligibleSigners", "requirementCanonicalBase64", "requirementSha256", "signingPayloadBase64", "signingPayloadSha256", "requestDigest"],
  "properties": {
    "$schema": {"const": "../schemas/external-activation-signing-request.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-activation-signing-request"},
    "readOnly": {"const": true},
    "externalMutationAuthorized": {"const": false},
    "algorithm": {"const": "ed25519"},
    "signatureDomain": {"const": "external-activation-v3"},
    "requiredRole": {"const": "completion-attestor"},
    "requiredQuorum": {"type": "integer", "minimum": 1, "maximum": 16},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256"],
      "properties": {
        "path": {"const": "infra/governance/external-activation-requirements.json"},
        "beforeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "models": {"$ref": "#/$defs/activationModels"},
    "requirementId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "eligibleSigners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signerKeyId", "subject"],
        "properties": {
          "signerKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "requirementCanonicalBase64": {"type": "string", "minLength": 4, "maxLength": 5592408, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "requirementSha256": {"$ref": "#/$defs/sha256"},
    "signingPayloadBase64": {"type": "string", "minLength": 4, "maxLength": 5592408, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "signingPayloadSha256": {"$ref": "#/$defs/sha256"},
    "requestDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activationModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventorySha256", "desiredSha256", "compatibilityMatrixSha256", "runtimeProfileSha256", "roleSurfacePolicySha256", "releaseRingsSha256", "issuerRegistrySha256", "activationPolicySha256", "mutationBoundaryContractSha256"],
      "properties": {
        "inventorySha256": {"$ref": "#/$defs/sha256"},
        "desiredSha256": {"$ref": "#/$defs/sha256"},
        "compatibilityMatrixSha256": {"$ref": "#/$defs/sha256"},
        "runtimeProfileSha256": {"$ref": "#/$defs/sha256"},
        "roleSurfacePolicySha256": {"$ref": "#/$defs/sha256"},
        "releaseRingsSha256": {"$ref": "#/$defs/sha256"},
        "issuerRegistrySha256": {"$ref": "#/$defs/sha256"},
        "activationPolicySha256": {"$ref": "#/$defs/sha256"},
        "mutationBoundaryContractSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
