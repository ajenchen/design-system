{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/model-evidence-broker-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "evidenceKind", "executionMode", "limits", "budgets", "applicability", "reviewGraph", "transport", "activation"],
  "properties": {
    "$schema": {"const": "schemas/model-evidence-broker.schema.json"},
    "schemaVersion": {"const": 2},
    "evidenceKind": {"const": "deep-audit-model-evidence-broker-plan"},
    "executionMode": {"const": "content-addressed-sharded-broker-v1"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxRawContentBytesPerShard", "maxPromptBytesPerShard", "maxEstimatedTokensPerShard", "bytesPerEstimatedToken", "maxChunkBytes", "maxChunksPerShard", "maxClaimsPerShard"],
      "properties": {
        "maxRawContentBytesPerShard": {"type": "integer", "minimum": 4096, "maximum": 262144},
        "maxPromptBytesPerShard": {"type": "integer", "minimum": 16384, "maximum": 524288},
        "maxEstimatedTokensPerShard": {"type": "integer", "minimum": 4096, "maximum": 131072},
        "bytesPerEstimatedToken": {"type": "integer", "minimum": 2, "maximum": 8},
        "maxChunkBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "maxChunksPerShard": {"type": "integer", "minimum": 1, "maximum": 128},
        "maxClaimsPerShard": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["costUnitPromptBytes", "wholeTask", "dispatchBatch", "fullReview"],
      "properties": {
        "costUnitPromptBytes": {"type": "integer", "minimum": 256, "maximum": 1048576},
        "wholeTask": {"$ref": "#/$defs/dispatchBudget"},
        "dispatchBatch": {"$ref": "#/$defs/dispatchBudget"},
        "fullReview": {"$ref": "#/$defs/fullReviewBudget"}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["judgment", "componentA1b"],
      "properties": {
        "judgment": {"const": "canonical-dimension-all-design-system-and-rubric"},
        "componentA1b": {"const": "frozen-component-exact-claim-inventory"}
      }
    },
    "reviewGraph": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolExtension", "logicalTaskPreservation", "contentDeduplication", "zeroClaimPolicy", "rawCorpusPolicy", "completionPolicy", "synthesisExecution", "unknownApplicability", "maxCanonicalResultBytes", "maxFindingsPerWorkUnit", "maxFindingTextCharacters", "maxSummaryCharacters", "maxPreparedRequestFixedBytes", "maxEvidenceReferenceBytesPerLeaf"],
      "properties": {
        "protocolExtension": {"const": "no-sample-multiplexed-review-graph-v1"},
        "logicalTaskPreservation": {"const": "all-registered-tasks-and-shards"},
        "contentDeduplication": {"const": "content-addressed-model-work-multiplexing"},
        "zeroClaimPolicy": {"const": "shared-review-cell-required-no-standalone-empty-call"},
        "rawCorpusPolicy": {"const": "every-leaf-has-deterministic-disposition-and-review-binding"},
        "completionPolicy": {"const": "exact-cell-closure-before-content-addressed-deterministic-hierarchical-synthesis"},
        "synthesisExecution": {"const": "deterministic-local-reducer-no-provider-call"},
        "unknownApplicability": {"const": "fail-closed"},
        "maxCanonicalResultBytes": {"const": 32768},
        "maxFindingsPerWorkUnit": {"const": 8},
        "maxFindingTextCharacters": {"const": 192},
        "maxSummaryCharacters": {"const": 384},
        "maxPreparedRequestFixedBytes": {"const": 32768},
        "maxEvidenceReferenceBytesPerLeaf": {"const": 1024}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryRead", "promptContent", "response", "reducer"],
      "properties": {
        "repositoryRead": {"const": "forbidden"},
        "promptContent": {"const": "exact-content-addressed-shard"},
        "response": {"const": "schema-closed-per-shard"},
        "reducer": {"const": "deterministic-exact-shard-closure"}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "executionClass", "canonicalDesiredState", "materializedState", "externalReadback", "requiredReceiptBindings", "failureMode"],
      "properties": {
        "contract": {"const": "managed-ci-activation-convergence-v1"},
        "executionClass": {"const": "model-broker"},
        "canonicalDesiredState": {"const": "managed-execution-required"},
        "materializedState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carrierPath", "activationPointer", "verificationReceiptKind"],
          "properties": {
            "carrierPath": {"const": "scripts/managed-ci-trusted-execution-plan.json"},
            "activationPointer": {"const": "/activation"},
            "verificationReceiptKind": {"const": "managed-ci-activation-verification-receipt-v2"}
          }
        },
        "externalReadback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carrierPath", "carrierProjection", "requiredStatus"],
          "properties": {
            "carrierPath": {"const": "infra/governance/external-activation-requirements.json"},
            "carrierProjection": {"const": "external-activation-state-v1"},
            "requiredStatus": {"const": "verified"}
          }
        },
        "requiredReceiptBindings": {
          "type": "array",
          "prefixItems": [
            {"const": "planDigest"},
            {"const": "profileDigest"},
            {"const": "executionClass"},
            {"const": "evidenceKind"},
            {"const": "selectedProvider"},
            {"const": "networkPolicyDigest"},
            {"const": "isolationPolicyDigest"},
            {"const": "permissionsDigest"},
            {"const": "workflowIdentityDigest"},
            {"const": "containerImageDigest"}
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "failureMode": {"const": "fail-closed"}
      }
    }
  },
  "$defs": {
    "reviewGraphExchangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "evidenceKind", "protocol", "protocolExtension", "projectionKind",
        "taskSetDigest", "reviewGraphDigest", "contentSetDigest", "runIdentity",
        "authorProviderId", "reviewerProviderId", "reviewerRuntimeIdentity",
        "reviewerRuntimeSurface", "reviewerRuntimeProfileId", "reviewProfileId",
        "invocationProfileId",
        "requestModelId", "modelReleaseId", "modelReleaseBindingDigest",
        "modelReleaseRegistryDigest", "selectedProfileDigest", "selectionDigest",
        "reviewProfileDigest", "selectedInvocationProfileDigest",
        "selectedCapabilityCertificationDigest", "capabilityCertificationId",
        "capabilityCertificationExpiresAt", "capabilityEvidenceDigest",
        "assuranceTier", "reasoningTier", "computeTier", "responseSelectorDigest",
        "providerReviewBindingDigest",
        "genuineReviewTransport", "carrierProjectionBindingDigest", "requestOrdinal",
        "requestKind", "unitId", "unitDigest", "unitOrdinal", "taskKeys",
        "coverageCellIds", "leafIds", "reviewSemanticsSetDigest",
        "inputKind", "inputIds", "batchId",
        "batchOrdinal", "requestSchema", "expectedResultSchema", "instructions",
        "preparedInputBudget",
        "carrier", "requestDigest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "deep-audit-model-broker-review-graph-request"},
        "protocol": {"const": "content-addressed-sharded-broker-v1"},
        "protocolExtension": {"const": "no-sample-multiplexed-review-graph-v1"},
        "projectionKind": {"const": "provider-neutral-content-addressed-review-graph-envelope"},
        "taskSetDigest": {"$ref": "#/$defs/sha256"},
        "reviewGraphDigest": {"$ref": "#/$defs/sha256"},
        "contentSetDigest": {"$ref": "#/$defs/sha256"},
        "runIdentity": {"$ref": "#/$defs/runIdentity"},
        "authorProviderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "reviewerProviderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "reviewerRuntimeIdentity": {"type": "string", "minLength": 1},
        "reviewerRuntimeSurface": {"type": "string", "minLength": 1},
        "reviewerRuntimeProfileId": {"type": "string", "minLength": 1},
        "reviewProfileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "invocationProfileId": {"type": "string", "minLength": 1},
        "requestModelId": {"type": "string", "minLength": 1},
        "modelReleaseId": {"type": "string", "minLength": 3},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"},
        "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
        "selectedProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectionDigest": {"$ref": "#/$defs/sha256"},
        "reviewProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectedInvocationProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectedCapabilityCertificationDigest": {"$ref": "#/$defs/sha256"},
        "capabilityCertificationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "capabilityCertificationExpiresAt": {"type": "string", "format": "date-time"},
        "capabilityEvidenceDigest": {"$ref": "#/$defs/sha256"},
        "assuranceTier": {"enum": ["standard", "high", "maximum"]},
        "reasoningTier": {"enum": ["standard", "high", "maximum"]},
        "computeTier": {"enum": ["standard", "high", "maximum"]},
        "responseSelectorDigest": {"$ref": "#/$defs/sha256"},
        "providerReviewBindingDigest": {"$ref": "#/$defs/sha256"},
        "genuineReviewTransport": {"type": "string", "minLength": 1},
        "carrierProjectionBindingDigest": {"$ref": "#/$defs/sha256"},
        "requestOrdinal": {"type": "integer", "minimum": 0},
        "requestKind": {"enum": ["review-work", "task-synthesis"]},
        "unitId": {"$ref": "#/$defs/sha256"},
        "unitDigest": {"$ref": "#/$defs/sha256"},
        "unitOrdinal": {"type": "integer", "minimum": 0},
        "taskKeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "coverageCellIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "leafIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "reviewSemanticsSetDigest": {"$ref": "#/$defs/sha256"},
        "inputKind": {"enum": ["not-applicable", "coverage-cells", "synthesis-units"]},
        "inputIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "batchId": {"$ref": "#/$defs/sha256"},
        "batchOrdinal": {"type": "integer", "minimum": 0},
        "requestSchema": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {"const": "model-evidence-broker.schema.json#/$defs/reviewGraphExchangeRequest"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "expectedResultSchema": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaId", "baseResultSchemaSha256", "unitBindingDigest"],
          "properties": {
            "schemaId": {"const": "deep-audit-review-graph-model-result/v1"},
            "baseResultSchemaSha256": {"$ref": "#/$defs/sha256"},
            "unitBindingDigest": {"$ref": "#/$defs/sha256"}
          }
        },
        "instructions": {
          "type": "object", "additionalProperties": false,
          "required": ["encoding", "canonicalText", "bytes", "sha256"],
          "properties": {
            "encoding": {"const": "canonical-json-lines"},
            "canonicalText": {"type": "string", "minLength": 2},
            "bytes": {"type": "integer", "minimum": 2},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "preparedInputBudget": {
          "type": "object", "additionalProperties": false,
          "required": [
            "maxPreparedInputBytes", "maxCanonicalResultBytes",
            "instructionBytes", "reviewSemanticsBytes", "prerequisiteResultCount",
            "prerequisiteResultBytes", "resultSchemaBytes"
          ],
          "properties": {
            "maxPreparedInputBytes": {"type": "integer", "minimum": 1, "maximum": 131072},
            "maxCanonicalResultBytes": {"const": 32768},
            "instructionBytes": {"type": "integer", "minimum": 1},
            "reviewSemanticsBytes": {"type": "integer", "minimum": 0},
            "prerequisiteResultCount": {"type": "integer", "minimum": 0, "maximum": 3},
            "prerequisiteResultBytes": {"type": "integer", "minimum": 0},
            "resultSchemaBytes": {"type": "integer", "minimum": 1}
          }
        },
        "carrier": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "contentSetDigest", "leafSetDigest", "evidenceCarrierBinding", "inputResultRefs", "inputResultSetDigest"],
          "properties": {
            "kind": {"const": "deep-audit-content-addressed-review-graph-carrier"},
            "contentSetDigest": {"$ref": "#/$defs/sha256"},
            "leafSetDigest": {"$ref": "#/$defs/sha256"},
            "evidenceCarrierBinding": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object", "additionalProperties": false,
                  "required": [
                    "leafSetDigest", "minimalLeafReferenceSetDigest", "blobSetDigest",
                    "rawContentBytes", "reviewSemanticsSetDigest", "bindingDigest"
                  ],
                  "properties": {
                    "leafSetDigest": {"$ref": "#/$defs/sha256"},
                    "minimalLeafReferenceSetDigest": {"$ref": "#/$defs/sha256"},
                    "blobSetDigest": {"$ref": "#/$defs/sha256"},
                    "rawContentBytes": {"type": "integer", "minimum": 0},
                    "reviewSemanticsSetDigest": {"$ref": "#/$defs/sha256"},
                    "bindingDigest": {"$ref": "#/$defs/sha256"}
                  }
                }
              ]
            },
            "inputResultRefs": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["inputId", "resultUnitId", "resultSha256", "bytes"],
                "properties": {
                  "inputId": {"$ref": "#/$defs/sha256"},
                  "resultUnitId": {"$ref": "#/$defs/sha256"},
                  "resultSha256": {"$ref": "#/$defs/sha256"},
                  "bytes": {"type": "integer", "minimum": 1}
                }
              }
            },
            "inputResultSetDigest": {"$ref": "#/$defs/sha256"}
          }
        },
        "requestDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewGraphCapabilityBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "evidenceKind", "capabilityCertificationId",
        "selectedCapabilityCertificationDigest", "maxInputBytes", "maxOutputBytes",
        "maxPayloadBytes", "capabilityBudgetDigest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "deep-audit-review-exchange-capability-budget"},
        "capabilityCertificationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "selectedCapabilityCertificationDigest": {"$ref": "#/$defs/sha256"},
        "maxInputBytes": {"type": "integer", "minimum": 1},
        "maxOutputBytes": {"type": "integer", "minimum": 1},
        "maxPayloadBytes": {"type": "integer", "minimum": 2},
        "capabilityBudgetDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewGraphEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leafSetDigest", "minimalLeafReferenceSetDigest", "blobSetDigest",
        "rawContentBytes", "reviewSemanticsSetDigest", "bindingDigest"
      ],
      "properties": {
        "leafSetDigest": {"$ref": "#/$defs/sha256"},
        "minimalLeafReferenceSetDigest": {"$ref": "#/$defs/sha256"},
        "blobSetDigest": {"$ref": "#/$defs/sha256"},
        "rawContentBytes": {"type": "integer", "minimum": 0},
        "reviewSemanticsSetDigest": {"$ref": "#/$defs/sha256"},
        "bindingDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewGraphBatchExchangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "evidenceKind", "protocol", "protocolExtension",
        "projectionKind", "taskSetDigest", "reviewGraphDigest", "contentSetDigest",
        "runIdentity", "authorProviderId", "reviewerProviderId",
        "reviewerRuntimeIdentity", "reviewerRuntimeSurface",
        "reviewerRuntimeProfileId", "reviewProfileId", "invocationProfileId",
        "requestModelId", "modelReleaseId", "modelReleaseBindingDigest",
        "modelReleaseRegistryDigest", "selectedProfileDigest", "selectionDigest",
        "reviewProfileDigest", "selectedInvocationProfileDigest",
        "selectedCapabilityCertificationDigest", "capabilityCertificationId",
        "capabilityCertificationExpiresAt", "capabilityEvidenceDigest",
        "assuranceTier", "reasoningTier", "computeTier", "responseSelectorDigest",
        "providerReviewBindingDigest", "genuineReviewTransport",
        "carrierProjectionBindingDigest", "requestOrdinal", "requestKind",
        "requestBatchId", "requestBatchDigest", "requestBatchOrdinal",
        "capabilityBudget", "capabilityBudgetDigest", "memberCount",
        "memberUnitIds", "memberUnitDigests", "members", "taskKeys",
        "coverageCellIds", "leafIds", "requestSchema", "expectedResultSchema",
        "preparedInputBudget", "carrier", "requestDigest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "deep-audit-model-broker-review-graph-batch-request"},
        "protocol": {"const": "content-addressed-sharded-broker-v1"},
        "protocolExtension": {"const": "no-sample-multiplexed-review-graph-v1"},
        "projectionKind": {"const": "provider-neutral-capability-bounded-content-addressed-review-batch-envelope"},
        "taskSetDigest": {"$ref": "#/$defs/sha256"},
        "reviewGraphDigest": {"$ref": "#/$defs/sha256"},
        "contentSetDigest": {"$ref": "#/$defs/sha256"},
        "runIdentity": {"$ref": "#/$defs/runIdentity"},
        "authorProviderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "reviewerProviderId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "reviewerRuntimeIdentity": {"type": "string", "minLength": 1},
        "reviewerRuntimeSurface": {"type": "string", "minLength": 1},
        "reviewerRuntimeProfileId": {"type": "string", "minLength": 1},
        "reviewProfileId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "invocationProfileId": {"type": "string", "minLength": 1},
        "requestModelId": {"type": "string", "minLength": 1},
        "modelReleaseId": {"type": "string", "minLength": 3},
        "modelReleaseBindingDigest": {"$ref": "#/$defs/sha256"},
        "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"},
        "selectedProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectionDigest": {"$ref": "#/$defs/sha256"},
        "reviewProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectedInvocationProfileDigest": {"$ref": "#/$defs/sha256"},
        "selectedCapabilityCertificationDigest": {"$ref": "#/$defs/sha256"},
        "capabilityCertificationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "capabilityCertificationExpiresAt": {"type": "string", "format": "date-time"},
        "capabilityEvidenceDigest": {"$ref": "#/$defs/sha256"},
        "assuranceTier": {"enum": ["standard", "high", "maximum"]},
        "reasoningTier": {"enum": ["standard", "high", "maximum"]},
        "computeTier": {"enum": ["standard", "high", "maximum"]},
        "responseSelectorDigest": {"$ref": "#/$defs/sha256"},
        "providerReviewBindingDigest": {"$ref": "#/$defs/sha256"},
        "genuineReviewTransport": {"type": "string", "minLength": 1},
        "carrierProjectionBindingDigest": {"$ref": "#/$defs/sha256"},
        "requestOrdinal": {"type": "integer", "minimum": 0},
        "requestKind": {"const": "review-work-batch"},
        "requestBatchId": {"$ref": "#/$defs/sha256"},
        "requestBatchDigest": {"$ref": "#/$defs/sha256"},
        "requestBatchOrdinal": {"type": "integer", "minimum": 0},
        "capabilityBudget": {"$ref": "#/$defs/reviewGraphCapabilityBudget"},
        "capabilityBudgetDigest": {"$ref": "#/$defs/sha256"},
        "memberCount": {"type": "integer", "minimum": 1},
        "memberUnitIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "memberUnitDigests": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memberOrdinal", "unitId", "unitDigest", "unitOrdinal", "unitKind",
              "taskKeys", "coverageCellIds", "leafIds", "reviewSemanticsSetDigest",
              "evidenceCarrierBinding", "expectedResultSchema", "instructions",
              "memberRequestDigest"
            ],
            "properties": {
              "memberOrdinal": {"type": "integer", "minimum": 0},
              "unitId": {"$ref": "#/$defs/sha256"},
              "unitDigest": {"$ref": "#/$defs/sha256"},
              "unitOrdinal": {"type": "integer", "minimum": 0},
              "unitKind": {
                "enum": [
                  "multiplexed-judgment-review", "component-claim-review",
                  "content-addressed-shared-evidence-review"
                ]
              },
              "taskKeys": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "coverageCellIds": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"$ref": "#/$defs/sha256"}
              },
              "leafIds": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"$ref": "#/$defs/sha256"}
              },
              "reviewSemanticsSetDigest": {"$ref": "#/$defs/sha256"},
              "evidenceCarrierBinding": {"$ref": "#/$defs/reviewGraphEvidenceBinding"},
              "expectedResultSchema": {
                "type": "object", "additionalProperties": false,
                "required": ["schemaId", "baseResultSchemaSha256", "unitBindingDigest"],
                "properties": {
                  "schemaId": {"const": "deep-audit-review-graph-model-result/v1"},
                  "baseResultSchemaSha256": {"$ref": "#/$defs/sha256"},
                  "unitBindingDigest": {"$ref": "#/$defs/sha256"}
                }
              },
              "instructions": {
                "type": "object", "additionalProperties": false,
                "required": ["encoding", "canonicalText", "bytes", "sha256"],
                "properties": {
                  "encoding": {"const": "canonical-json-lines"},
                  "canonicalText": {"type": "string", "minLength": 2},
                  "bytes": {"type": "integer", "minimum": 2},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              },
              "memberRequestDigest": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "taskKeys": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "coverageCellIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "leafIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "requestSchema": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "sha256"],
          "properties": {
            "id": {"const": "model-evidence-broker.schema.json#/$defs/reviewGraphBatchExchangeRequest"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "expectedResultSchema": {
          "type": "object", "additionalProperties": false,
          "required": ["schemaId", "baseResultSchemaSha256", "batchBindingDigest"],
          "properties": {
            "schemaId": {"const": "deep-audit-review-graph-model-batch-result/v1"},
            "baseResultSchemaSha256": {"$ref": "#/$defs/sha256"},
            "batchBindingDigest": {"$ref": "#/$defs/sha256"}
          }
        },
        "preparedInputBudget": {
          "type": "object", "additionalProperties": false,
          "required": [
            "plannedInputBytes", "plannedOutputBytes", "plannedPayloadBytes",
            "maxInputBytes", "maxOutputBytes", "maxPayloadBytes"
          ],
          "properties": {
            "plannedInputBytes": {"type": "integer", "minimum": 1},
            "plannedOutputBytes": {"type": "integer", "minimum": 1},
            "plannedPayloadBytes": {"type": "integer", "minimum": 2},
            "maxInputBytes": {"type": "integer", "minimum": 1},
            "maxOutputBytes": {"type": "integer", "minimum": 1},
            "maxPayloadBytes": {"type": "integer", "minimum": 2}
          }
        },
        "carrier": {
          "type": "object", "additionalProperties": false,
          "required": [
            "kind", "contentSetDigest", "leafSetDigest",
            "evidenceCarrierBinding", "inputResultRefs", "inputResultSetDigest"
          ],
          "properties": {
            "kind": {"const": "deep-audit-content-addressed-review-graph-batch-carrier"},
