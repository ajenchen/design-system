{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-ledger-writer-plan-v1.schema.json",
  "title": "Credential-free plan for one protected external-ledger PR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "mutationAuthorized",
    "candidateCodeExecutionAllowed",
    "directDefaultBranchWriteAllowed",
    "mergeAllowed",
    "reviewAllowed",
    "dispatchDigest",
    "handoff",
    "repository",
    "gitTransaction",
    "changes",
    "commit",
    "pullRequest",
    "planDigest"
  ],
  "properties": {
    "$schema": {"const": "../schemas/external-ledger-writer-plan.schema.json"},
    "schemaVersion": {"enum": [1, 2]},
    "kind": {"const": "external-ledger-writer-plan"},
    "mutationAuthorized": {"const": false},
    "candidateCodeExecutionAllowed": {"const": false},
    "directDefaultBranchWriteAllowed": {"const": false},
    "mergeAllowed": {"const": false},
    "reviewAllowed": {"const": false},
    "dispatchDigest": {"$ref": "#/$defs/sha256"},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "bytesSha256",
        "operation",
        "validUntil",
        "validitySemantics"
      ],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "bytesSha256": {"$ref": "#/$defs/sha256"},
        "operation": {"enum": ["external-runtime-certification", "external-activation", "provider-review-capability-certification"]},
        "validUntil": {
          "type": "string",
          "format": "date-time",
          "description": "Last instant at which the Writer App may materialize or read back this handoff; this is not merge authorization."
        },
        "validitySemantics": {
          "const": "writer-materialization-envelope-only-not-merge-authorization"
        }
      }
    },
    "repository": {"$ref": "#/$defs/repositoryIdentity"},
    "gitTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedBaseRef",
        "expectedBaseCommit",
        "expectedBaseTree",
        "expectedOldBranchState",
        "branch"
      ],
      "properties": {
        "expectedBaseRef": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
        "expectedBaseCommit": {"$ref": "#/$defs/gitOid"},
        "expectedBaseTree": {"$ref": "#/$defs/gitOid"},
        "expectedOldBranchState": {"const": "absent-or-exact"},
        "branch": {
          "type": "string",
          "pattern": "^governance/external-ledger/(certification|activation|review-certification)-[a-f0-9]{12}-[a-f0-9]{12}$"
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256", "afterBytesSha256", "afterGitBlobSha"],
      "properties": {
        "path": {
          "enum": [
            "infra/governance/providers/certifications.json",
            "infra/governance/external-activation-requirements.json"
          ]
        },
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"},
        "afterBytesSha256": {"$ref": "#/$defs/sha256"},
        "afterGitBlobSha": {"$ref": "#/$defs/gitOid"}
      }
    },
    "ledgers": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/providerLedgerPlan"},
        {"$ref": "#/$defs/reviewLedgerPlan"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "baseState", "mode", "type", "bytesSha256", "gitBlobSha"],
        "properties": {
          "path": {
            "oneOf": [
              {
                "enum": [
                  "infra/governance/providers/certifications.json",
                  "infra/governance/providers/review-capability-certifications.json",
                  "infra/governance/external-activation-requirements.json"
                ]
              },
              {
                "type": "string",
                "pattern": "^infra/governance/evidence/external-runtime/[a-f0-9]{64}\\.json$"
              },
              {
                "type": "string",
                "pattern": "^infra/governance/evidence/(provider-runtime|review-capability)/[a-f0-9]{64}\\.json$"
              }
            ]
          },
          "baseState": {"enum": ["absent", "existing-different"]},
          "mode": {"const": "100644"},
          "type": {"const": "blob"},
          "bytesSha256": {"$ref": "#/$defs/sha256"},
          "gitBlobSha": {"$ref": "#/$defs/gitOid"}
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "handoffDigest", "author", "committer"],
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^chore\\(governance\\): apply reviewed (certification|activation|review-certification) [a-f0-9]{12}$",
          "maxLength": 200
        },
        "handoffDigest": {"$ref": "#/$defs/sha256"},
        "author": {"$ref": "#/$defs/gitIdentity"},
        "committer": {"$ref": "#/$defs/gitIdentity"}
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "title", "artifactBindingRequired", "maintainerCanModify"],
      "properties": {
        "base": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "head": {
          "type": "string",
          "pattern": "^governance/external-ledger/(certification|activation|review-certification)-[a-f0-9]{12}-[a-f0-9]{12}$"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "artifactBindingRequired": {"const": true},
        "maintainerCanModify": {"const": false}
      }
    },
    "planDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "handoff": {
            "type": "object",
            "properties": {
              "operation": {"const": "provider-review-capability-certification"}
            },
            "required": ["operation"]
          }
        },
        "required": ["handoff"]
      },
      "then": {
        "type": "object",
        "required": ["ledgers"],
        "properties": {
          "schemaVersion": {"const": 2},
          "ledgers": {"$ref": "#/properties/ledgers"}
        }
      },
      "else": {
        "type": "object",
        "required": ["ledger"],
        "properties": {
          "schemaVersion": {"const": 1},
          "ledger": {"$ref": "#/properties/ledger"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "ledgerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256", "afterBytesSha256", "afterGitBlobSha"],
      "properties": {
        "path": {"type": "string"},
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"},
        "afterBytesSha256": {"$ref": "#/$defs/sha256"},
        "afterGitBlobSha": {"$ref": "#/$defs/gitOid"}
      }
    },
    "providerLedgerPlan": {
      "allOf": [
        {"$ref": "#/$defs/ledgerPlan"},
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "infra/governance/providers/certifications.json"
            }
          }
        }
      ]
    },
    "reviewLedgerPlan": {
      "allOf": [
        {"$ref": "#/$defs/ledgerPlan"},
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "infra/governance/providers/review-capability-certifications.json"
            }
          }
        }
      ]
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "github", "defaultBranch"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "defaultBranch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email", "date"],
      "properties": {
        "name": {"const": "Qijenchen Governance Writer App"},
        "email": {"const": "qijenchen-governance-writer[bot]@users.noreply.github.com"},
        "date": {"type": "string", "format": "date-time"}
      }
    }
  }
}
