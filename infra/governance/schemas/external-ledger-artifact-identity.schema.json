{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-ledger-artifact-identity-v1.schema.json",
  "title": "Verified same-run protected workflow artifact identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "verifiedAt",
    "repository",
    "workflow",
    "artifact",
    "identityDigest"
  ],
  "properties": {
    "$schema": {"const": "../schemas/external-ledger-artifact-identity.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-ledger-run-artifact-identity"},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "repository": {"$ref": "#/$defs/repository"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "event",
        "headBranch",
        "runId",
        "runAttempt",
        "headSha",
        "status",
        "conclusion"
      ],
      "properties": {
        "path": {"const": ".github/workflows/external-ledger-writer.yml"},
        "event": {"const": "repository_dispatch"},
        "headBranch": {"const": "main"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "headSha": {"$ref": "#/$defs/gitOid"},
        "status": {"const": "in_progress"},
        "conclusion": {"type": "null"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "digest", "sizeInBytes", "createdAt", "expiresAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "name": {"type": "string", "pattern": "^external-ledger-[1-9][0-9]*-[1-9][0-9]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sizeInBytes": {"type": "integer", "minimum": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "identityDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
  }
}
