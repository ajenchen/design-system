{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/workflow-identity-proposal.schema.json",
  "title": "Reviewed workflow identity candidate-preparation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "applicationMode", "authorizationStatus", "authority", "sourceRevision", "desired", "workflowSources", "changes", "requiredChangedPaths", "desiredAfter", "proposalDigest"],
  "properties": {
    "$schema": {"const": "../schemas/workflow-identity-proposal.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "workflow-identity-review-proposal"},
    "applicationMode": {"const": "local-candidate-preparation-only"},
    "authorizationStatus": {"const": "not-performed"},
    "authority": {"type": "string", "minLength": 1},
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha"],
      "properties": {
        "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "treeSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "desired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256"],
      "properties": {
        "path": {"const": "infra/governance/desired/github.json"},
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "workflowSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "repositoryId", "profiles", "path", "candidatePath", "identity"],
        "properties": {
          "sourceId": {"$ref": "#/$defs/sha256"},
          "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "path": {"$ref": "#/$defs/workflowPath"},
          "candidatePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "identity": {"$ref": "#/$defs/v2Identity"}
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "binding", "label", "sourceId", "workflow", "before", "after"],
        "properties": {
          "profile": {"type": "string", "minLength": 1},
          "binding": {"type": "string", "pattern": "^/profiles/"},
          "label": {"type": "string", "minLength": 1},
          "sourceId": {"$ref": "#/$defs/sha256"},
          "workflow": {"$ref": "#/$defs/workflowPath"},
          "before": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
          "after": {"$ref": "#/$defs/v2Identity"}
        }
      }
    },
    "requiredChangedPaths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
    },
    "desiredAfter": {"$ref": "https://qijenchen.dev/schemas/github-desired.schema.json"},
    "proposalDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentSha256", "gitBlobSha", "semanticSha256"],
      "properties": {
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "gitBlobSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "semanticVersion": {"enum": [1, 2]}
      }
    },
    "v2Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentSha256", "gitBlobSha", "semanticSha256", "semanticVersion"],
      "properties": {
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "gitBlobSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "semanticVersion": {"const": 2}
      }
    }
  }
}
