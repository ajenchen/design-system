{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-runtime-surface-evidence-v1.json",
  "title": "Attested external runtime surface evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "status", "profile", "run", "subject", "distribution", "checks", "surfaceBinding", "attestation", "evidenceDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-runtime-surface-conformance"},
    "status": {"enum": ["pass", "fail"]},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapterProviderId", "runtimeKind", "surface", "repositoryId", "repository", "repositoryRole"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "adapterProviderId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
        "runtimeKind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "surface": {"enum": ["local", "remote-control", "cloud", "github-actions"]},
        "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "repositoryRole": {"enum": ["authority", "template-mirror", "product-consumer"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "generatedAt", "validUntil", "operatingSystem", "platform", "arch", "executionEnvironment", "pathClass", "targetId", "targetDigest"],
      "properties": {
        "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "operatingSystem": {"enum": ["macos", "linux"]},
        "platform": {"enum": ["darwin", "linux"]},
        "arch": {"enum": ["arm64", "x64"]},
        "executionEnvironment": {"enum": ["native", "remote-host", "cloud-hosted", "github-hosted-runner"]},
        "pathClass": {"enum": ["no-space", "contains-space"]},
        "targetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "targetDigest": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit", "gitTree", "profileDigest", "harnessDigest", "hardGateContractDigest"],
      "properties": {
        "gitCommit": {"$ref": "#/$defs/gitOid"},
        "gitTree": {"$ref": "#/$defs/gitOid"},
        "profileDigest": {"$ref": "#/$defs/prefixedSha256"},
        "harnessDigest": {"$ref": "#/$defs/prefixedSha256"},
        "hardGateContractDigest": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "productId", "version", "identityDigest"],
      "properties": {
        "authority": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "productId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "identityDigest": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "driver", "status", "receiptSha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "driver": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "status": {"enum": ["pass", "fail"]},
          "receiptSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "surfaceBinding": {
      "oneOf": [
        {"$ref": "#/$defs/managedBinding"},
        {"$ref": "#/$defs/githubBinding"}
      ]
    },
    "attestation": {"$ref": "#/$defs/attestation"},
    "evidenceDigest": {"$ref": "#/$defs/prefixedSha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "managedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repositoryId", "repository", "repositoryRole", "defaultBranch", "sessionIdentitySha256", "repositoryReadbackSha256", "distributionReadbackSha256", "hardGateReceiptSha256", "controlPlaneReadbackSha256"],
      "properties": {
        "kind": {"const": "managed-runtime-readback"},
        "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "repositoryRole": {"enum": ["authority", "template-mirror", "product-consumer"]},
        "defaultBranch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sessionIdentitySha256": {"$ref": "#/$defs/sha256"},
        "repositoryReadbackSha256": {"$ref": "#/$defs/sha256"},
        "distributionReadbackSha256": {"$ref": "#/$defs/sha256"},
        "hardGateReceiptSha256": {"$ref": "#/$defs/sha256"},
        "controlPlaneReadbackSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "githubBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidenceRunId", "repositoryId", "repository", "repositoryRole", "defaultBranch", "repositoryReadbackSha256", "protectedRef", "workflowPath", "workflowBlobSha256", "workflowGitBlobSha", "workflowSemanticSha256", "runDatabaseId", "runAttempt", "event", "headSha", "treeSha", "artifactName", "artifactSha256", "checkName", "checkConclusion", "checkAppId", "checkRunSha256", "workflowRunReadbackSha256", "rulesetId", "rulesetName", "rulesetEnforcement", "requiredCheckName", "rulesetPolicyDigest", "rulesetReadbackSha256", "desiredStateDigest", "controlPlaneReadbackSha256", "oidcIssuer", "oidcSubject", "oidcSubjectSha256"],
      "properties": {
        "kind": {"const": "github-actions-readback"},
        "evidenceRunId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "repositoryId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "repositoryRole": {"enum": ["authority", "template-mirror", "product-consumer"]},
        "defaultBranch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "repositoryReadbackSha256": {"$ref": "#/$defs/sha256"},
        "protectedRef": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"},
        "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "workflowBlobSha256": {"$ref": "#/$defs/sha256"},
        "workflowGitBlobSha": {"$ref": "#/$defs/gitOid"},
        "workflowSemanticSha256": {"$ref": "#/$defs/sha256"},
        "runDatabaseId": {"type": "string", "pattern": "^[0-9]+$"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "event": {"type": "string", "pattern": "^[a-z_]+$"},
        "headSha": {"$ref": "#/$defs/gitOid"},
        "treeSha": {"$ref": "#/$defs/gitOid"},
        "artifactName": {"type": "string", "minLength": 1},
        "artifactSha256": {"$ref": "#/$defs/sha256"},
        "checkName": {"type": "string", "minLength": 1},
        "checkConclusion": {"const": "success"},
        "checkAppId": {"type": "string", "pattern": "^[0-9]+$"},
        "checkRunSha256": {"$ref": "#/$defs/sha256"},
        "workflowRunReadbackSha256": {"$ref": "#/$defs/sha256"},
        "rulesetId": {"type": "string", "pattern": "^[0-9]+$"},
        "rulesetName": {"type": "string", "minLength": 1},
        "rulesetEnforcement": {"const": "active"},
        "requiredCheckName": {"type": "string", "minLength": 1},
        "rulesetPolicyDigest": {"$ref": "#/$defs/sha256"},
        "rulesetReadbackSha256": {"$ref": "#/$defs/sha256"},
        "desiredStateDigest": {"$ref": "#/$defs/sha256"},
        "controlPlaneReadbackSha256": {"$ref": "#/$defs/sha256"},
        "oidcIssuer": {"const": "https://token.actions.githubusercontent.com"},
        "oidcSubject": {"type": "string", "minLength": 1},
        "oidcSubjectSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "status", "issuerId", "issuerRegistryDigest", "algorithm", "evidenceDigest", "runId", "signature", "coSignatures"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "external-runtime-surface-evidence-attestation"},
        "status": {"const": "verified"},
        "issuerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
        "algorithm": {"const": "ed25519"},
        "evidenceDigest": {"$ref": "#/$defs/prefixedSha256"},
        "runId": {"type": "string"},
        "signature": {"type": "string", "minLength": 1},
        "coSignatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issuerId", "signature"],
            "properties": {
              "issuerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "signature": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
