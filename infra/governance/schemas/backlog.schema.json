{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/backlog-v1.json",
  "title": "Repository backlog (the only home for open work)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "_authority", "items"],
  "properties": {
    "$schema": { "const": "../../infra/governance/schemas/backlog.schema.json" },
    "schemaVersion": { "const": 1 },
    "_authority": { "const": "governance/backlog/README.md" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "quote", "ref"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "quote": { "type": "string", "minLength": 2 },
        "ref": { "type": "string", "minLength": 4 }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oldId", "text"],
      "properties": {
        "oldId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 2 },
        "evidence": { "type": "string", "minLength": 2 },
        "userQuote": { "type": "string", "minLength": 2 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "oldIds", "title", "kind", "rootCause", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^BL-\\d{3}$" },
        "oldIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "string", "minLength": 4 },
        "kind": { "enum": ["user-directed", "user-decision", "engineering", "consumer-report"] },
        "scope": { "const": "product-ui-ux-decision" },
        "source": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/quote" } },
        "rootCause": { "type": "string", "minLength": 4 },
        "status": { "enum": ["open", "in-progress", "blocked", "done", "dropped"] },
        "verifiedAt": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
        "doneRef": { "type": "string", "pattern": "^(?:\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?|[0-9a-f]{7,40})$" },
        "droppedReason": { "type": "string", "minLength": 4 },
        "blockedReason": { "type": "string", "minLength": 4 },
        "order": { "type": "integer", "minimum": 1 },
        "orderReason": { "type": "string", "minLength": 4 },
        "valueGate": { "enum": ["①", "②", "③", "recordOnly"] },
        "suggestion": { "type": "string", "minLength": 4 },
        "askUser": { "const": true },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "verifyCmd": { "type": "string", "minLength": 4 },
        "fixedSignal": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["user-directed", "user-decision"] } } },
          "then": { "required": ["source", "order", "orderReason"], "not": { "anyOf": [{ "required": ["valueGate"] }, { "required": ["askUser"] }] } }
        },
        {
          "if": { "properties": { "kind": { "const": "user-decision" } } },
          "then": { "required": ["scope"] },
          "else": { "not": { "required": ["scope"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["engineering", "consumer-report"] } } },
          "then": { "required": ["valueGate", "suggestion"], "not": { "anyOf": [{ "required": ["order"] }, { "required": ["orderReason"] }] } }
        },
        {
          "if": { "properties": { "status": { "enum": ["open", "in-progress", "blocked"] } } },
          "then": { "required": ["verifiedAt", "evidence"] }
        },
        {
          "if": { "properties": { "status": { "const": "done" } } },
          "then": { "required": ["doneRef"] },
          "else": { "not": { "required": ["doneRef"] } }
        },
        {
          "if": { "properties": { "status": { "const": "dropped" } } },
          "then": { "required": ["droppedReason"] },
          "else": { "not": { "required": ["droppedReason"] } }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": { "required": ["blockedReason"] },
          "else": { "not": { "required": ["blockedReason"] } }
        },
        {
          "if": { "required": ["fixedSignal"] },
          "then": { "required": ["verifyCmd"] }
        }
      ]
    }
  }
}
