{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-ledger-transaction-handoff-v1.schema.json",
  "title": "Protected Git expected-base handoff for a reviewed external ledger after-image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "operation",
    "applicationMode",
    "canonicalLedgerMutationPerformed",
    "externalMutationAuthorized",
    "preparedAt",
    "validUntil",
    "minimumRemainingValiditySeconds",
    "repository",
    "gitTransaction",
    "reviewedProposalDigest",
    "signingRequest",
    "reviewedProposal",
    "requiredChangedPaths",
    "handoffDigest"
  ],
  "properties": {
    "$schema": {"const": "../schemas/external-ledger-transaction-handoff.schema.json"},
    "schemaVersion": {"enum": [1, 2]},
    "kind": {"const": "external-ledger-transaction-handoff"},
    "operation": {
      "enum": ["external-runtime-certification", "external-activation", "provider-review-capability-certification"]
    },
    "applicationMode": {
      "const": "protected-git-expected-base-pr-transaction-only"
    },
    "canonicalLedgerMutationPerformed": {"const": false},
    "externalMutationAuthorized": {"const": false},
    "preparedAt": {"type": "string", "format": "date-time"},
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Writer materialization envelope only. It is not merge, review, or approval authorization."
    },
    "minimumRemainingValiditySeconds": {"const": 60},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "github", "defaultBranch"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "defaultBranch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    },
    "gitTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedBaseCommit",
        "expectedBaseTree",
        "expectedBaseRef",
        "liveProtectedBaseVerificationRequired",
        "requiredReviewFlow",
        "requiredPromotionPrimitive",
        "directCanonicalWriteAllowed"
      ],
      "properties": {
        "expectedBaseCommit": {"$ref": "#/$defs/gitOid"},
        "expectedBaseTree": {"$ref": "#/$defs/gitOid"},
        "expectedBaseRef": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]+$"
        },
        "expectedBaseLedgerSha256": {"$ref": "#/$defs/sha256"},
        "expectedBaseLedgers": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "semanticSha256"],
              "properties": {
                "path": {"const": "infra/governance/providers/certifications.json"},
                "semanticSha256": {"$ref": "#/$defs/sha256"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "semanticSha256"],
              "properties": {
                "path": {"const": "infra/governance/providers/review-capability-certifications.json"},
                "semanticSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "liveProtectedBaseVerificationRequired": {"const": true},
        "requiredReviewFlow": {"const": "protected-pull-request"},
        "requiredPromotionPrimitive": {
          "const": "atomic-expected-old-git-ref-cas"
        },
        "directCanonicalWriteAllowed": {"const": false}
      }
    },
    "reviewedProposalDigest": {"$ref": "#/$defs/sha256"},
    "signingRequest": {
      "oneOf": [
        {"type": "null"},
        {
          "$ref": "https://qijenchen.dev/schemas/external-activation-signing-request-v1.schema.json"
        }
      ]
    },
    "reviewedProposal": {
      "oneOf": [
        {
          "$ref": "https://qijenchen.dev/schemas/external-runtime-certification-proposal-v1.schema.json"
        },
        {
          "$ref": "https://qijenchen.dev/schemas/external-activation-proposal-v1.schema.json"
        },
        {
          "$ref": "https://qijenchen.dev/schemas/provider-review-capability-certification-proposal-v1.schema.json"
        }
      ]
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256"],
      "properties": {
        "path": {
          "enum": [
            "infra/governance/providers/certifications.json",
            "infra/governance/external-activation-requirements.json"
          ]
        },
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requiredChangedPaths": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "enum": [
              "infra/governance/providers/certifications.json",
              "infra/governance/providers/review-capability-certifications.json",
              "infra/governance/external-activation-requirements.json"
            ]
          },
          {
            "type": "string",
            "pattern": "^infra/governance/evidence/external-runtime/[a-f0-9]{64}\\.json$"
          },
          {
            "type": "string",
            "pattern": "^infra/governance/evidence/(provider-runtime|review-capability)/[a-f0-9]{64}\\.json$"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "evidenceArtifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "canonicalBase64"],
          "properties": {
            "path": {"type": "string", "pattern": "^infra/governance/evidence/external-runtime/[a-f0-9]{64}\\.json$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "canonicalBase64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5592408,
              "pattern": "^[A-Za-z0-9+/]+={0,2}$"
            }
          }
        }
      ]
    },
    "ledgerAfter": {
      "oneOf": [
        {
          "$ref": "https://qijenchen.dev/schemas/provider-surface-certification-v2.schema.json"
        },
        {
          "$ref": "https://qijenchen.dev/schemas/external-activation-requirements-v4.json"
        }
      ]
    },
    "ledgers": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/providerLedger"},
        {"$ref": "#/$defs/reviewLedger"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceArtifacts": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/providerRuntimeArtifact"},
        {"$ref": "#/$defs/reviewCapabilityArtifact"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "ledgerAfters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerCertifications", "reviewCapabilityCertifications"],
      "properties": {
        "providerCertifications": {
          "$ref": "https://qijenchen.dev/schemas/provider-surface-certification-v2.schema.json"
        },
        "reviewCapabilityCertifications": {
          "$ref": "https://qijenchen.dev/schemas/governance/review-capability-certifications-v1.json"
        }
      }
    },
    "handoffDigest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {"const": "external-runtime-certification"}
        },
        "required": ["operation"]
      },
      "then": {
        "type": "object",
        "required": ["ledger", "evidenceArtifact", "ledgerAfter"],
        "properties": {
          "gitTransaction": {
            "type": "object",
            "required": ["expectedBaseLedgerSha256"],
            "properties": {
              "expectedBaseLedgerSha256": {
                "$ref": "#/properties/gitTransaction/properties/expectedBaseLedgerSha256"
              }
            }
          },
          "signingRequest": {"type": "null"},
          "reviewedProposal": {
            "$ref": "https://qijenchen.dev/schemas/external-runtime-certification-proposal-v1.schema.json"
          },
          "ledger": {
            "type": "object",
            "properties": {
              "path": {
                "const": "infra/governance/providers/certifications.json"
              }
            }
          },
          "requiredChangedPaths": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^infra/governance/evidence/external-runtime/[a-f0-9]{64}\\.json$"
              },
              {
                "const": "infra/governance/providers/certifications.json"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "evidenceArtifact": {
            "type": "object"
          },
          "ledgerAfter": {
            "$ref": "https://qijenchen.dev/schemas/provider-surface-certification-v2.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {"const": "external-activation"}
        },
        "required": ["operation"]
      },
      "then": {
        "type": "object",
        "required": ["ledger", "evidenceArtifact", "ledgerAfter"],
        "properties": {
          "gitTransaction": {
            "type": "object",
            "required": ["expectedBaseLedgerSha256"],
            "properties": {
              "expectedBaseLedgerSha256": {
                "$ref": "#/properties/gitTransaction/properties/expectedBaseLedgerSha256"
              }
            }
          },
          "signingRequest": {
            "$ref": "https://qijenchen.dev/schemas/external-activation-signing-request-v1.schema.json"
          },
          "reviewedProposal": {
            "$ref": "https://qijenchen.dev/schemas/external-activation-proposal-v1.schema.json"
          },
          "ledger": {
            "type": "object",
            "properties": {
              "path": {
                "const": "infra/governance/external-activation-requirements.json"
              }
            }
          },
          "requiredChangedPaths": {
            "type": "array",
            "prefixItems": [
              {
                "const": "infra/governance/external-activation-requirements.json"
              }
            ],
            "items": false,
            "minItems": 1,
            "maxItems": 1
          },
          "evidenceArtifact": {
            "type": "null"
          },
          "ledgerAfter": {
            "$ref": "https://qijenchen.dev/schemas/external-activation-requirements-v4.json"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {"const": "provider-review-capability-certification"}
        },
        "required": ["operation"]
      },
      "then": {
        "type": "object",
        "required": ["ledgers", "evidenceArtifacts", "ledgerAfters"],
        "properties": {
          "schemaVersion": {"const": 2},
          "ledgers": {"$ref": "#/properties/ledgers"},
          "evidenceArtifacts": {
            "$ref": "#/properties/evidenceArtifacts"
          },
          "ledgerAfters": {"$ref": "#/properties/ledgerAfters"},
          "gitTransaction": {
            "type": "object",
            "required": ["expectedBaseLedgers"],
            "properties": {
              "expectedBaseLedgers": {
                "$ref": "#/properties/gitTransaction/properties/expectedBaseLedgers"
              }
            }
          },
          "signingRequest": {"type": "null"},
          "reviewedProposal": {
            "$ref": "https://qijenchen.dev/schemas/provider-review-capability-certification-proposal-v1.schema.json"
          },
          "requiredChangedPaths": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "pattern": "^infra/governance/evidence/provider-runtime/[a-f0-9]{64}\\.json$"},
              {"const": "infra/governance/providers/certifications.json"},
              {"type": "string", "pattern": "^infra/governance/evidence/review-capability/[a-f0-9]{64}\\.json$"},
              {"const": "infra/governance/providers/review-capability-certifications.json"}
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ledgerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256"],
      "properties": {
        "path": {"type": "string"},
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "providerLedger": {
      "allOf": [
        {"$ref": "#/$defs/ledgerBinding"},
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "infra/governance/providers/certifications.json"
            }
          }
        }
      ]
    },
    "reviewLedger": {
      "allOf": [
        {"$ref": "#/$defs/ledgerBinding"},
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "infra/governance/providers/review-capability-certifications.json"
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "canonicalBase64"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "canonicalBase64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5592408,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "providerRuntimeArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^infra/governance/evidence/provider-runtime/[a-f0-9]{64}\\.json$"
            }
          }
        }
      ]
    },
    "reviewCapabilityArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^infra/governance/evidence/review-capability/[a-f0-9]{64}\\.json$"
            }
          }
        }
      ]
    }
  }
}
