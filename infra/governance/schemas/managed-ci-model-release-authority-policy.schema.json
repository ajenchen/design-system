{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/managed-ci-model-release-authority-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "tenantId", "authorityEndpointHost", "minimumTlsVersion", "maximumRedirects", "maximumReadbackBytes", "maximumReceiptTtlSeconds", "allowedSourceHosts", "revocationRegistryUrl", "auditReadbackUrl", "issuerRole", "issuerSeparation", "replay", "signingDomains"],
  "properties": {
    "$schema": {"const": "../schemas/managed-ci-model-release-authority-policy.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "managed-ci-model-release-authority-policy"},
    "tenantId": {"const": "ajenchen-design-system"},
    "authorityEndpointHost": {"const": "managed-ci-authority.qijenchen.dev"},
    "minimumTlsVersion": {"const": "TLSv1.3"},
    "maximumRedirects": {"const": 0},
    "maximumReadbackBytes": {"const": 4194304},
    "maximumReceiptTtlSeconds": {"const": 3720},
    "allowedSourceHosts": {"type": "array", "prefixItems": [{"const": "developers.openai.com"}, {"const": "platform.claude.com"}], "items": false, "minItems": 2, "maxItems": 2},
    "revocationRegistryUrl": {"const": "https://managed-ci-authority.qijenchen.dev/v1/model-releases/revocations"},
    "auditReadbackUrl": {"const": "https://managed-ci-authority.qijenchen.dev/v1/model-releases/audit"},
    "issuerRole": {"const": "runtime-evidence-issuer"},
    "issuerSeparation": {"const": {"receiptSignerDistinctFromReadbackObserver": true, "auditObserverDistinctFromReceiptAndSourceObservers": true, "sourceAndRevocationObserverMayMatch": true}},
    "replay": {"const": {"uniqueReceiptId": true, "uniqueReadbackIds": true, "uniqueNoncePerSignedDocument": true, "ledger": "external-atomic-ttl-replay-ledger"}},
    "signingDomains": {"const": {
      "authorityReceipt": "qijenchen:managed-ci:model-release-authority-receipt:v1",
      "sourceReadback": "qijenchen:managed-ci:model-release-source-readback:v1",
      "revocationReadback": "qijenchen:managed-ci:model-release-revocation-readback:v1",
      "auditReadback": "qijenchen:managed-ci:model-release-audit-readback:v1"
    }}
  }
}
