{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/fleet-recovery-authorization-v2.json",
  "title": "Fresh dual-quorum fleet rollback authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "operation",
    "transactionId",
    "historicalControlPlaneDigest",
    "journalAuthorizationEnvelopeDigest",
    "journalEventHeadDigest",
    "rollbackPlanDigest",
    "currentInventoryDigest",
    "currentDesiredDigest",
    "currentAttestationPolicyDigest",
    "currentPrivilegedPolicyDigest",
    "issuerRegistryDigest",
    "issuedAt",
    "expiresAt",
    "applySignatures",
    "rootSignatures"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kind": {"const": "fleet-recovery-authorization"},
    "operation": {"const": "rollback"},
    "transactionId": {"type": "string", "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"},
    "historicalControlPlaneDigest": {"$ref": "#/$defs/sha256"},
    "journalAuthorizationEnvelopeDigest": {"$ref": "#/$defs/sha256"},
    "journalEventHeadDigest": {"$ref": "#/$defs/sha256"},
    "rollbackPlanDigest": {"$ref": "#/$defs/sha256"},
    "currentInventoryDigest": {"$ref": "#/$defs/sha256"},
    "currentDesiredDigest": {"$ref": "#/$defs/sha256"},
    "currentAttestationPolicyDigest": {"$ref": "#/$defs/sha256"},
    "currentPrivilegedPolicyDigest": {"$ref": "#/$defs/sha256"},
    "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "applySignatures": {"$ref": "#/$defs/signatures"},
    "rootSignatures": {"$ref": "#/$defs/signatures"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signerKeyId", "subject", "signature"],
        "properties": {
          "signerKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "subject": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}
        }
      }
    }
  }
}
