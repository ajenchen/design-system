{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/external-activation-proposal-v1.schema.json",
  "title": "Externally signed external activation candidate proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "applicationMode", "authorizationStatus", "externalMutationAuthorized", "ledger", "models", "requirementId", "signingRequestDigest", "reviewedRequirement", "requiredChangedPaths", "ledgerAfter", "proposalDigest"],
  "properties": {
    "$schema": {"const": "../schemas/external-activation-proposal.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "external-activation-review-proposal"},
    "applicationMode": {"const": "local-candidate-preparation-only"},
    "authorizationStatus": {"const": "external-completion-attestor-quorum-verified"},
    "externalMutationAuthorized": {"const": false},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "beforeSha256", "afterSha256"],
      "properties": {
        "path": {"const": "infra/governance/external-activation-requirements.json"},
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "afterSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "models": {"$ref": "#/$defs/activationModels"},
    "requirementId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "signingRequestDigest": {"$ref": "#/$defs/sha256"},
    "reviewedRequirement": {"$ref": "https://qijenchen.dev/schemas/external-activation-requirements-v4.json#/$defs/requirement"},
    "requiredChangedPaths": {
      "type": "array",
      "prefixItems": [{"const": "infra/governance/external-activation-requirements.json"}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "ledgerAfter": {"$ref": "https://qijenchen.dev/schemas/external-activation-requirements-v4.json"},
    "proposalDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activationModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventorySha256", "desiredSha256", "compatibilityMatrixSha256", "runtimeProfileSha256", "roleSurfacePolicySha256", "releaseRingsSha256", "issuerRegistrySha256", "activationPolicySha256", "mutationBoundaryContractSha256"],
      "properties": {
        "inventorySha256": {"$ref": "#/$defs/sha256"},
        "desiredSha256": {"$ref": "#/$defs/sha256"},
        "compatibilityMatrixSha256": {"$ref": "#/$defs/sha256"},
        "runtimeProfileSha256": {"$ref": "#/$defs/sha256"},
        "roleSurfacePolicySha256": {"$ref": "#/$defs/sha256"},
        "releaseRingsSha256": {"$ref": "#/$defs/sha256"},
        "issuerRegistrySha256": {"$ref": "#/$defs/sha256"},
        "activationPolicySha256": {"$ref": "#/$defs/sha256"},
        "mutationBoundaryContractSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
