{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/fleet-reconcile-journal-v6.json",
  "title": "Fail-closed fleet reconciliation transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "transactionId", "planDigest", "candidatePlanDigest", "candidateRelease",
    "verifiedReleaseEvidenceDigest", "externalActivationDigest", "externalActivationInventoryDigest", "externalActivationDesiredDigest", "externalActivationRequirements", "externalActivationPolicy", "externalActivationInventory", "externalActivationDesired", "externalActivationMutationBoundaryContract", "externalActivationMutationBoundaryContractDigest", "evidenceDurabilityClass", "mirrorIdentity", "inventoryDigest", "desiredDigest", "attestationPolicyDigest",
    "historicalControlPlane", "historicalControlPlaneDigest", "rolloutWave", "parallelBudget", "state",
    "startedAt", "rollbackAttempted", "recoveryInstruction", "actions", "repoBindings", "rollbackPlan",
    "rollbackPlanDigest", "authorizationEnvelopeDigest", "events", "eventHeadDigest", "offHostReceipts"
  ],
  "properties": {
    "schemaVersion": {"const": 6},
    "transactionId": {"type": "string", "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"},
    "planDigest": {"$ref": "#/$defs/sha256"},
    "candidatePlanDigest": {"$ref": "#/$defs/sha256"},
    "candidateRelease": {"$ref": "release-rings.schema.json#/properties/candidateRelease"},
    "verifiedReleaseEvidenceDigest": {"$ref": "#/$defs/sha256"},
    "externalActivationDigest": {"$ref": "#/$defs/sha256"},
    "externalActivationInventoryDigest": {"$ref": "#/$defs/sha256"},
    "externalActivationDesiredDigest": {"$ref": "#/$defs/sha256"},
    "externalActivationRequirements": {"$ref": "https://qijenchen.dev/schemas/external-activation-requirements-v4.json"},
    "externalActivationPolicy": {"$ref": "https://qijenchen.dev/schemas/external-activation-policy-v1.json"},
    "externalActivationInventory": {"$ref": "managed-repos.schema.json"},
    "externalActivationDesired": {"$ref": "github-desired.schema.json"},
    "externalActivationMutationBoundaryContract": {"$ref": "https://qijenchen.dev/schemas/github-mutation-boundary-contract-v1.json"},
    "externalActivationMutationBoundaryContractDigest": {"$ref": "#/$defs/sha256"},
    "evidenceDurabilityClass": {"enum": ["local-content-addressed-fsync-v1", "independent-append-only-off-host-v1"]},
    "mirrorIdentity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/mirrorIdentity"}]},
    "inventoryDigest": {"$ref": "#/$defs/sha256"},
    "desiredDigest": {"$ref": "#/$defs/sha256"},
    "attestationPolicyDigest": {"$ref": "#/$defs/sha256"},
    "historicalControlPlane": {"$ref": "#/$defs/historicalControlPlane"},
    "historicalControlPlaneDigest": {"$ref": "#/$defs/sha256"},
    "rolloutWave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ring", "wave", "repoIds"],
      "properties": {
        "ring": {"type": "string", "minLength": 1},
        "wave": {"type": "string", "minLength": 1},
        "repoIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "parallelBudget": {"type": "integer", "minimum": 1},
    "state": {"enum": ["prepared", "applying", "verified", "failed-partial-state-possible", "recovery-observed", "manual-recovery-required", "rolling-back", "rolled-back-verified", "rollback-blocked"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "failedAt": {"type": "string", "format": "date-time"},
    "error": {"type": "string", "minLength": 1},
    "rollbackAttempted": {"type": "boolean"},
    "recoveryInstruction": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "repoBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repoBinding"}},
    "rollbackPlan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rollbackStep"}},
    "rollbackPlanDigest": {"$ref": "#/$defs/sha256"},
    "authorizationEnvelopeDigest": {"$ref": "#/$defs/sha256"},
    "recoveredAt": {"type": "string", "format": "date-time"},
    "recoveryFailures": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollbackStartedAt": {"type": "string", "format": "date-time"},
    "rollbackCompletedAt": {"type": "string", "format": "date-time"},
    "rollbackBlockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
    ,"rollbackAuthorizationEventHeadDigest": {"$ref": "#/$defs/sha256"}
    ,"events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
    ,"eventHeadDigest": {"$ref": "#/$defs/sha256"}
    ,"offHostReceipts": {"type": "array", "items": {"$ref": "#/$defs/offHostReceipt"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sequence", "transactionId", "type", "subjectActionId", "at", "previousDigest", "authorizationEnvelopeDigest", "runtimeState", "stateDigest", "mirrorRequestNonce", "eventDigest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "transactionId": {"type": "string", "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"},
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "subjectActionId": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "at": {"type": "string", "format": "date-time"},
        "previousDigest": {"$ref": "#/$defs/sha256"},
        "authorizationEnvelopeDigest": {"$ref": "#/$defs/sha256"},
        "runtimeState": {"$ref": "#/$defs/runtimeState"},
        "stateDigest": {"$ref": "#/$defs/sha256"},
        "mirrorRequestNonce": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uuid"}]},
        "eventDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactionState", "completedAt", "failedAt", "error", "rollbackAttempted", "recoveredAt", "recoveryFailures", "rollbackAuthorizationEventHeadDigest", "rollbackStartedAt", "rollbackCompletedAt", "rollbackBlockers", "actions"],
      "properties": {
        "transactionState": {"enum": ["prepared", "applying", "verified", "failed-partial-state-possible", "recovery-observed", "manual-recovery-required", "rolling-back", "rolled-back-verified", "rollback-blocked"]},
        "completedAt": {"type": ["string", "null"], "format": "date-time"},
        "failedAt": {"type": ["string", "null"], "format": "date-time"},
        "error": {"type": ["string", "null"]},
        "rollbackAttempted": {"type": "boolean"},
        "recoveredAt": {"type": ["string", "null"], "format": "date-time"},
        "recoveryFailures": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "rollbackAuthorizationEventHeadDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "rollbackStartedAt": {"type": ["string", "null"], "format": "date-time"},
        "rollbackCompletedAt": {"type": ["string", "null"], "format": "date-time"},
        "rollbackBlockers": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "string", "minLength": 1}}]},
        "actions": {"type": "array", "minItems": 0, "items": {"$ref": "#/$defs/runtimeAction"}}
      }
    },
    "runtimeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "status", "responseId", "readbackPath", "recoveryObservation", "rollbackStatus"],
      "properties": {
        "actionId": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "applying", "applied-unverified", "verified", "not-applied"]},
        "responseId": {"type": ["integer", "string", "null"]},
        "readbackPath": {"type": ["string", "null"]},
        "recoveryObservation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/snapshot"}]},
        "rollbackStatus": {"type": ["string", "null"], "enum": [null, "already-at-before-image", "blocked-drift", "blocked-manual", "compensating", "rolled-back-verified", "blocked-error"]}
      }
    },
    "offHostReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "protocolVersion", "provider", "endpoint", "tenant", "container", "principal", "receiptId", "transactionId", "sequence", "eventDigest", "eventHeadDigest", "idempotencyKey", "requestNonce", "requestDigest", "receivedAt", "retainedUntil", "appendOnly", "independentAdministration", "signingKeyId", "signatureAlgorithm", "signature", "receiptSha256"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "fleet-reconcile-off-host-ack"},
        "protocolVersion": {"const": "fleet-reconcile-mirror-v1"},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
        "tenant": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "receiptId": {"type": "string", "minLength": 1},
        "transactionId": {"type": "string", "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "eventDigest": {"$ref": "#/$defs/sha256"},
        "eventHeadDigest": {"$ref": "#/$defs/sha256"},
        "idempotencyKey": {"$ref": "#/$defs/sha256"},
        "requestNonce": {"type": "string", "format": "uuid"},
        "requestDigest": {"$ref": "#/$defs/sha256"},
        "receivedAt": {"type": "string", "format": "date-time"},
        "retainedUntil": {"type": "string", "format": "date-time"},
        "appendOnly": {"const": true},
        "independentAdministration": {"const": true},
        "signingKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "signatureAlgorithm": {"const": "ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "receiptSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mirrorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "provider", "endpoint", "tenant", "container", "wormMode", "lifecyclePolicyDigest", "minimumRetentionDays", "writerPrincipal", "verifierPrincipal", "adapterCommandSha256", "receiptSigningKeyId", "receiptSigningPublicKeySpki", "receiptSigningPublicKeySpkiSha256", "signatureAlgorithm"],
      "properties": {
        "protocolVersion": {"const": "fleet-reconcile-mirror-v1"},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
        "tenant": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "wormMode": {"const": "compliance-object-lock"},
        "lifecyclePolicyDigest": {"$ref": "#/$defs/sha256"},
        "minimumRetentionDays": {"type": "integer", "minimum": 30, "maximum": 3650},
        "writerPrincipal": {"type": "string", "minLength": 1},
        "verifierPrincipal": {"type": "string", "minLength": 1},
        "adapterCommandSha256": {"$ref": "#/$defs/sha256"},
        "receiptSigningKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "receiptSigningPublicKeySpki": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "receiptSigningPublicKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "signatureAlgorithm": {"const": "ed25519"}
      }
    },
    "historicalControlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "inventory", "desired", "attestationPolicy", "issuerRegistry"],
      "properties": {
        "schemaVersion": {"const": 1},
        "inventory": {"$ref": "managed-repos.schema.json"},
        "desired": {"$ref": "github-desired.schema.json"},
        "attestationPolicy": {"$ref": "release-rings.schema.json#/properties/attestationPolicy"},
        "issuerRegistry": {"$ref": "https://qijenchen.dev/schemas/issuer-registry-v1.json"}
      }
    },
    "snapshot": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["state", "digest"],
          "properties": {"state": {"const": "absent"}, "digest": {"$ref": "#/$defs/sha256"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["state", "value", "digest"],
          "properties": {"state": {"const": "present"}, "value": {}, "digest": {"$ref": "#/$defs/sha256"}}
        }
      ]
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safety"],
      "properties": {
        "safety": {"enum": ["automatic", "blocked"]},
        "method": {"enum": ["POST", "PUT", "DELETE"]},
        "path": {"type": "string", "pattern": "^/repos/[^/]+/[^/]+/"},
        "pathSource": {"const": "readbackPath"},
        "body": {},
        "recreatedResource": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "method", "path", "resource", "beforeImage", "expectedApplied", "compensation", "actionId", "github", "repoId", "status"],
      "properties": {
        "kind": {"enum": ["update-actions-workflow-permissions", "create-ruleset", "update-ruleset", "delete-stale-ruleset", "create-environment", "update-environment", "delete-stale-environment", "enable-immutable-releases"]},
        "method": {"enum": ["POST", "PUT", "DELETE"]},
        "path": {"type": "string", "pattern": "^/repos/[^/]+/[^/]+/"},
        "body": {},
        "resource": {"type": "string", "minLength": 1},
        "beforeImage": {"$ref": "#/$defs/snapshot"},
        "expectedApplied": {"$ref": "#/$defs/snapshot"},
        "compensation": {"$ref": "#/$defs/compensation"},
        "actionId": {"type": "string", "minLength": 1},
        "github": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "repoId": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "applying", "applied-unverified", "verified", "not-applied"]},
        "responseId": {"type": ["integer", "string", "null"]},
        "readbackPath": {"type": ["string", "null"]},
        "recoveryObservation": {"$ref": "#/$defs/snapshot"},
        "rollbackStatus": {"enum": ["already-at-before-image", "blocked-drift", "blocked-manual", "compensating", "rolled-back-verified", "blocked-error"]}
      }
    },
    "repoBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "github", "ring", "wave", "defaultBranchHeadSha", "observedStateDigest", "predicateDigest", "actionsDigest", "applyAuthorization"],
      "properties": {
        "repoId": {"type": "string", "minLength": 1},
        "github": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "ring": {"type": "string", "minLength": 1},
        "wave": {"type": "string", "minLength": 1},
        "defaultBranchHeadSha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "observedStateDigest": {"$ref": "#/$defs/sha256"},
        "predicateDigest": {"$ref": "#/$defs/sha256"},
        "actionsDigest": {"$ref": "#/$defs/sha256"},
        "applyAuthorization": {"$ref": "release-rings.schema.json#/$defs/attestation"}
      }
    },
    "rollbackStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "repoId", "resource", "beforeImageDigest", "expectedAppliedDigest", "compensation"],
      "properties": {
        "actionId": {"type": "string", "minLength": 1},
        "repoId": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "beforeImageDigest": {"$ref": "#/$defs/sha256"},
        "expectedAppliedDigest": {"$ref": "#/$defs/sha256"},
        "compensation": {"$ref": "#/$defs/compensation"}
      }
    }
  }
}
