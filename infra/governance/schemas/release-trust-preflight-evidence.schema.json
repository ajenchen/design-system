{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/release-trust-preflight-evidence.schema.json",
  "title": "Attempt-bound read-only GitHub release trust evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "repository", "workflow", "release", "releaseTagAuthorization", "releaseTagAuthorizationPolicy", "inventoryDigest", "desiredDigest", "observedStateDigest", "independentReviewerAuthority", "trust", "requiredCheckEvidence", "externalActivationRequirements", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": 4},
    "kind": {"const": "release-trust-preflight"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "event", "runId", "runAttempt"],
      "properties": {
        "path": {"const": ".github/workflows/release.yml"},
        "event": {"const": "repository_dispatch"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "tagObject", "commit", "tree", "verification"],
      "properties": {
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:beta|next|rc)\\.[0-9]+)?$"},
        "tagObject": {"$ref": "#/$defs/sha1"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified", "reason", "verifiedAt"],
          "properties": {
            "verified": {"const": true},
            "reason": {"const": "valid"},
            "verifiedAt": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "releaseTagAuthorization": {"$ref": "https://qijenchen.dev/schemas/release-tag-authorization-v2.json"},
    "releaseTagAuthorizationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "externalActivationPolicyDigest", "authorizationProfileId", "authorizationProfileDigest", "releaseAuthorization"],
      "properties": {
        "path": {"const": "infra/governance/release-tag-authorization-policy.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "externalActivationPolicyDigest": {"$ref": "#/$defs/sha256"},
        "authorizationProfileId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "authorizationProfileDigest": {"$ref": "#/$defs/sha256"},
        "releaseAuthorization": {"$ref": "#/$defs/releaseAuthorization"}
      }
    },
    "inventoryDigest": {"$ref": "#/$defs/sha256"},
    "desiredDigest": {"$ref": "#/$defs/sha256"},
    "observedStateDigest": {"$ref": "#/$defs/sha256"},
    "independentReviewerAuthority": {
      "description": "Backward-compatible field name carrying the signed, provider-neutral finalizer authority; it is not a GitHub User/Team approval.",
      "$ref": "#/$defs/independentReviewerAuthority"
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrations", "rulesets", "requiredChecks", "environments", "workflows", "immutableReleases"],
      "properties": {
        "integrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "id", "slug", "capability", "observed"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "id": {"type": "integer", "minimum": 1},
              "slug": {"type": "string", "minLength": 1},
              "capability": {"type": "string", "minLength": 1},
              "observed": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "id", "slug"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "id": {"type": "integer", "minimum": 1},
                  "slug": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "rulesets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context", "integrationId"],
            "properties": {
              "context": {"type": "string", "minLength": 1},
              "integrationId": {"type": "integer", "minimum": 1}
            }
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "workflow", "credentialSecrets"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "workflow": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
              "credentialSecrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
            }
          }
        },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "identity"],
            "properties": {
              "path": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
              "identity": {"$ref": "#/$defs/workflowIdentity"}
            }
          }
        },
        "immutableReleases": {"type": "boolean"}
      }
    },
    "requiredCheckEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "checkRunId", "integrationId", "producer", "producerBindingDigest", "headSha", "headCommittedAt", "status", "conclusion", "completedAt"],
        "properties": {
          "context": {"type": "string", "minLength": 1},
          "checkRunId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "integrationId": {"type": "integer", "minimum": 1},
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["app", "externalId", "detailsUrl", "workflowRun"],
            "properties": {
              "app": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "slug"],
                "properties": {
                  "id": {"type": "integer", "minimum": 1},
                  "slug": {"type": "string", "minLength": 1}
                }
              },
              "externalId": {"type": ["string", "null"]},
              "detailsUrl": {"type": "string", "format": "uri"},
              "workflowRun": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "path", "head_sha", "event", "status", "conclusion"],
                    "properties": {
                      "id": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
                      "path": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
                      "head_sha": {"$ref": "#/$defs/sha1"},
                      "event": {"type": "string", "minLength": 1},
                      "status": {"const": "completed"},
                      "conclusion": {"const": "success"}
                    }
                  }
                ]
              }
            }
          },
          "producerBindingDigest": {"$ref": "#/$defs/sha256"},
          "headSha": {"$ref": "#/$defs/sha1"},
          "headCommittedAt": {"type": "string", "format": "date-time"},
          "status": {"const": "completed"},
          "conclusion": {"const": "success"},
          "completedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "externalActivationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "infra/governance/external-activation-requirements.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "releaseAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSignerQuorum", "maximumSignerQuorum"],
      "properties": {
        "minimumSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5},
        "maximumSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "independentReviewerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "kind", "requirementId", "repository", "desiredPath",
        "workflow", "externalActivationPolicyDigest", "authorizationProfileId", "authorizationProfileDigest",
        "releaseAuthorization", "allowedKeyIds", "requiredSignerQuorum", "authorizerSubjects", "observedAt",
        "expiresAt", "issuerRegistryDigest", "attestorSubjects", "evidenceSha256",
        "readbackSha256", "activationLedgerDigest", "authorityDigest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "release-finalizer-signed-authority-v1"},
        "requirementId": {"const": "activate-independent-finalizer-signed-authority"},
        "repository": {"const": "ajenchen/design-system"},
        "desiredPath": {"const": "infra/governance/release-tag-authorization-policy.json"},
        "workflow": {"const": ".github/workflows/release-finalize.yml"},
        "externalActivationPolicyDigest": {"$ref": "#/$defs/sha256"},
        "authorizationProfileId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "authorizationProfileDigest": {"$ref": "#/$defs/sha256"},
        "releaseAuthorization": {"$ref": "#/$defs/releaseAuthorization"},
        "allowedKeyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        },
        "requiredSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5},
        "authorizerSubjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "observedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
        "attestorSubjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "readbackSha256": {"$ref": "#/$defs/sha256"},
        "activationLedgerDigest": {"$ref": "#/$defs/sha256"},
        "authorityDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "workflowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentSha256", "gitBlobSha", "semanticSha256"],
      "properties": {
        "contentSha256": {"$ref": "#/$defs/sha256"},
        "gitBlobSha": {"$ref": "#/$defs/sha1"},
        "semanticSha256": {"$ref": "#/$defs/sha256"},
        "semanticVersion": {"type": "integer", "enum": [1, 2]}
      }
    }
  }
}
