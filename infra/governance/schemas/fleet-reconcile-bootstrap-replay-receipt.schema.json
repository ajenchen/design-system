{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/fleet-reconcile-bootstrap-replay-receipt-v1.json",
  "title": "Content-addressed durable replay of an authority bootstrap journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "protocolVersion",
    "purpose",
    "promotionEligible",
    "managedEvidence",
    "managedEvidenceScope",
    "requirementId",
    "activationRequirementDigest",
    "sourceJournal",
    "sourceJournalDigest",
    "mirrorIdentity",
    "mirrorIdentityDigest",
    "eventReceipts",
    "eventReceiptsDigest",
    "headVerificationRequest",
    "headVerification",
    "replayedAt",
    "convergenceReadback",
    "convergenceReadbackDigest",
    "receiptDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "github-authority-policy-bootstrap-durable-replay"},
    "protocolVersion": {"const": "fleet-reconcile-mirror-v1"},
    "purpose": {"const": "candidate-freeze-durability-prerequisite"},
    "promotionEligible": {"const": false},
    "managedEvidence": {"const": true},
    "managedEvidenceScope": {"const": "signed-mirror-event-chain-and-head-only"},
    "requirementId": {"const": "activate-off-host-append-only-reconcile-evidence-mirror"},
    "activationRequirementDigest": {"$ref": "#/$defs/sha256"},
    "sourceJournal": {
      "$ref": "https://qijenchen.dev/schemas/fleet-reconcile-bootstrap-transaction-v1.json"
    },
    "sourceJournalDigest": {"$ref": "#/$defs/sha256"},
    "mirrorIdentity": {
      "$ref": "https://qijenchen.dev/schemas/fleet-reconcile-journal-v6.json#/$defs/mirrorIdentity"
    },
    "mirrorIdentityDigest": {"$ref": "#/$defs/sha256"},
    "eventReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://qijenchen.dev/schemas/fleet-reconcile-journal-v6.json#/$defs/offHostReceipt"
      }
    },
    "eventReceiptsDigest": {"$ref": "#/$defs/sha256"},
    "headVerificationRequest": {"$ref": "#/$defs/headVerificationRequest"},
    "headVerification": {"$ref": "#/$defs/headVerification"},
    "replayedAt": {"type": "string", "format": "date-time"},
    "convergenceReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "defaultBranchHeadSha",
        "defaultBranchTreeSha",
        "observedStateDigest",
        "remainingActionsDigest",
        "eventHeadDigest",
        "genesisReadbackDigest"
      ],
      "properties": {
        "repository": {"const": "ajenchen/design-system"},
        "defaultBranchHeadSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "defaultBranchTreeSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "observedStateDigest": {"$ref": "#/$defs/sha256"},
        "remainingActionsDigest": {"$ref": "#/$defs/sha256"},
        "eventHeadDigest": {"$ref": "#/$defs/sha256"},
        "genesisReadbackDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "convergenceReadbackDigest": {"$ref": "#/$defs/sha256"},
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "headVerificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "protocolVersion",
        "provider",
        "endpoint",
        "tenant",
        "container",
        "principal",
        "transactionId",
        "eventHeadDigest",
        "eventCount",
        "requestNonce",
        "requestedAt",
        "requestDigest"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "fleet-reconcile-head-verification-request"},
        "protocolVersion": {"const": "fleet-reconcile-mirror-v1"},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
        "tenant": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "transactionId": {
          "type": "string",
          "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"
        },
        "eventHeadDigest": {"$ref": "#/$defs/sha256"},
        "eventCount": {"type": "integer", "minimum": 1},
        "requestNonce": {"type": "string", "format": "uuid"},
        "requestedAt": {"type": "string", "format": "date-time"},
        "requestDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "headVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "protocolVersion",
        "provider",
        "endpoint",
        "tenant",
        "container",
        "principal",
        "verificationId",
        "transactionId",
        "eventHeadDigest",
        "eventCount",
        "requestNonce",
        "requestDigest",
        "verifiedAt",
        "retainedUntil",
        "appendOnly",
        "independentAdministration",
        "signingKeyId",
        "signatureAlgorithm",
        "signature",
        "verificationSha256"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "fleet-reconcile-off-host-verification"},
        "protocolVersion": {"const": "fleet-reconcile-mirror-v1"},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
        "tenant": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "verificationId": {"type": "string", "minLength": 1},
        "transactionId": {
          "type": "string",
          "pattern": "^github-reconcile-[0-9]+-[a-f0-9]{12}$"
        },
        "eventHeadDigest": {"$ref": "#/$defs/sha256"},
        "eventCount": {"type": "integer", "minimum": 1},
        "requestNonce": {"type": "string", "format": "uuid"},
        "requestDigest": {"$ref": "#/$defs/sha256"},
        "verifiedAt": {"type": "string", "format": "date-time"},
        "retainedUntil": {"type": "string", "format": "date-time"},
        "appendOnly": {"const": true},
        "independentAdministration": {"const": true},
        "signingKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "signatureAlgorithm": {"const": "ed25519"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "verificationSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
