{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/release-tag-authorization-policy-v2.json",
  "title": "Profile-bound independent release-tag authorization policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "repository", "algorithm", "externalActivationPolicyDigest", "authorizationProfileId", "authorizationProfileDigest", "releaseAuthorization", "maxAuthorizationTtlMinutes", "clockSkewSeconds", "issuerRegistryDigest", "allowedKeyIds", "requiredSignerQuorum"],
  "properties": {
    "$schema": {"const": "schemas/release-tag-authorization-policy.schema.json"},
    "schemaVersion": {"const": 2},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "algorithm": {"const": "ed25519"},
    "externalActivationPolicyDigest": {"$ref": "#/$defs/sha256"},
    "authorizationProfileId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "authorizationProfileDigest": {"$ref": "#/$defs/sha256"},
    "releaseAuthorization": {"$ref": "#/$defs/releaseAuthorization"},
    "maxAuthorizationTtlMinutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "clockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
    "allowedKeyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "requiredSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "releaseAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSignerQuorum", "maximumSignerQuorum"],
      "properties": {
        "minimumSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5},
        "maximumSignerQuorum": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
