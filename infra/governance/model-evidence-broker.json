{
  "$schema": "schemas/model-evidence-broker.schema.json",
  "schemaVersion": 2,
  "evidenceKind": "deep-audit-model-evidence-broker-plan",
  "executionMode": "content-addressed-sharded-broker-v1",
  "limits": {
    "maxRawContentBytesPerShard": 49152,
    "maxPromptBytesPerShard": 131072,
    "maxEstimatedTokensPerShard": 65536,
    "bytesPerEstimatedToken": 2,
    "maxChunkBytes": 16384,
    "maxChunksPerShard": 32,
    "maxClaimsPerShard": 128
  },
  "budgets": {
    "costUnitPromptBytes": 4096,
    "wholeTask": {
      "maxTotalSourceBytes": 134217728,
      "maxShardCount": 8192,
      "maxProviderCalls": 8192,
      "maxCostUnits": 262144
    },
    "dispatchBatch": {
      "maxTotalSourceBytes": 1073741824,
      "maxShardCount": 32768,
      "maxProviderCalls": 32768,
      "maxCostUnits": 524288
    },
    "fullReview": {
      "maxTaskCount": 128,
      "maxTotalSourceBytes": 4294967296,
      "maxShardCount": 131072,
      "maxProviderCalls": 131072,
      "maxCostUnits": 4194304
    }
  },
  "applicability": {
    "judgment": "canonical-dimension-all-design-system-and-rubric",
    "componentA1b": "frozen-component-exact-claim-inventory"
  },
  "reviewGraph": {
    "protocolExtension": "no-sample-multiplexed-review-graph-v1",
    "logicalTaskPreservation": "all-registered-tasks-and-shards",
    "contentDeduplication": "content-addressed-model-work-multiplexing",
    "zeroClaimPolicy": "shared-review-cell-required-no-standalone-empty-call",
    "rawCorpusPolicy": "every-leaf-has-deterministic-disposition-and-review-binding",
    "completionPolicy": "exact-cell-closure-before-content-addressed-deterministic-hierarchical-synthesis",
    "synthesisExecution": "deterministic-local-reducer-no-provider-call",
    "unknownApplicability": "fail-closed",
    "maxCanonicalResultBytes": 32768,
    "maxFindingsPerWorkUnit": 8,
    "maxFindingTextCharacters": 192,
    "maxSummaryCharacters": 384,
    "maxPreparedRequestFixedBytes": 32768,
    "maxEvidenceReferenceBytesPerLeaf": 1024
  },
  "transport": {
    "repositoryRead": "forbidden",
    "promptContent": "exact-content-addressed-shard",
    "response": "schema-closed-per-shard",
    "reducer": "deterministic-exact-shard-closure"
  }
}
