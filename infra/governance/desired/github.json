              "type": "creation"
            },
            {
              "type": "update"
            },
            {
              "type": "deletion"
            },
            {
              "type": "required_signatures"
            }
          ],
          "target": "tag"
        }
      ],
      "tagPolicy": {
        "allowCreation": false,
        "pattern": "v*",
        "requireSourceAncestry": true,
        "requireVerifiedSource": true,
        "sourceBranch": "main"
      }
    }
  },
  "schemaVersion": 1,
  "staleManagedPolicy": "delete-after-preflight"
}
