{
  "schemaVersion": 1,
  "managedRulesetPrefix": "fleet/",
  "staleManagedPolicy": "delete-after-preflight",
  "checkRunMaxAgeMinutes": 1440,
  "checkRunClockSkewSeconds": 0,
  "integrations": {
    "githubActions": {
      "id": 15368,
      "slug": "github-actions",
      "required": true,
      "capability": "ci",
      "operationMode": "github-native"
    },
    "governanceCheckApp": {
      "id": 1001,
      "slug": "qijenchen-governance-check",
      "required": false,
      "externalTrustAnchor": true,
      "capability": "check-only",
      "operationMode": "base-trusted-isolated-workflow",
      "repositorySelection": "selected",
      "permissions": {
        "checks": "write"
      },
      "secretPrefix": "GOVERNANCE_CHECK_APP"
    },
    "governanceWriterApp": {
      "id": 1002,
      "slug": "qijenchen-governance-writer",
      "required": false,
      "externalTrustAnchor": false,
      "capability": "writer",
      "operationMode": "github-actions-environment",
      "repositorySelection": "selected",
      "permissions": {
        "contents": "write",
        "pullRequests": "write",
        "workflows": "write"
      },
      "secretPrefix": "GOVERNANCE_WRITER_APP"
    }
  },
  "managedEnvironmentNames": [
    "npm-release",
    "governance-upgrade",
    "governance-external-ledger"
  ],
  "profiles": {
    "product-consumer": {
      "actionsWorkflowPermissions": {
        "default_workflow_permissions": "read",
        "can_approve_pull_request_reviews": true
      },
      "immutableReleases": false,
      "requiredChecks": [
        {
          "context": "Verify consumer",
          "integration": "githubActions",
          "trustSource": "protected-base-workflow",
          "workflow": ".github/workflows/audit.yml",
          "workflowIdentity": {
            "contentSha256": "f620b819dc58937bde853da5c08d103b6d81194fdd0f400f1cebfdbad2c7a211",
            "gitBlobSha": "3e3b9e818e995a935af34013c2e6a01c1bb70c63",
            "semanticVersion": 2,
            "semanticSha256": "dad42ba5e135c6a1fab279e064e934784f03700353e5f68aa8ea1b8c7a6fa166"
          },
          "requiredEvents": [
            "repository_dispatch"
          ],
          "forbidCandidateControlledSkip": true,
          "requireUnconditionalPullRequest": true,
          "baseTrusted": true
        }
      ],
      "rulesets": [
        {
          "name": "fleet/base-integrity",
          "target": "branch",
          "rollout": "always",
          "enforcement": "active",
          "conditions": {
            "ref_name": {
              "include": [
                "~DEFAULT_BRANCH"
              ],
              "exclude": []
            }
          },
          "bypass_actors": [],
          "rules": [
            {
              "type": "deletion"
            },
            {
              "type": "non_fast_forward"
            },
            {
              "type": "required_linear_history"
            }
          ]
        },
        {
          "name": "fleet/verified-main",
          "target": "branch",
          "rollout": "always",
          "enforcement": "active",
          "conditions": {
            "ref_name": {
              "include": [
                "~DEFAULT_BRANCH"
              ],
              "exclude": []
            }
          },
          "bypass_actors": [],
          "rules": [
            {
              "type": "pull_request",
              "parameters": {
                "dismiss_stale_reviews_on_push": false,
                "require_code_owner_review": false,
                "require_last_push_approval": false,
                "required_approving_review_count": 0,
                "required_review_thread_resolution": true
              }
            },
            {
              "type": "required_status_checks",
              "parameters": {
                "fromProfile": true,
                "strict_required_status_checks_policy": true
              }
            }
          ]
        },
        {
          "name": "fleet/immutable-release-tags",
          "target": "tag",
          "rollout": "always",
          "enforcement": "active",
          "conditions": {
            "ref_name": {
              "include": [
                "refs/tags/v*"
              ],
              "exclude": []
            }
          },
          "bypass_actors": [],
          "rules": [
            {
              "type": "update"
            },
            {
              "type": "deletion"
            }
          ]
        }
      ],
      "tagPolicy": {
        "pattern": "v*",
        "sourceBranch": "main",
        "allowCreation": true,
        "requireSourceAncestry": true,
        "requireVerifiedSource": true
      },
      "environments": []
    }
  }
}
