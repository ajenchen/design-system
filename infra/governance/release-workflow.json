{
  "$schema": "schemas/release-workflow.schema.json",
  "schemaVersion": 1,
  "profile": "PRODUCTION_GRADE_SINGLE_OWNER_SMALL_TEAM",
  "decisionAuthority": {
    "engineering": "AUTO",
    "ask": "unresolved-product-ui-ux-ssot-choice",
    "humanOnly": [
      "login",
      "mfa",
      "oauth",
      "credential-reference"
    ],
    "resumeAfterHumanAction": "AUTO"
  },
  "deepAuditReleasePolicy": {
    "iterationBoundary": "one-branch-one-pr-candidate-validation",
    "publishAsIterationLoop": false,
    "maximumFinalReleasesPerAudit": 1,
    "additionalReleaseCondition": "separately-evidenced-post-publish-blocker-or-security-incident",
    "allowedAdditionalReleaseFailureClasses": [
      "post-publish-blocker",
      "security-incident"
    ],
    "requiredIncidentFields": [
      "incidentId",
      "failureClass",
      "publishedVersion",
      "evidenceRef"
    ]
  },
  "steps": [
    {
      "id": "pr-checks",
      "authority": "AUTO",
      "completion": [
        "required-ci-check-green",
        "conversation-resolved"
      ]
    },
    {
      "id": "merge",
      "authority": "AUTO",
      "completion": [
        "protected-main-merge",
        "protected-main-readback"
      ],
      "gate": "user-release-consent"
    },
    {
      "id": "publish",
      "authority": "AUTO",
      "completion": [
        "npm-publish-success"
      ]
    },
    {
      "id": "readback",
      "authority": "AUTO",
      "completion": [
        "github-release-readback",
        "github-release-immutable",
        "npm-exact-version-readback"
      ]
    },
    {
      "id": "consumer",
      "authority": "AUTO",
      "completion": [
        "template-main-exact-version",
        "work-management-main-exact-version",
        "actions-bound-consumer-check-provenance"
      ]
    }
  ],
  "legacyMechanisms": [
    {
      "id": "candidate-freeze",
      "standardRelease": "retired",
      "reason": "The exact PR head plus required CI already identifies the releasable bytes."
    },
    {
      "id": "external-activation",
      "standardRelease": "retired",
      "reason": "The activation-cluster machinery was removed 2026-08-04; credentials actually needed by a five-step action still pause only that action."
    },
    {
      "id": "model-certification",
      "standardRelease": "non-blocking",
      "reason": "Provider certification can add assurance but cannot block the standard small-team release."
    },
    {
      "id": "offline-signatures",
      "standardRelease": "retired",
      "reason": "A parallel offline approval ceremony is not part of the standard release path."
    },
    {
      "id": "72h-soak",
      "standardRelease": "retired",
      "reason": "Post-release observation may continue asynchronously and never delays standard release completion."
    },
    {
      "id": "fleet-promotion",
      "standardRelease": "retired",
      "reason": "Exact-version consumer PR, merge, and readback replace a separate promotion ceremony."
    }
  ],
  "automation": {
    "repository": "ajenchen/design-system",
    "defaultBranch": "main",
    "publishWorkflow": {
      "file": "release.yml",
      "dispatchEvent": "stage-protected-release"
    },
    "packages": [
      "@qijenchen/design-system",
      "@qijenchen/governance",
      "@qijenchen/storybook-config"
    ],
    "consumers": [
      {
        "repository": "ajenchen/ds-product-template",
        "defaultBranch": "main",
        "delivery": "release-published-pr",
        "readbackPath": "package-lock.json",
        "packages": [
          "@qijenchen/design-system",
          "@qijenchen/storybook-config"
        ],
        "requiredCheck": {
          "context": "Verify consumer",
          "integration": "githubActions",
          "producerWorkflow": ".github/workflows/audit.yml",
          "producerEvent": "pull_request",
          "producerHead": "pull-request-head"
        }
      },
      {
        "repository": "ajenchen/work-management",
        "defaultBranch": "main",
        "dispatchEvent": "design-system-published",
        "delivery": "repository-dispatch-pr",
        "readbackPath": "package-lock.json",
        "packages": [
          "@qijenchen/design-system",
          "@qijenchen/storybook-config"
        ],
        "requiredCheck": {
          "context": "Verify consumer",
          "integration": "githubActions",
          "producerWorkflow": ".github/workflows/audit.yml",
          "producerEvent": "pull_request",
          "producerHead": "pull-request-head"
        }
      }
    ],
    "preview": {
      "provider": "netlify",
      "site": "ajenchen-design-system",
      "pullRequestPattern": "https://deploy-preview-{number}--{site}.netlify.app/",
      "branchPattern": "https://{branchSlug}--{site}.netlify.app/"
    }
  },
  "releaseConsent": {
    "required": true,
    "gateBefore": "merge",
    "receiptDir": ".git/governance-runtime/release-consent",
    "binding": "pull-request-head-sha",
    "userVerbatim": "按照我們規定的工作流程應該是你要先把我們討論的東西部署到 netlify,等我確認後認為都沒問題,主動說要發版,你才會 push 到 GitHub main 同時更新 GitHub 上的 storybook 並發版到 NPM(2026-09-02)",
    "consentPhrases": [
      "發版",
      "發佈",
      "發布",
      "可以合併",
      "推到 main",
      "push to main",
      "release it",
      "ship it",
      "publish it"
    ],
    "questionMarkers": [
      "?",
      "?",
      "是否",
      "要不要",
      "可以嗎",
      "嗎",
      "該不該"
    ],
    "denialMarkers": [
      "不要發版",
      "先不要",
      "不要發",
      "還不要",
      "暫停發版",
      "don't release",
      "do not release",
      "hold"
    ]
  }
}
