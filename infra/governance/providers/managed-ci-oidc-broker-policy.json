{
  "$schema": "../schemas/managed-ci-oidc-broker-policy.schema.json",
  "schemaVersion": 1,
  "kind": "managed-ci-oidc-broker-policy",
  "workflowIdentity": {
    "repository": "ajenchen/design-system",
    "workflow": "Managed deep-audit trusted execution",
    "workflowPath": ".github/workflows/deep-audit-managed.yml",
    "workflowRef": "ajenchen/design-system/.github/workflows/deep-audit-managed.yml@refs/heads/main",
    "eventName": "workflow_dispatch",
    "ref": "refs/heads/main",
    "refType": "branch",
    "runnerEnvironment": "self-hosted"
  },
  "token": {
    "issuer": "https://token.actions.githubusercontent.com",
    "audience": "qijenchen-managed-deep-audit-authority-v1",
    "requiredClaims": [
      "iss", "aud", "sub", "jti", "iat", "nbf", "exp", "repository", "repository_id",
      "repository_owner_id", "event_name", "ref", "ref_type", "sha", "run_id", "run_attempt",
      "runner_environment", "workflow", "workflow_ref", "workflow_sha", "environment"
    ],
    "immutableSubject": {
      "required": true,
      "template": "repo:ajenchen@{repositoryOwnerId}/design-system@{repositoryId}:environment:{environment}",
      "repositoryIdPointer": "/activation/repositoryId",
      "repositoryOwnerIdPointer": "/activation/repositoryOwnerId",
      "allowedEnvironments": ["managed-ci-sandbox-authority-v1", "managed-ci-receipt-finalizer-v1"]
    },
    "temporal": {
      "maxAgeSeconds": 3600,
      "clockSkewSeconds": 120
    },
    "replay": {
      "jtiRequired": true,
      "exactlyOnce": true,
      "ledger": "external-atomic-ttl-replay-ledger",
      "retentionSeconds": 3720
    }
  },
  "brokerRequest": {
    "requiredFields": [
      "authorityEnvironment", "authorityPurpose", "executionClass", "workflowDefinitionRef", "workflowDefinitionCommit", "workflowDefinitionTree",
      "workflowRunId", "runAttempt", "subjectCommit", "subjectTree", "manifestSha256",
      "subjectRunId", "frozenSubjectArtifactName", "frozenSubjectArtifactId", "frozenSubjectArtifactLocator",
      "frozenSubjectArtifactSha256", "frozenSubjectArtifactSize", "frozenSubjectLineageDigest",
      "requestModelId", "observedResponseModelId", "modelReleaseId", "modelReleaseBindingDigest",
      "modelReleaseRegistryDigest", "modelIdentityPolicyDigest", "modelAuthorityReceiptDigest",
      "modelAuthorityReadbackDigest", "modelAuthorityRevocationRegistryDigest",
      "modelAuthorityRevocationReadbackDigest", "modelAuthorityAuditReadbackDigest",
      "modelReleaseValidFrom", "modelReleaseValidUntil",
      "providerInvocationWindowDigest", "exchangeInvocationObservationsDigest",
      "workflowDispatchInputsDigest", "provenanceBindingDigest",
      "activationTrustBundleDigest", "governanceManifestDigest", "controlPlaneLockDigest",
      "controlPlaneContractDigest", "controlPlaneInputDigest", "controlPlaneSnapshotDigest", "controlPlaneManifestId"
    ],
    "classBinding": "trusted-environment-authority-binds-execution-class",
    "dispatchBinding": "authority-frozen-subject-artifact-and-full-provenance-digest",
    "digestAlgorithm": "sha256-canonical-json"
  },
  "receiptSigning": {
    "authorityPolicyPath": "infra/governance/providers/managed-ci-trusted-authority-policy.json",
    "serviceId": "qijenchen-managed-ci-receipt-signer-v1",
    "tenantId": "ajenchen-design-system",
    "endpointHost": "managed-ci-signer.qijenchen.dev",
    "keyIdentity": "qijenchen-managed-ci-receipt-signer-v1",
    "certificateIdentity": "spiffe://qijenchen.dev/managed-ci/receipt-signer",
    "signatureAlgorithm": "Ed25519",
    "allowedEnvironment": "managed-ci-receipt-finalizer-v1",
    "payloadSchemaPath": "scripts/schemas/managed-ci-finalized-receipt.schema.json",
    "payloadDomainSeparator": "qijenchen:managed-ci:receipt:v1",
    "classes": ["dependency-acquisition", "deterministic-hook-audit", "model-broker", "github-observer"],
    "issuerRole": "runtime-evidence-issuer",
    "privateKeyInImage": false,
    "candidateCallable": false,
    "oidcProjectionRequired": true,
    "independentAuditReadbackRequired": true
  },
  "brokers": {
    "model-broker": {
      "brokerId": "model-secret-broker",
      "serviceId": "qijenchen-managed-ci-model-egress-authority-v1",
      "endpointHost": "managed-ci-authority.qijenchen.dev",
      "operationPath": "/v1/authorize-model-egress-session",
      "invocationMode": "external-mtls-service-operation",
      "allowedEnvironment": "managed-ci-sandbox-authority-v1",
      "credentialPurpose": "selected-model-provider-api-secret",
      "outputMode": "brokered-ephemeral-readonly",
      "providerRegistry": "infra/governance/providers/model-invocation-profiles.json",
      "candidateCallable": false,
      "credentialEntersCandidateNamespace": false
    },
    "github-observer": {
      "brokerId": "github-readonly-token-broker",
      "serviceId": "qijenchen-managed-ci-github-read-authority-v1",
      "endpointHost": "managed-ci-authority.qijenchen.dev",
      "operationPath": "/v1/authorize-github-read-session",
      "invocationMode": "external-mtls-service-operation",
      "allowedEnvironment": "managed-ci-sandbox-authority-v1",
      "credentialPurpose": "github-api-read-only-token",
      "outputMode": "brokered-ephemeral-readonly",
      "permissions": ["actions:read", "checks:read", "contents:read", "metadata:read", "pull_requests:read"],
      "candidateCallable": false,
      "credentialEntersCandidateNamespace": false
    }
  }
}
