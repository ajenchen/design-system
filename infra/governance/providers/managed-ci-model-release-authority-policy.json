{
  "$schema": "../schemas/managed-ci-model-release-authority-policy.schema.json",
  "schemaVersion": 1,
  "kind": "managed-ci-model-release-authority-policy",
  "tenantId": "ajenchen-design-system",
  "authorityEndpointHost": "managed-ci-authority.qijenchen.dev",
  "minimumTlsVersion": "TLSv1.3",
  "maximumRedirects": 0,
  "maximumReadbackBytes": 4194304,
  "maximumReceiptTtlSeconds": 3720,
  "allowedSourceHosts": ["developers.openai.com", "platform.claude.com"],
  "revocationRegistryUrl": "https://managed-ci-authority.qijenchen.dev/v1/model-releases/revocations",
  "auditReadbackUrl": "https://managed-ci-authority.qijenchen.dev/v1/model-releases/audit",
  "issuerRole": "runtime-evidence-issuer",
  "issuerSeparation": {
    "receiptSignerDistinctFromReadbackObserver": true,
    "auditObserverDistinctFromReceiptAndSourceObservers": true,
    "sourceAndRevocationObserverMayMatch": true
  },
  "replay": {
    "uniqueReceiptId": true,
    "uniqueReadbackIds": true,
    "uniqueNoncePerSignedDocument": true,
    "ledger": "external-atomic-ttl-replay-ledger"
  },
  "signingDomains": {
    "authorityReceipt": "qijenchen:managed-ci:model-release-authority-receipt:v1",
    "sourceReadback": "qijenchen:managed-ci:model-release-source-readback:v1",
    "revocationReadback": "qijenchen:managed-ci:model-release-revocation-readback:v1",
    "auditReadback": "qijenchen:managed-ci:model-release-audit-readback:v1"
  }
}
