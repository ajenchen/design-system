          "environmentPolicyDigest"
        ],
        "signedUnexpired": [
          "fullRulesetsDigest",
          "bypassActorsDigest",
          "actionsWorkflowPermissionsDigest"
        ]
      }
    }
  },
  "credentialBoundary": {
    "observerCredentialNamespace": "independent-observer-proxy",
    "forbiddenNamespaces": [
      "github-actions",
      "model",
      "candidate"
    ],
    "exportedArtifact": "signed-claim-output-only"
