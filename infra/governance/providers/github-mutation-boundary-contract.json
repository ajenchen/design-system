      "context",
      "integration"
    ],
    "integrationIdentity": "slug",
    "managedRulesetPrefix": "fleet/",
    "managedNameSet": "exact",
    "parentRulesets": "forbidden",
    "unmanagedRulesets": "included-in-snapshot-excluded-from-desired-conformance",
    "rulesetSort": "name-codepoint-ascending",
    "ruleSort": "type-then-stable-json-codepoint-ascending",
    "requiredCheckSort": "context-then-integration-codepoint-ascending",
    "flattenedRequiredCheckSort": "ruleset-then-context-then-integration-codepoint-ascending"
