{
  "$schema": "../schemas/managed-ci-trusted-authority-policy.schema.json",
  "schemaVersion": 1,
  "kind": "managed-ci-trusted-authority-policy",
  "workflow": {
    "repository": "ajenchen/design-system",
    "path": ".github/workflows/deep-audit-managed.yml",
    "ref": "refs/heads/main",
    "event": "workflow_dispatch"
  },
  "candidateBoundary": {
    "jobs": ["dependency-acquisition", "deterministic-hook-audit", "model-broker", "github-observer"],
    "idTokenPermission": "none",
    "environment": null,
    "executesCandidateCode": true,
    "prohibitedExposures": [
      "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
      "ACTIONS_ID_TOKEN_REQUEST_URL",
      "receipt-signer-binary",
      "secret-broker-binary",
      "secret-broker-credential",
      "sandbox-daemon-socket",
      "container-engine-socket",
      "host-parent-proc"
    ],
    "processBoundary": {"procMode": "private-hidepid2", "hostPid": false, "parentEnvironmentReadable": false},
    "credentials": "none-secretless-egress-proxy-only"
  },
  "authorityJobs": {
    "freeze-subject-authority": {
      "environment": "managed-ci-freeze-authority-v1",
      "purpose": "freeze-candidate-as-data",
      "idTokenPermission": "write",
      "executesCandidateCode": false,
      "candidateAccess": "read-only-data-no-exec",
      "produces": "managed-ci-frozen-subject-v1"
    },
    "sandbox-session-authority": {
      "environment": "managed-ci-sandbox-authority-v1",
      "purpose": "authorize-external-sandbox-and-egress-sessions",
      "idTokenPermission": "write",
      "executesCandidateCode": false,
      "candidateAccess": "none",
      "produces": "opaque-non-secret-sandbox-session-handles"
    },
    "receipt-finalizer-authority": {
      "environment": "managed-ci-receipt-finalizer-v1",
      "purpose": "sign-independent-observations-and-class-results",
      "idTokenPermission": "write",
      "executesCandidateCode": false,
      "candidateAccess": "none",
      "produces": "managed-ci-finalized-receipt-set-v1"
    }
  },
  "oidc": {
    "issuer": "https://token.actions.githubusercontent.com",
    "audience": "qijenchen-managed-deep-audit-authority-v1",
    "requiredClaims": [
      "iss", "aud", "sub", "jti", "iat", "nbf", "exp", "repository", "repository_id",
      "repository_owner_id", "event_name", "ref", "ref_type", "sha", "run_id", "run_attempt",
      "runner_environment", "workflow", "workflow_ref", "workflow_sha", "environment"
    ],
    "immutableEnvironmentSubjectTemplate": "repo:ajenchen@{repositoryOwnerId}/design-system@{repositoryId}:environment:{environment}",
    "allowedEnvironments": ["managed-ci-freeze-authority-v1", "managed-ci-sandbox-authority-v1", "managed-ci-receipt-finalizer-v1"],
    "candidateJobsCanMint": false,
    "environmentProtectionReadbackRequired": true,
    "replay": {"jtiRequired": true, "exactlyOnce": true, "ledger": "external-atomic-ttl-replay-ledger", "retentionSeconds": 3720},
    "temporal": {"maxAgeSeconds": 3600, "clockSkewSeconds": 120}
  },
  "frozenSubjectArtifact": {
    "schemaVersion": 1,
    "kind": "managed-ci-frozen-subject-v1",
    "nameTemplate": "managed-ci-frozen-subject-{workflowRunId}-{runAttempt}",
    "contentType": "application/vnd.qijenchen.managed-ci-frozen-subject.v1+tar",
    "compression": "none",
    "canonicalManifestPath": "manifest/managed-ci-frozen-subject.json",
    "requiredLineageFields": [
      "artifactName", "artifactId", "artifactStorageLocator", "artifactSha256", "artifactSize",
      "sourceRepository", "sourceCommit", "sourceTree", "freezeRunId", "manifestSha256",
      "manifestBytesSha256", "coverageDigest", "shardSetDigest", "workflowDefinitionRef",
      "workflowDefinitionCommit", "workflowDefinitionTree", "workflowRunId", "runAttempt",
      "authorityEnvironment", "authorityOidcProjectionDigest", "lineageDigest"
    ],
    "createdByEnvironment": "managed-ci-freeze-authority-v1",
    "candidateFilesExecuted": false,
    "symlinksForbidden": true,
    "hardlinksForbidden": true,
    "pathTraversalForbidden": true,
    "allClassesDownloadSameArtifact": true,
    "allClassesRecomputeArtifactSha256": true,
    "modelClassRepositoryMount": "not-mounted-bounded-shards-only"
  },
  "receiptSigner": {
    "serviceId": "qijenchen-managed-ci-receipt-signer-v1",
    "tenantId": "ajenchen-design-system",
    "endpointHost": "managed-ci-signer.qijenchen.dev",
    "transport": "tls1.3-mtls",
    "keyIdentity": "qijenchen-managed-ci-receipt-signer-v1",
    "certificateIdentity": "spiffe://qijenchen.dev/managed-ci/receipt-signer",
    "signatureAlgorithm": "Ed25519",
    "issuerRegistryPath": "infra/governance/trust/issuers.json",
    "issuerRegistryInstallPath": "/opt/qijenchen/managed-ci-authority/trust/issuers.json",
    "issuerRole": "runtime-evidence-issuer",
    "oidcTrustPolicyPath": "infra/governance/providers/managed-ci-oidc-broker-policy.json",
    "allowedWorkflowRef": "ajenchen/design-system/.github/workflows/deep-audit-managed.yml@refs/heads/main",
    "allowedEnvironment": "managed-ci-receipt-finalizer-v1",
    "payloadSchemaPath": "scripts/schemas/managed-ci-finalized-receipt.schema.json",
    "payloadDomainSeparator": "qijenchen:managed-ci:receipt:v1",
    "transportAttestation": {
      "domainSeparator": "qijenchen:managed-ci:finalization-transport-attestation:v1",
      "issuerRole": "runtime-evidence-issuer",
      "requestBound": true,
      "finalizedReceiptSetBound": true,
      "signatureAlgorithm": "Ed25519",
      "requiredBeforeMaterialization": true
    },
    "finalizationProtocol": {
      "schemaPath": "infra/governance/schemas/managed-ci-authority-finalization-protocol.schema.json",
      "schemaSha256": "ee82d5a8add64697f795bdae17c3ec4fa433b01e9838cab815bd74ddd4305044",
      "gatewayEndpointHost": "managed-ci-authority.qijenchen.dev",
      "gatewayOperationPath": "/v1/finalize-receipts",
      "gatewayCertificateIdentity": "spiffe://qijenchen.dev/managed-ci/receipt-finalizer-gateway",
      "requestKind": "managed-ci-authority-finalization-request-v1",
      "responseKind": "managed-ci-authority-finalization-response-v1",
      "finalizedReceiptSetKind": "managed-ci-finalized-receipt-set-v1",
      "transportContractKind": "managed-ci-finalization-transport-contract-v1",
      "transportReadbackKind": "managed-ci-finalization-transport-readback-v1"
    },
    "rawReceiptValidation": {
      "schemaPath": "scripts/schemas/managed-ci-sandbox-receipt.schema.json",
      "validatorSourcePath": "scripts/lib/managed-ci-sandbox-receipt.mjs",
      "validatorSourceSha256": "6f3ed67ecdc62d923f0c69274ea7878d7bd9cc18bf75b1455fd9d0aacabb1742",
      "readbackContract": "managed-ci-raw-receipt-validation-readback-v1",
      "canonicalPathTemplate": "{executionClass}.json",
      "rawBytesRequired": true,
      "requiredChecks": [
        "schema",
        "dependencyAndClosureBinding",
        "classAndWorkflowBinding",
        "runAndEnvelopeBinding",
        "lifecycle",
        "signatureQuorum"
      ],
      "independentReadbackRequired": true
    },
    "privateKeyInImage": false,
    "candidateCallable": false,
    "auditLog": {
      "kind": "managed-ci-signer-audit-event-v1",
      "appendOnly": true,
      "independentReadbackRequired": true,
      "requiredFields": [
        "eventId", "tenantId", "keyIdentity", "policyDigest", "payloadDigest", "signature",
        "workflowRunId", "runAttempt", "environment", "signedAt", "executionClass",
        "rawReceiptDigest", "signerAuthorityBindingDigest", "issuerMappingDigest"
      ]
    }
  },
  "hostObservation": {
    "schemaVersion": 1,
    "kind": "managed-ci-host-sandbox-independent-observation-v1",
    "payloadDomainSeparator": "qijenchen:managed-ci:host-sandbox-observation:v1",
    "signatureAlgorithm": "Ed25519",
    "issuerRole": "runtime-evidence-issuer",
    "signedFields": [
      "schemaVersion", "kind", "executionClass", "workflowRunId", "runAttempt", "policyBinding",
      "observedAt", "networkNamespaceDigest", "firewallPolicyDigest", "egressProxyPolicyDigest",
      "mountTableDigest", "negativeProbeDigest", "negativeProbes", "issuerKeyId", "issuerSubject"
    ],
    "excludedFromSignedPayload": ["receiptDigest", "signatureAlgorithm", "signature"]
  }
}
