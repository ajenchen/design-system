    { "id": "storybook-package", "path": "packages/storybook-config/package.json", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Storybook package and release-version authority." },
    { "id": "storybook-coverage", "path": "packages/storybook-config/coverage", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local Storybook coverage output is not authority." },
    { "id": "storybook-dist", "path": "packages/storybook-config/dist", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local Storybook build output is not authority." },
    { "id": "storybook-node-modules", "path": "packages/storybook-config/node_modules", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Installed Storybook dependencies are not authority." },
    { "id": "scripts-authority", "path": "scripts", "match": "tree", "classification": "canonical-source", "excludes": ["scripts/generated"], "allowAbsent": false, "reason": "Canonical repository automation, generators, validators, schemas, and tests." },
    { "id": "scripts-generated-forbidden", "path": "scripts/generated", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Derived artifacts must live under the declared generated governance root." },
    { "id": "template-authority", "path": "template/ds-product-template", "match": "tree", "classification": "canonical-source", "excludes": ["template/ds-product-template/.cache", "template/ds-product-template/.git", "template/ds-product-template/.idea", "template/ds-product-template/.netlify", "template/ds-product-template/.next", "template/ds-product-template/.parcel-cache", "template/ds-product-template/.turbo", "template/ds-product-template/.vscode", "template/ds-product-template/build", "template/ds-product-template/coverage", "template/ds-product-template/dist", "template/ds-product-template/governance", "template/ds-product-template/node_modules", "template/ds-product-template/package-lock.json", "template/ds-product-template/schemas/provider-cli-toolchain.schema.json", "template/ds-product-template/storybook-static", "template/ds-product-template/tmp"], "allowAbsent": false, "reason": "Canonical static product-template scaffold; provider partitions and outputs derive exclusively from the registry." },
    { "id": "template-claude-commands", "path": "template/ds-product-template/.claude/commands", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated Claude command compatibility projection outside provider managed surfaces." },
    { "id": "template-claude-agents", "path": "template/ds-product-template/.claude/agents", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated Claude agent compatibility projection outside provider managed surfaces." },
    { "id": "template-claude-hooks-tombstone", "path": "template/ds-product-template/.claude/hooks", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": true, "reason": "Managed legacy Claude hook tombstone; fork generation guarantees the retired duplicate hook tree remains absent." },
    { "id": "template-governance-view", "path": "template/ds-product-template/governance", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated consumer governance lock, schema, and provider-neutral launcher substrate." },
    { "id": "template-provider-cli-toolchain-schema-view", "path": "template/ds-product-template/schemas/provider-cli-toolchain.schema.json", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated exact consumer provider CLI toolchain schema projection." },
    { "id": "template-node-modules", "path": "template/ds-product-template/node_modules", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Template-local installed dependencies are not source." },
