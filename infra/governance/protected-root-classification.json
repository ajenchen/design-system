{
  "$schema": "schemas/protected-root-classification.schema.json",
  "schemaVersion": 1,
  "providerProjectionPolicy": "derive-active-generated-views",
  "providerRegistryPath": "packages/governance/canonical/providers.json",
  "protectedRoots": [
    "AGENTS.md",
    "apps/template/package.json",
    ".claude",
    ".claude-plugin",
    ".github",
    ".devcontainer",
    "governance",
    "generated",
    "commands",
    "skills",
    "hooks",
    "snapshots-baseline",
    "infra/governance",
    "packages/design-system",
    "packages/design-system/AGENTS.md",
    "packages/design-system/CLAUDE.md",
    "packages/design-system/ds-canonical",
    "packages/design-system/src",
    "packages/design-system/package.json",
    "packages/eslint-plugin",
    "packages/governance",
    "packages/storybook-config",
    "packages/storybook-config/package.json",
    "scripts",
    "template/ds-product-template",
    "package.json",
    "package-lock.json",
    ".gitignore",
    ".npmrc",
    ".changeset",
    ".husky",
    "docs/npm-native-staged-release.md"
  ],
  "entries": [
    { "id": "root-agents", "path": "AGENTS.md", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Provider-neutral repository instruction authority." },
    { "id": "product-seed-package", "path": "apps/template/package.json", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Product seed dependency contract participating in the exact workspace lock." },
    { "id": "root-package", "path": "package.json", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Root scripts and workspace contract." },
    { "id": "root-lock", "path": "package-lock.json", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Workspace dependency and release-version input." },
    { "id": "root-gitignore", "path": ".gitignore", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Repository state-boundary policy." },
    { "id": "root-npmrc", "path": ".npmrc", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Canonical npm and release policy." },
    { "id": "claude-plugin", "path": ".claude-plugin", "match": "tree", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Claude plugin packaging and version authority." },
    { "id": "github-policy", "path": ".github", "match": "tree", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Canonical GitHub workflows and repository policy." },
    { "id": "devcontainer-policy", "path": ".devcontainer", "match": "tree", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Canonical development-container contract." },
    { "id": "plugin-command-alias", "path": "commands", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated exact Claude plugin command symlink." },
    { "id": "plugin-skill-alias", "path": "skills", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated exact Claude plugin skill symlink." },
    { "id": "root-hook-view", "path": "hooks", "match": "tree", "classification": "generated-output", "excludes": ["hooks/scripts"], "allowAbsent": false, "reason": "Generated Claude plugin hook configuration." },
    { "id": "plugin-hook-scripts-alias", "path": "hooks/scripts", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated exact Claude plugin hook-script symlink." },
    { "id": "claude-local-state", "path": ".claude", "match": "tree", "classification": "non-authority-exclusion", "excludes": [".claude/snapshots-baseline"], "allowAbsent": false, "reason": "Claude local runtime state outside registry-derived projections is not authority." },
    { "id": "claude-visual-baseline-mirror", "path": ".claude/snapshots-baseline", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated compatibility tree during the content-addressed Genesis transition and exact symlink to the provider-neutral targeted authority after closure." },
    { "id": "root-visual-baseline-mirror", "path": "snapshots-baseline", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated compatibility tree during the content-addressed Genesis transition and exact symlink to the provider-neutral curated authority after closure." },
    { "id": "governance-authority", "path": "governance", "match": "tree", "classification": "canonical-source", "excludes": ["governance/archive", "governance/generated", "governance/control-plane.lock.json"], "allowAbsent": false, "reason": "Provider-neutral memory, planning ledger, and benchmark authority." },
    { "id": "governance-archive", "path": "governance/archive", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": false, "reason": "Historical memory and coordination records are non-executable evidence." },
    { "id": "governance-generated", "path": "governance/generated", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated governance control-plane projections." },
    { "id": "governance-lock", "path": "governance/control-plane.lock.json", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated control-plane digest lock." },
    { "id": "generated-governance", "path": "generated", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Deterministic governance metadata and runtime artifacts." },
    { "id": "infra-authority", "path": "infra/governance", "match": "tree", "classification": "canonical-source", "excludes": ["infra/governance/runtime"], "allowAbsent": false, "reason": "Governance desired state, trust, schemas, libraries, CLIs, tests, and baselines." },
    { "id": "infra-runtime-ignore", "path": "infra/governance/runtime/.gitignore", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Canonical runtime evidence exclusion policy." },
    { "id": "infra-runtime-state", "path": "infra/governance/runtime", "match": "tree", "classification": "non-authority-exclusion", "excludes": ["infra/governance/runtime/.gitignore"], "allowAbsent": true, "reason": "Mutable runtime conformance and activation evidence is optional local state and is not authority." },
    { "id": "ds-package-corpus", "path": "packages/design-system", "match": "tree", "classification": "canonical-source", "excludes": ["packages/design-system/AGENTS.md", "packages/design-system/CLAUDE.md", "packages/design-system/coverage", "packages/design-system/dist", "packages/design-system/ds-canonical", "packages/design-system/node_modules", "packages/design-system/package.json", "packages/design-system/scripts", "packages/design-system/src"], "allowAbsent": false, "reason": "Canonical design-system package sources, documentation, package tooling, and configuration consumed by governance metadata." },
    { "id": "ds-generated-agents", "path": "packages/design-system/AGENTS.md", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated concise design-system package-scope augmentation; it must not duplicate repository or consumer governance." },
    { "id": "ds-generated-claude", "path": "packages/design-system/CLAUDE.md", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated thin Claude adapter for the concise package-scope augmentation." },
    { "id": "ds-package", "path": "packages/design-system/package.json", "match": "file", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Release version and design-system package authority." },
    { "id": "ds-canonical", "path": "packages/design-system/ds-canonical", "match": "tree", "classification": "canonical-source", "excludes": ["packages/design-system/ds-canonical/.claude", "packages/design-system/ds-canonical/fork"], "allowAbsent": false, "reason": "Canonical adapters, agents, commands, hooks, rules, references, skills, and product templates." },
    { "id": "ds-canonical-local-runtime", "path": "packages/design-system/ds-canonical/.claude", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local Claude runtime state inside the canonical corpus is never authority." },
    { "id": "ds-fork-view", "path": "packages/design-system/ds-canonical/fork", "match": "tree", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Generated consumer fork governance corpus." },
    { "id": "ds-scripts-compatibility-alias", "path": "packages/design-system/scripts", "match": "file", "classification": "generated-output", "excludes": [], "allowAbsent": false, "reason": "Exact Genesis compatibility symlink retained by the fork-template stage until the distinct protected cleanup PR closes the transition." },
    { "id": "ds-source", "path": "packages/design-system/src", "match": "tree", "classification": "canonical-source", "excludes": [], "allowAbsent": false, "reason": "Canonical design-system implementation and specification corpus consumed by governance metadata." },
    { "id": "ds-coverage", "path": "packages/design-system/coverage", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local design-system coverage output is not authority." },
    { "id": "ds-dist", "path": "packages/design-system/dist", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local design-system build output is not authority." },
    { "id": "ds-node-modules", "path": "packages/design-system/node_modules", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Installed design-system dependencies are local runtime material." },
    { "id": "eslint-package", "path": "packages/eslint-plugin", "match": "tree", "classification": "canonical-source", "excludes": ["packages/eslint-plugin/coverage", "packages/eslint-plugin/dist", "packages/eslint-plugin/node_modules"], "allowAbsent": false, "reason": "Canonical ESLint package corpus consumed by governance metadata." },
    { "id": "eslint-coverage", "path": "packages/eslint-plugin/coverage", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local ESLint coverage output is not authority." },
    { "id": "eslint-dist", "path": "packages/eslint-plugin/dist", "match": "tree", "classification": "non-authority-exclusion", "excludes": [], "allowAbsent": true, "reason": "Local ESLint build output is not authority." },
