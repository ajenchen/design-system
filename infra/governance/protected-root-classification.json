    { "id": "governance-package", "path": "packages/governance", "match": "tree", "classification": "canonical-source", "excludes": ["packages/governance/node_modules", "packages/governance/dist", "packages/governance/coverage"], "allowAbsent": false, "reason": "Canonical governance package runtime, CLI, registries, schemas, and tests." },
