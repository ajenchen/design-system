      "declaredSymlinks": {},
      "duplicateExemptGroups": [
        {
          "paths": ["apps/template/src/main.tsx", "apps/work/src/main.tsx"],
          "reason": "template and product retain the same minimal React bootstrap while their application roots diverge"
        },
        {
          "paths": ["apps/template/tsconfig.json", "apps/work/tsconfig.json"],
          "reason": "both workspace applications intentionally consume the shared TypeScript profile"
        },
        {
          "paths": ["apps/template/vite.config.ts", "apps/work/vite.config.ts"],
          "reason": "template canary and product intentionally share the deployment-compatible Vite host"
        }
      ]
    }
  }
