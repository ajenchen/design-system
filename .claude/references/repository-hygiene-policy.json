        ".npmrc": "npm policy",
        ".storybook": "Storybook host configuration",
        "AGENTS.md": "provider-neutral agent bootstrap",
        "CLAUDE.md": "Claude import shell",
        "CONTRIBUTING.md": "contributor guide",
        "apps": "first-party consumer applications",
        "commands": "compatibility symlink to provider commands",
        "components.json": "component tooling configuration",
        "docs": "repository documentation",
        "generated": "committed generated repository views",
        "governance": "repository governance state and projections",
        "hooks": "provider hook compatibility surface",
        "index.html": "Vite application entry document",
        "infra": "shared governance control plane",
        "netlify.toml": "Netlify deployment configuration",
        "package-lock.json": "exact npm dependency lock",
        "package.json": "workspace manifest",
        "packages": "workspace packages and canonical design-system authority",
        "scripts": "repository automation and deterministic gates",
        "skills": "compatibility symlink to provider skills",
        "snapshots-baseline": "compatibility symlink to curated visual baselines",
        "src": "root demo application source",
        "template": "published consumer template projection",
        "tsconfig.app.json": "root application TypeScript configuration",
        "tsconfig.json": "workspace TypeScript configuration",
        "tsconfig.node.json": "Node/tooling TypeScript configuration",
        "vite.config.ts": "root Vite configuration"
      },
      "declaredSymlinks": {
        ".claude/snapshots-baseline": "../infra/governance/baseline/visual/targeted",
        "commands": ".claude/commands",
        "hooks/scripts": "../.claude/hooks",
        "skills": ".claude/skills",
        "snapshots-baseline": "infra/governance/baseline/visual/curated"
      },
      "duplicateExemptGroups": [
        {
          "paths": [
            "apps/template/src/App.tsx",
            "packages/design-system/ds-canonical/templates/dashboard-app.tsx"
          ],
          "reason": "first-party dogfood app intentionally proves the canonical dashboard template byte-for-byte"
        }
      ]
    },
    "product-consumer": {
      "topLevelPurposes": {
        ".agents": "generated Codex agent discovery view",
        ".claude": "generated Claude provider view",
        ".codex": "Codex provider configuration",
        ".devcontainer": "portable development environment",
        ".env.example": "non-secret environment variable contract",
        ".gitattributes": "Git path behavior",
        ".github": "GitHub workflows and repository policy",
        ".gitignore": "Git ignore policy",
        ".npmrc": "npm policy",
        ".storybook": "Storybook host configuration",
        "AGENTS.md": "provider-neutral agent bootstrap",
        "CLAUDE.md": "Claude import shell",
        "README.md": "product repository guide",
        "apps": "product and template applications",
        "docs": "product documentation",
        "governance": "installed governance state",
        "netlify": "Netlify functions and runtime assets",
        "netlify.toml": "Netlify deployment configuration",
        "npm-shrinkwrap.json": "installed governance dependency lock",
        "package-lock.json": "exact npm dependency lock",
