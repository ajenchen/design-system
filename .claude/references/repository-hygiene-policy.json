{
  "schemaVersion": 1,
  "authority": "packages/design-system/ds-canonical/references/repository-hygiene.md",
  "transientExemptPrefixes": [
    ".claude/logs/",
    ".claude/scratch/",
    "governance/archive/",
    "infra/governance/test/fixtures/",
    "packages/design-system/ds-canonical/hooks/retired/"
  ],
  "duplicateExcludedPrefixes": [
    ".agents/",
    ".claude/",
    "generated/",
    "governance/archive/",
    "governance/generated/",
    "packages/design-system/ds-canonical/fork/",
    "scripts/package-role-sources/",
    "template/"
  ],
  "duplicateExcludedSegments": [
    "archive",
    "baseline",
    "fixtures",
    "retired"
  ],
  "profiles": {
    "authority": {
      "topLevelPurposes": {
        ".agents": "generated Codex agent discovery view",
