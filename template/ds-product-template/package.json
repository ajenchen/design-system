{
  "name": "ds-product-template",
  "private": true,
  "version": "0.0.0",
  "description": "GitHub Template Repository — fork-and-go monorepo for product team apps consuming @qijenchen/design-system. Use 'Use this template' button OR clone + npm run create-app <product-name>.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "echo 'Pick an app: cd apps/<name> && npm run dev' && exit 1",
    "build": "npm run build --workspaces",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "create-app": "node scripts/create-app.mjs",
    "lint:imports": "node scripts/lint-ds-internal-imports.mjs",
    "setup:netlify": "node scripts/setup-netlify-access.mjs",
    "deploy-url": "node scripts/deploy-url.mjs",
    "setup:plugin-check": "node scripts/check-plugin-installed.mjs",
    "setup:governance": "node scripts/setup-governance.mjs",
    "setup:all": "node scripts/setup-workspace.mjs",
    "setup:provider-cli": "node scripts/setup-provider-cli-toolchain.mjs",
    "sync-all": "node scripts/sync-all.mjs",
    "sync:workspace-dependencies": "node scripts/sync-exact-workspace-dependencies.mjs",
    "ds:migrate": "qijenchen-ds-codemod",
    "visual-baseline:review": "qijenchen-ds-visual-baseline",
    "governance:check": "node node_modules/@qijenchen/design-system/ds-canonical/fork/consumer/governance-check.mjs --repo . --hooks-off",
    "audit:a11y": "node scripts/audit-consumer-a11y.mjs"
  },
  "dependencies": {
    "@qijenchen/design-system": "0.1.0-beta.112",
    "@qijenchen/storybook-config": "0.1.0-beta.112",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "8.6.18",
    "axe-core": "4.12.1",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "npm": "11.19.0",
    "npm-runtime-brace-expansion-patch": "npm:brace-expansion@5.0.9",
    "npm-runtime-tar-patch": "npm:tar@7.5.22",
    "playwright": "^1.60.0",
    "storybook": "8.6.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "6.4.3"
  },
  "overrides": {
    "@storybook/addon-actions": {
      "uuid": "11.1.1"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.6.4",
    "postcss": "8.5.23"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
