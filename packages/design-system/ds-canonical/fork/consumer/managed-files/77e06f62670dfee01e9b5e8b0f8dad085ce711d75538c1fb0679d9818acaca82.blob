name: Sync Design System

# Receives one exact design-system release and proposes it as an upgrade branch.
#
# Contract with the design-system release orchestrator (step 5 `consumer`, delivery
# `repository-dispatch-pr`): it sends `repository_dispatch` `design-system-published` with
# `client_payload = { version, tag, commit }`, waits for `automation/design-system-<version>`,
# and then opens the upgrade PR itself with its canonical credential. GitHub does not run
# workflows for a PR opened by this run's `GITHUB_TOKEN`, so a PR opened here would never get
# `Verify consumer`; this workflow therefore only validates, upgrades, and pushes the branch.
# A repository that is not registered with the orchestrator can send the same dispatch by hand
# and open the PR from the pushed branch (docs/04-ds-upgrade.md).
#
# The upgrade runs on a GitHub-hosted runner, so it needs no local proxy or CA setup. GitHub
# refuses workflow-file changes pushed with `GITHUB_TOKEN` (it cannot hold the `workflows`
# permission); a release that changes `.github/workflows/**` therefore stops before the push
# and is applied with `npm run sync-all` on a local terminal instead.

on:
  repository_dispatch:
    types: [design-system-published]

concurrency:
  group: sync-design-system
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  sync:
    name: Receive exact design-system release
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    env:
      DS_SOURCE_REPOSITORY: ajenchen/design-system
      DS_VERSION: ${{ github.event.client_payload.version }}
      DS_TAG: ${{ github.event.client_payload.tag }}
      DS_COMMIT: ${{ github.event.client_payload.commit }}
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
        with:
          persist-credentials: false

      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version-file: scripts/.node-version
          cache: npm

      # Payload values reach the shell only as environment variables, never as `${{ }}` text.
      - name: Validate dispatch payload
        id: payload
        shell: bash
        run: |
          set -euo pipefail
          node scripts/workflow-static-validation.mjs assert-exact-semver --value "$DS_VERSION"
          if [[ "$DS_TAG" != "v${DS_VERSION}" ]]; then
            echo "::error::client_payload.tag must equal v<version>" >&2
            exit 1
          fi
          if [[ ! "$DS_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
            echo "::error::client_payload.commit must be a lowercase 40-character commit SHA" >&2
            exit 1
          fi
          echo "branch=automation/design-system-${DS_VERSION}" >> "$GITHUB_OUTPUT"

      - name: Verify the release tag points at the dispatched commit
        shell: bash
        run: |
          set -euo pipefail
          tag_sha="$(
            git ls-remote --tags "https://github.com/${DS_SOURCE_REPOSITORY}.git" \
              "refs/tags/${DS_TAG}" "refs/tags/${DS_TAG}^{}" |
              awk '$2 ~ /\^\{\}$/ { peeled = $1 } $2 !~ /\^\{\}$/ { direct = $1 } END { print peeled ? peeled : direct }'
          )"
          if [[ "$tag_sha" != "$DS_COMMIT" ]]; then
            echo "::error::${DS_SOURCE_REPOSITORY}@${DS_TAG} resolves to '${tag_sha}', not the dispatched commit" >&2
            exit 1
          fi

      - name: Install current exact dependencies
        shell: bash
        run: |
          set -euo pipefail
          npm ci --ignore-scripts
          npm audit signatures

      # sync-all verifies the immutable release, Release BOM, npm provenance and signatures, and only
      # blocks vulnerabilities this upgrade newly introduces. It executes only this repository's
      # current scripts; incoming scripts/** arrive as data in the branch diff.
      - name: Apply the exact upgrade transaction
        shell: bash
        env:
          BRANCH: ${{ steps.payload.outputs.branch }}
        run: |
          set -euo pipefail
          git switch --create "$BRANCH"
          npm run sync-all -- --apply --to "$DS_VERSION"

      - name: Commit the upgrade
        id: commit
        shell: bash
        run: |
          set -euo pipefail
          git add --all
          if git diff --cached --quiet; then
            echo "changed=false" >> "$GITHUB_OUTPUT"
            echo "main already consumes ${DS_VERSION}; nothing to propose."
            exit 0
          fi
          workflow_changes="$(git diff --cached --name-only -- .github/workflows)"
          if [[ -n "$workflow_changes" ]]; then
            echo "::error::This release changes workflow files that GITHUB_TOKEN cannot push: ${workflow_changes//$'\n'/, }. Run 'npm run sync-all -- --apply --to ${DS_VERSION}' on a local terminal (docs/04-ds-upgrade.md)." >&2
            exit 1
          fi
          git -c user.name='github-actions[bot]' -c user.email='41898282+github-actions[bot]@users.noreply.github.com' \
            commit --quiet -m "chore(ds): sync ${DS_TAG}"
          echo "changed=true" >> "$GITHUB_OUTPUT"

      # The token lives only in this step's process environment; it is never written to .git/config.
      # A plain push creates the branch and is rejected if it already exists.
      - name: Push the automation branch
        if: steps.commit.outputs.changed == 'true'
        shell: bash
        env:
          BRANCH: ${{ steps.payload.outputs.branch }}
          PUSH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          basic="$(printf 'x-access-token:%s' "$PUSH_TOKEN" | base64 | tr -d '\n')"
          echo "::add-mask::${basic}"
          if ! GIT_CONFIG_COUNT=1 \
            GIT_CONFIG_KEY_0='http.https://github.com/.extraheader' \
            GIT_CONFIG_VALUE_0="AUTHORIZATION: basic ${basic}" \
            git push origin "HEAD:refs/heads/${BRANCH}"; then
            echo "::error::Could not create ${BRANCH}. If it already exists, delete it and send the dispatch again." >&2
            exit 1
          fi
