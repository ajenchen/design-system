{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "ds-product-template",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22@sha256:0d29e5fdc64f8397cd502223e0c4679f1e60877ca0fd2db4f2e2e0028e4271af",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {}
  },
  "forwardPorts": [6006, 5173],
  "portsAttributes": {
    "6006": { "label": "Storybook", "onAutoForward": "openPreview" },
    "5173": { "label": "Vite Dev", "onAutoForward": "notify" }
  },
  "postCreateCommand": ["node", ".devcontainer/post-create.mjs"],
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "unifiedjs.vscode-mdx"
      ]
    }
  },
  "remoteUser": "node"
}
