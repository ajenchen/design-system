{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/governance-hook-registrations-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hooks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "hooks": {
      "type": "object",
      "propertyNames": { "enum": ["PreToolUse", "PostToolUse", "Stop", "SessionStart", "UserPromptSubmit"] },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matcher", "hooks"],
          "properties": {
            "matcher": { "type": "string", "pattern": "^(?:[A-Za-z0-9_.:-]+(?:\\|[A-Za-z0-9_.:-]+)*)?$" },
            "hooks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "hook", "runtime", "outputMode"],
                    "properties": {
                      "kind": { "const": "hook" },
                      "hook": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                      "runtime": { "enum": ["bash", "node", "python3"] },
                      "outputMode": { "enum": ["diagnostic", "blocking", "governance-context", "governance-decision", "governance-context-or-block"] },
                      "inputContract": { "enum": ["event-v1", "proposed-text-v1"] },
                      "transcript": { "enum": ["none", "optional", "stable-required"] },
                      "requires": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "enum": ["peer-review-binding", "peer-cli"] }
                      },
                      "reviewSkill": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                    },
                    "dependentRequired": {
                      "requires": ["reviewSkill"],
                      "reviewSkill": ["requires"]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
