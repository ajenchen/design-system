{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/managed-ci-trusted-execution-plan-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "workflow", "activatedWorkflowContract", "oidcBrokerPolicy", "executorSupplyChainPolicy", "trustedAuthorityPolicy", "activationTrustBundle", "executionClasses", "observation", "trust", "activation"],
  "properties": {
    "$schema": {"const": "schemas/managed-ci-trusted-execution-plan.schema.json"},
    "schemaVersion": {"const": 2},
    "kind": {"const": "managed-ci-trusted-execution-plan"},
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "ref", "event", "runnerEnvironment", "runnerLabels", "requireProtectedMain", "runAttemptRequired", "definitionTreeInput", "subjectInputs"],
      "properties": {
        "repository": {"const": "ajenchen/design-system"},
        "path": {"const": ".github/workflows/deep-audit-managed.yml"},
        "ref": {"const": "refs/heads/main"},
        "event": {"const": "workflow_dispatch"},
        "runnerEnvironment": {"const": "self-hosted"},
        "runnerLabels": {"type": "array", "prefixItems": [{"const": "self-hosted"}, {"const": "linux"}, {"const": "x64"}, {"const": "qijenchen-managed-ci-v1"}], "items": false, "minItems": 4, "maxItems": 4},
        "requireProtectedMain": {"const": true},
        "runAttemptRequired": {"const": true},
        "definitionTreeInput": {"const": "workflowDefinitionTree"},
        "subjectInputs": {
          "type": "object", "additionalProperties": false,
          "required": ["commit", "tree", "manifestSha256", "runId"],
          "properties": {
            "commit": {"const": "subjectCommit"},
            "tree": {"const": "subjectTree"},
            "manifestSha256": {"const": "manifestSha256"},
            "runId": {"const": "subjectRunId"}
          }
        }
      }
    },
    "activatedWorkflowContract": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "schemaPath"],
      "properties": {
        "path": {"const": "scripts/managed-ci-activated-workflow-contract.json"},
        "schemaPath": {"const": "scripts/schemas/managed-ci-activated-workflow-contract.schema.json"}
      }
    },
    "oidcBrokerPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "schemaPath"],
      "properties": {
        "path": {"const": "infra/governance/providers/managed-ci-oidc-broker-policy.json"},
        "schemaPath": {"const": "infra/governance/schemas/managed-ci-oidc-broker-policy.schema.json"}
      }
    },
    "executorSupplyChainPolicy": {
      "type": "object", "additionalProperties": false, "required": ["path", "schemaPath"],
      "properties": {"path": {"const": "infra/governance/providers/managed-ci-executor-supply-chain.json"}, "schemaPath": {"const": "infra/governance/schemas/managed-ci-executor-supply-chain.schema.json"}}
    },
    "trustedAuthorityPolicy": {
      "type": "object", "additionalProperties": false, "required": ["path", "schemaPath"],
      "properties": {"path": {"const": "infra/governance/providers/managed-ci-trusted-authority-policy.json"}, "schemaPath": {"const": "infra/governance/schemas/managed-ci-trusted-authority-policy.schema.json"}}
    },
    "activationTrustBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestPath", "buildGraphPath", "buildGraphSchemaPath", "stageId", "sourceResolvers", "controlPlaneLockPath", "controlPlaneLockSchemaPath"],
      "properties": {
        "manifestPath": {"const": "packages/governance/canonical/manifest.json"},
        "buildGraphPath": {"const": "scripts/governance-build-graph.json"},
        "buildGraphSchemaPath": {"const": "scripts/schemas/governance-build-graph.schema.json"},
        "stageId": {"const": "control-plane"},
        "sourceResolvers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"const": "governance-manifest"},
            {"const": "root-provider-views"}
          ],
          "items": false
        },
        "controlPlaneLockPath": {"const": "governance/control-plane.lock.json"},
        "controlPlaneLockSchemaPath": {"const": "packages/governance/canonical/schemas/lock.schema.json"}
      }
    },
    "executionClasses": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/dependencyClass"},
        {"$ref": "#/$defs/auditClass"},
        {"$ref": "#/$defs/modelClass"},
        {"$ref": "#/$defs/observerClass"}
      ],
      "items": false
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["maxAgeSeconds", "clockSkewSeconds", "noncePattern", "oidcIssuer", "oidcAudience"],
      "properties": {
        "maxAgeSeconds": {"const": 3600},
        "clockSkewSeconds": {"const": 120},
        "noncePattern": {"const": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "oidcIssuer": {"const": "https://token.actions.githubusercontent.com"},
        "oidcAudience": {"const": "qijenchen-managed-deep-audit-authority-v1"}
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerRegistryPath", "issuerPolicyPath", "issuerPolicyPointer", "runtimeEvidencePolicyPath", "issuerRole", "allowedKeyIdsField", "quorumField", "maxTtlMinutesField", "clockSkewSecondsField", "replay", "retention"],
      "properties": {
        "issuerRegistryPath": {"const": "infra/governance/trust/issuers.json"},
        "issuerPolicyPath": {"const": "infra/governance/release-rings.json"},
        "issuerPolicyPointer": {"const": "attestationPolicy"},
        "runtimeEvidencePolicyPath": {"const": "infra/governance/providers/runtime-conformance.json"},
        "issuerRole": {"const": "completion-attestor"},
        "allowedKeyIdsField": {"const": "allowedKeyIds"},
        "quorumField": {"const": "completionAttestationQuorum"},
        "maxTtlMinutesField": {"const": "maxCompletionTtlMinutes"},
        "clockSkewSecondsField": {"const": "clockSkewSeconds"},
        "replay": {
          "type": "object", "additionalProperties": false,
          "required": ["ledger", "minimumRetentionSeconds"],
          "properties": {
            "ledger": {"const": "external-atomic-ttl-replay-ledger"},
            "minimumRetentionSeconds": {"const": 31536120}
          }
        },
        "retention": {
          "type": "object", "additionalProperties": false,
          "required": ["minimumSeconds", "authority"],
          "properties": {
            "minimumSeconds": {"const": 31536000},
            "authority": {"const": "offline-evidence-archive-compliance-object-lock"}
          }
        }
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowIdentity", "repositoryId", "repositoryOwnerId", "executorSourceCommit", "executorSourceTree", "builderWorkflowSha", "executorBuildRunId", "executorBuildRunAttempt", "imageSetArtifactId", "imageSetArtifactDigest", "imageSetManifestSha256", "imageSetInventorySha256", "imageSetInventoryEntryCount", "imageSetArtifactRetentionDays", "verifiedAt", "trustedAuthorityAttestationDigest", "hostSandboxAttestationDigest", "receiptSignerTrustReadbackDigest", "offlineEvidenceArchive", "executionClasses", "verificationReceipt"],
      "properties": {
        "workflowIdentity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/workflowIdentity"}]},
        "repositoryId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
        "repositoryOwnerId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
        "executorSourceCommit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
        "executorSourceTree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
        "builderWorkflowSha": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{40}$"}]},
        "executorBuildRunId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
        "executorBuildRunAttempt": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "imageSetArtifactId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[1-9][0-9]*$"}]},
        "imageSetArtifactDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "imageSetManifestSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "imageSetInventorySha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "imageSetInventoryEntryCount": {"oneOf": [{"type": "null"}, {"const": 18}]},
        "imageSetArtifactRetentionDays": {"oneOf": [{"type": "null"}, {"const": 90}]},
        "verifiedAt": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}]},
        "trustedAuthorityAttestationDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "hostSandboxAttestationDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "receiptSignerTrustReadbackDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "offlineEvidenceArchive": {"$ref": "#/$defs/offlineEvidenceArchive"},
        "executionClasses": {
          "type": "object", "additionalProperties": false,
          "required": ["dependency-acquisition", "deterministic-hook-audit", "model-broker", "github-observer"],
          "properties": {
            "dependency-acquisition": {"$ref": "#/$defs/classActivation"},
            "deterministic-hook-audit": {"$ref": "#/$defs/classActivation"},
            "model-broker": {"$ref": "#/$defs/classActivation"},
            "github-observer": {"$ref": "#/$defs/classActivation"}
          }
        },
        "verificationReceipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/activationVerificationReceipt"}]}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_@./-]+$"},
    "closedStringArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allowedHosts", "tlsRequired"],
      "properties": {
        "mode": {"enum": ["none", "tls-host-allowlist", "provider-selected-tls-host-allowlist"]},
        "allowedHosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
        "tlsRequired": {"const": true}
      }
    },
    "filesystem": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "rootFilesystem", "declaredOutputRootsOnly"],
      "properties": {
        "repository": {"enum": ["read-only", "not-mounted"]},
        "rootFilesystem": {"enum": ["ephemeral-write", "read-only"]},
        "declaredOutputRootsOnly": {"const": true}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "rootless", "runAsUser", "runAsGroup", "noNewPrivileges", "capabilities", "hostSocketMounted", "secretMountPolicy", "tmpfsRoots", "writableRootPolicy"],
      "properties": {
        "backend": {"const": "externally-managed-rootless-podman-sandbox"},
        "rootless": {"const": true},
        "runAsUser": {"const": 65532},
        "runAsGroup": {"const": 65532},
        "noNewPrivileges": {"const": true},
        "capabilities": {"type": "array", "maxItems": 0},
        "hostSocketMounted": {"const": false},
        "secretMountPolicy": {"enum": ["none", "external-proxy-no-secret-in-candidate"]},
        "tmpfsRoots": {"type": "array", "prefixItems": [{"const": "/tmp"}], "items": false, "minItems": 1, "maxItems": 1},
        "writableRootPolicy": {"const": "tmpfs-and-declared-output-roots"}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["actions", "artifact-metadata", "attestations", "checks", "code-quality", "contents", "deployments", "discussions", "id-token", "issues", "models", "packages", "pages", "pull-requests", "security-events", "statuses", "vulnerability-alerts"],
      "properties": {
        "actions": {"enum": ["none", "read"]},
        "artifact-metadata": {"const": "none"},
        "attestations": {"const": "none"},
        "checks": {"enum": ["none", "read"]},
        "code-quality": {"const": "none"},
        "contents": {"const": "read"},
        "deployments": {"const": "none"},
        "discussions": {"const": "none"},
        "id-token": {"const": "none"},
        "issues": {"const": "none"},
        "models": {"const": "none"},
        "packages": {"const": "none"},
        "pages": {"const": "none"},
        "pull-requests": {"enum": ["none", "read"]},
        "security-events": {"const": "none"},
        "statuses": {"const": "none"},
        "vulnerability-alerts": {"const": "none"}
      }
    },
    "providerEgressRegistry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "providerField", "hostsField", "selection"],
      "properties": {
        "path": {"const": "infra/governance/providers/model-invocation-profiles.json"},
        "providerField": {"const": "providerId"},
        "hostsField": {"const": "egressAllowedHosts"},
        "selection": {"const": "exactly-one"}
      }
    },
    "dependencyClass": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "job", "evidenceKinds", "profilePaths", "network", "filesystem", "isolation", "permissions", "secretMode", "inputMode", "install"],
      "properties": {
        "id": {"const": "dependency-acquisition"}, "job": {"const": "dependency-acquisition"},
        "evidenceKinds": {"type": "array", "prefixItems": [{"const": "dependency-bundle"}], "items": false, "minItems": 1, "maxItems": 1},
        "profilePaths": {"type": "array", "prefixItems": [{"const": ".npmrc"}, {"const": "package-lock.json"}], "items": false, "minItems": 2, "maxItems": 2},
        "network": {"allOf": [{"$ref": "#/$defs/network"}, {"type": "object", "properties": {"mode": {"const": "tls-host-allowlist"}, "allowedHosts": {"type": "array", "prefixItems": [{"const": "registry.npmjs.org"}], "items": false, "minItems": 1, "maxItems": 1}}}]},
        "filesystem": {"allOf": [{"$ref": "#/$defs/filesystem"}, {"type": "object", "properties": {"repository": {"const": "read-only"}, "rootFilesystem": {"const": "ephemeral-write"}}}]},
        "isolation": {"$ref": "#/$defs/isolation"},
        "permissions": {"allOf": [{"$ref": "#/$defs/permissions"}, {"type": "object", "properties": {"actions": {"const": "none"}, "checks": {"const": "none"}, "pull-requests": {"const": "none"}}}]},
        "secretMode": {"const": "none"}, "inputMode": {"const": "frozen-repository"},
        "install": {"$ref": "#/$defs/install"}
      }
    },
    "auditClass": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "job", "evidenceKinds", "profilePaths", "network", "filesystem", "isolation", "permissions", "secretMode", "inputMode"],
      "properties": {
        "id": {"const": "deterministic-hook-audit"}, "job": {"const": "deterministic-hook-audit"},
        "evidenceKinds": {"type": "array", "prefixItems": [{"const": "deep-audit-deterministic"}, {"const": "deep-audit-hook-residue"}], "items": false, "minItems": 2, "maxItems": 2},
        "profilePaths": {"type": "array", "prefixItems": [{"const": "scripts/deep-audit-deterministic-plan.json"}, {"const": "infra/governance/hook-evidence-plan.json"}], "items": false, "minItems": 2, "maxItems": 2},
        "network": {"allOf": [{"$ref": "#/$defs/network"}, {"type": "object", "properties": {"mode": {"const": "none"}, "allowedHosts": {"type": "array", "maxItems": 0}}}]},
        "filesystem": {"allOf": [{"$ref": "#/$defs/filesystem"}, {"type": "object", "properties": {"repository": {"const": "read-only"}, "rootFilesystem": {"const": "read-only"}}}]},
        "isolation": {"$ref": "#/$defs/isolation"},
        "permissions": {"allOf": [{"$ref": "#/$defs/permissions"}, {"type": "object", "properties": {"actions": {"const": "none"}, "checks": {"const": "none"}, "pull-requests": {"const": "none"}}}]},
        "secretMode": {"const": "none"}, "inputMode": {"const": "verified-dependency-bundle"}
      }
    },
    "modelClass": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "job", "evidenceKinds", "profilePaths", "network", "providerEgressRegistry", "filesystem", "isolation", "permissions", "secretMode", "inputMode", "selectedProviderRequired"],
      "properties": {
        "id": {"const": "model-broker"}, "job": {"const": "model-broker"},
        "evidenceKinds": {"type": "array", "prefixItems": [{"const": "deep-audit-judgment"}, {"const": "deep-audit-component-a1b"}], "items": false, "minItems": 2, "maxItems": 2},
        "profilePaths": {"type": "array", "prefixItems": [{"const": "infra/governance/model-evidence-broker.json"}, {"const": "infra/governance/model-evidence-plan.json"}, {"const": "infra/governance/providers/model-invocation-profiles.json"}], "items": false, "minItems": 3, "maxItems": 3},
        "network": {"allOf": [{"$ref": "#/$defs/network"}, {"type": "object", "properties": {"mode": {"const": "provider-selected-tls-host-allowlist"}, "allowedHosts": {"type": "array", "maxItems": 0}}}]},
        "providerEgressRegistry": {"$ref": "#/$defs/providerEgressRegistry"},
        "filesystem": {"allOf": [{"$ref": "#/$defs/filesystem"}, {"type": "object", "properties": {"repository": {"const": "not-mounted"}, "rootFilesystem": {"const": "read-only"}}}]},
        "isolation": {"allOf": [{"$ref": "#/$defs/isolation"}, {"type": "object", "properties": {"secretMountPolicy": {"const": "external-proxy-no-secret-in-candidate"}}}]},
        "permissions": {"allOf": [{"$ref": "#/$defs/permissions"}, {"type": "object", "properties": {"actions": {"const": "none"}, "checks": {"const": "none"}, "pull-requests": {"const": "none"}}}]},
        "secretMode": {"const": "external-authority-model-egress-proxy"}, "inputMode": {"const": "bounded-content-addressed-signed-shards"},
        "selectedProviderRequired": {"const": true}
      }
    },
    "observerClass": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "job", "evidenceKinds", "profilePaths", "network", "filesystem", "isolation", "permissions", "secretMode", "inputMode"],
      "properties": {
        "id": {"const": "github-observer"}, "job": {"const": "github-observer"},
        "evidenceKinds": {"type": "array", "prefixItems": [{"const": "deep-audit-ci-enforced"}], "items": false, "minItems": 1, "maxItems": 1},
        "profilePaths": {"type": "array", "prefixItems": [{"const": "scripts/ci-evidence-plan.json"}, {"const": "infra/governance/external-activation-policy.json"}], "items": false, "minItems": 2, "maxItems": 2},
        "network": {"allOf": [{"$ref": "#/$defs/network"}, {"type": "object", "properties": {"mode": {"const": "tls-host-allowlist"}, "allowedHosts": {"type": "array", "prefixItems": [{"const": "api.github.com"}], "items": false, "minItems": 1, "maxItems": 1}}}]},
        "filesystem": {"allOf": [{"$ref": "#/$defs/filesystem"}, {"type": "object", "properties": {"repository": {"const": "read-only"}, "rootFilesystem": {"const": "read-only"}}}]},
        "isolation": {"allOf": [{"$ref": "#/$defs/isolation"}, {"type": "object", "properties": {"secretMountPolicy": {"const": "external-proxy-no-secret-in-candidate"}}}]},
        "permissions": {"allOf": [{"$ref": "#/$defs/permissions"}, {"type": "object", "properties": {"actions": {"const": "read"}, "checks": {"const": "read"}, "pull-requests": {"const": "read"}}}]},
        "secretMode": {"const": "external-authority-github-api-proxy"}, "inputMode": {"const": "canonical-read-only-api"}
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "lockfile", "installedLockfile", "lifecycleScripts", "requireLockfileSri", "output"],
      "properties": {
        "command": {"type": "array", "prefixItems": [{"const": "npm"}, {"const": "ci"}, {"const": "--legacy-peer-deps"}, {"const": "--ignore-scripts"}, {"const": "--registry=https://registry.npmjs.org/"}], "items": false, "minItems": 5, "maxItems": 5},
        "lockfile": {"const": "package-lock.json"},
        "installedLockfile": {"const": "node_modules/.package-lock.json"},
        "lifecycleScripts": {"const": false},
        "requireLockfileSri": {"const": true},
        "output": {"const": "content-addressed-dependency-bundle"}
      }
    },
    "workflowIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["contentSha256", "gitBlobSha", "semanticVersion", "semanticSha256"],
      "properties": {"contentSha256": {"$ref": "#/$defs/sha256"}, "gitBlobSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "semanticVersion": {"const": 2}, "semanticSha256": {"$ref": "#/$defs/sha256"}}
    },
    "offlineEvidenceArchive": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["locator", "digest", "size", "format", "inventoryDigest", "objectVersionId", "retentionMode", "retentionUntil", "writerPrincipal", "verifierPrincipal", "readbackDigest"],
          "properties": {
            "locator": {"type": "null"},
            "digest": {"type": "null"},
            "size": {"type": "null"},
            "format": {"type": "null"},
            "inventoryDigest": {"type": "null"},
            "objectVersionId": {"type": "null"},
            "retentionMode": {"type": "null"},
            "retentionUntil": {"type": "null"},
            "writerPrincipal": {"type": "null"},
            "verifierPrincipal": {"type": "null"},
            "readbackDigest": {"type": "null"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["locator", "digest", "size", "format", "inventoryDigest", "objectVersionId", "retentionMode", "retentionUntil", "writerPrincipal", "verifierPrincipal", "readbackDigest"],
          "properties": {
            "locator": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(?!github\\.com/[^/]+/[^/]+/actions/runs/)(?!api\\.github\\.com/repos/[^/]+/[^/]+/actions/artifacts/)[^?#]+$"
            },
            "digest": {"$ref": "#/$defs/sha256"},
            "size": {"type": "integer", "minimum": 1},
            "format": {"const": "tar-pax-v1"},
            "inventoryDigest": {"$ref": "#/$defs/sha256"},
            "objectVersionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
            "retentionMode": {"const": "compliance-object-lock"},
            "retentionUntil": {"type": "string", "format": "date-time"},
            "writerPrincipal": {"type": "string", "minLength": 1, "maxLength": 512},
            "verifierPrincipal": {"type": "string", "minLength": 1, "maxLength": 512},
            "readbackDigest": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "activationVerificationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "receiptId", "declarationDigest", "trustBinding", "archive", "aggregateHandoff", "imageDigests", "runtimeSourceDigests", "runtimeInventoryDigests", "evidenceSetDigests", "verification", "issuedAt", "expiresAt", "nonce", "replay", "issuerRegistryDigest", "signatures"],
      "properties": {
        "schemaVersion": {"const": 2},
        "kind": {"const": "managed-ci-activation-verification-receipt-v2"},
        "receiptId": {"$ref": "#/$defs/uuid"},
        "declarationDigest": {"$ref": "#/$defs/sha256"},
        "trustBinding": {
          "type": "object", "additionalProperties": false,
          "required": ["bindingDigest", "activationTrustBundleDigest", "executorSourceCommit", "executorSourceTree", "trustTreeFilesDigest", "trustTreeFileCount", "manifestDigest", "buildGraphDigest", "sourceSetDigest", "sourceCount", "controlPlaneLockSha256", "controlPlaneLockBlobSha", "controlPlaneContractDigest", "controlPlaneInputDigest", "controlPlaneSnapshotDigest", "generatedSnapshotDigest", "receiptPolicyDigest"],
          "properties": {
            "bindingDigest": {"$ref": "#/$defs/sha256"},
            "activationTrustBundleDigest": {"$ref": "#/$defs/sha256"},
            "executorSourceCommit": {"$ref": "#/$defs/sha1"},
            "executorSourceTree": {"$ref": "#/$defs/sha1"},
