        "runtimeSourceSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "runtimeInventoryDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "contextArchiveDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "sbomDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "slsaProvenanceDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
