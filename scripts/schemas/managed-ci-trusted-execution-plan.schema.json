          "properties": {
            "archiveBytesVerified": {"const": true},
            "closedInventoryVerified": {"const": true},
            "sigstoreBundlesVerified": {"const": true},
            "certificateIdentityVerified": {"const": true},
            "rekorInclusionVerified": {"const": true},
            "githubAttestationReadbackVerified": {"const": true},
            "registryReadbackVerified": {"const": true},
            "wormReadbackVerified": {"const": true},
            "controlPlaneClosureVerified": {"const": true},
            "replayLedgerCommitVerified": {"const": true}
          }
        },
        "issuedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "nonce": {"$ref": "#/$defs/uuid"},
        "replay": {
          "type": "object", "additionalProperties": false,
          "required": ["ledger", "reservationId", "ledgerReceiptDigest", "committedAt", "retentionUntil"],
          "properties": {
            "ledger": {"const": "external-atomic-ttl-replay-ledger"},
            "reservationId": {"$ref": "#/$defs/uuid"},
