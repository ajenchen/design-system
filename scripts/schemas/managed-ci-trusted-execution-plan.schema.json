            "manifestSha256": {"$ref": "#/$defs/sha256"},
            "inventorySha256": {"$ref": "#/$defs/sha256"},
            "inventoryEntryCount": {"const": 18},
            "artifactFileCount": {"const": 19},
            "artifactRetentionDays": {"const": 90},
