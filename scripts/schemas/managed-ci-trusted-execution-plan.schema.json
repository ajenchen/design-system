            "controlPlaneInputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "controlPlaneSnapshotDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "generatedSnapshotDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "receiptPolicyDigest": {"$ref": "#/$defs/sha256"}
