{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/managed-ci-finalized-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kind", "executionClass", "evidenceKind", "workflowRunId", "runAttempt",
    "rawReceiptDigest", "rawReceiptSchemaDigest", "rawReceiptValidationDigest", "provenanceBindingDigest", "receiptBindingDigest",
    "frozenSubjectReadbackDigest", "hostObservationReceiptDigest", "imageSupplyChainBindingDigest",
    "signerAuthorityBindingDigest", "issuerMappingDigest", "signedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "managed-ci-finalized-receipt-v1"},
    "executionClass": {"enum": ["dependency-acquisition", "deterministic-hook-audit", "model-broker", "github-observer"]},
    "evidenceKind": {"enum": ["dependency-bundle", "deep-audit-deterministic", "deep-audit-hook-residue", "deep-audit-judgment", "deep-audit-component-a1b", "deep-audit-ci-enforced"]},
    "workflowRunId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "runAttempt": {"type": "integer", "minimum": 1},
    "rawReceiptDigest": {"$ref": "#/$defs/sha256"},
    "rawReceiptSchemaDigest": {"$ref": "#/$defs/sha256"},
    "rawReceiptValidationDigest": {"$ref": "#/$defs/sha256"},
    "provenanceBindingDigest": {"$ref": "#/$defs/sha256"},
    "receiptBindingDigest": {"$ref": "#/$defs/sha256"},
    "frozenSubjectReadbackDigest": {"$ref": "#/$defs/sha256"},
    "hostObservationReceiptDigest": {"$ref": "#/$defs/sha256"},
    "imageSupplyChainBindingDigest": {"$ref": "#/$defs/sha256"},
    "signerAuthorityBindingDigest": {"$ref": "#/$defs/sha256"},
    "issuerMappingDigest": {"$ref": "#/$defs/sha256"},
    "signedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
