{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/managed-ci-sandbox-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialization", "manifestVerificationBeforeDigest", "manifestVerificationAfterDigest",
    "callerFingerprintBeforeDigest", "callerFingerprintAfterDigest", "dependencyViewBeforeDigest",
    "dependencyViewAfterDigest", "dependencyLockfileSha256", "installedLockfileSha256",
    "installedDependencyIdentityDigest", "dependencyProvenance", "dependencyTrust", "executionIsolation",
    "containmentBackend", "externalWriteContainment", "cleanup", "installedPackageCount", "attestation"
  ],
  "properties": {
    "materialization": {"const": "fresh-npm-ci-from-frozen-lockfile"},
    "manifestVerificationBeforeDigest": {"$ref": "#/$defs/sha256"},
    "manifestVerificationAfterDigest": {"$ref": "#/$defs/sha256"},
    "callerFingerprintBeforeDigest": {"$ref": "#/$defs/sha256"},
    "callerFingerprintAfterDigest": {"$ref": "#/$defs/sha256"},
    "dependencyViewBeforeDigest": {"$ref": "#/$defs/sha256"},
    "dependencyViewAfterDigest": {"$ref": "#/$defs/sha256"},
    "dependencyLockfileSha256": {"$ref": "#/$defs/sha256"},
    "installedLockfileSha256": {"$ref": "#/$defs/sha256"},
    "installedDependencyIdentityDigest": {"$ref": "#/$defs/sha256"},
    "dependencyProvenance": {"const": "fresh-npm-ci"},
    "dependencyTrust": {"const": "managed-ci-attested"},
    "executionIsolation": {"const": "ephemeral-managed-ci-container"},
    "containmentBackend": {"enum": ["github-hosted-ephemeral-container", "self-hosted-attested-ephemeral-container"]},
    "externalWriteContainment": {"const": "verified"},
    "cleanup": {"const": true},
    "installedPackageCount": {"type": "integer", "minimum": 1},
    "attestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"},
    "isoTime": {"type": "string", "format": "date-time"},
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["beforeDigest", "afterDigest"],
      "properties": {"beforeDigest": {"$ref": "#/$defs/sha256"}, "afterDigest": {"$ref": "#/$defs/sha256"}}
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["lockfileSha256", "installedLockfileSha256", "installedDependencyIdentityDigest", "installedPackageCount"],
      "properties": {
        "lockfileSha256": {"$ref": "#/$defs/sha256"},
        "installedLockfileSha256": {"$ref": "#/$defs/sha256"},
        "installedDependencyIdentityDigest": {"$ref": "#/$defs/sha256"},
        "installedPackageCount": {"type": "integer", "minimum": 1}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerEnvironment", "runnerImageDigest", "containerImageDigest", "containerIdDigest", "oidcClaimsDigest", "containmentBackend", "externalWriteContainment"],
      "properties": {
        "runnerEnvironment": {"enum": ["github-hosted", "self-hosted-attested"]},
        "runnerImageDigest": {"$ref": "#/$defs/sha256"},
        "containerImageDigest": {"$ref": "#/$defs/imageDigest"},
        "containerIdDigest": {"$ref": "#/$defs/sha256"},
        "oidcClaimsDigest": {"$ref": "#/$defs/sha256"},
        "containmentBackend": {"enum": ["github-hosted-ephemeral-container", "self-hosted-attested-ephemeral-container"]},
        "externalWriteContainment": {"const": "verified"}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "runId", "runAttempt", "event", "head", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "runAttempt": {"type": "integer", "minimum": 1},
        "event": {"enum": ["workflow_dispatch", "push", "pull_request"]},
        "head": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"}
      }
    },
    "activeRun": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "manifestSha256", "head", "tree"],
      "properties": {
        "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "head": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "issuerRegistryDigest", "runtimePolicyDigest", "observedAt", "expiresAt", "nonce",
        "planDigest", "profileDigest", "executionClass", "evidenceKind", "selectedProvider",
        "networkPolicyDigest", "isolationPolicyDigest", "permissionsDigest", "workflowIdentityDigest",
        "containerImageDigest", "oidcClaimsDigest", "dependencyBundleDigest", "evidenceEnvelopeDigest",
        "dependency", "execution", "workflow", "activeRun", "callerClosure", "manifestClosure",
        "dependencyClosure", "generatedOutputClosureDigest", "cleanup"
      ],
      "properties": {
        "issuerRegistryDigest": {"$ref": "#/$defs/sha256"},
        "runtimePolicyDigest": {"$ref": "#/$defs/sha256"},
        "observedAt": {"$ref": "#/$defs/isoTime"},
        "expiresAt": {"$ref": "#/$defs/isoTime"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "planDigest": {"$ref": "#/$defs/sha256"},
        "profileDigest": {"$ref": "#/$defs/sha256"},
        "executionClass": {"enum": ["dependency-acquisition", "deterministic-hook-audit", "model-broker", "github-observer"]},
        "evidenceKind": {"enum": ["dependency-bundle", "deep-audit-deterministic", "deep-audit-hook-residue", "deep-audit-judgment", "deep-audit-component-a1b", "deep-audit-ci-enforced"]},
        "selectedProvider": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
        "networkPolicyDigest": {"$ref": "#/$defs/sha256"},
        "isolationPolicyDigest": {"$ref": "#/$defs/sha256"},
        "permissionsDigest": {"$ref": "#/$defs/sha256"},
        "workflowIdentityDigest": {"$ref": "#/$defs/sha256"},
        "containerImageDigest": {"$ref": "#/$defs/imageDigest"},
        "oidcClaimsDigest": {"$ref": "#/$defs/sha256"},
        "dependencyBundleDigest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "evidenceEnvelopeDigest": {"$ref": "#/$defs/sha256"},
        "dependency": {"$ref": "#/$defs/dependency"},
        "execution": {"$ref": "#/$defs/execution"},
        "workflow": {"$ref": "#/$defs/workflow"},
        "activeRun": {"$ref": "#/$defs/activeRun"},
        "callerClosure": {"$ref": "#/$defs/closure"},
        "manifestClosure": {"$ref": "#/$defs/closure"},
        "dependencyClosure": {"$ref": "#/$defs/closure"},
        "generatedOutputClosureDigest": {"$ref": "#/$defs/sha256"},
        "cleanup": {"const": true}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerKeyId", "payloadSha256", "signature"],
      "properties": {
        "issuerKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "payloadSha256": {"$ref": "#/$defs/sha256"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contract", "binding", "signatures"],
      "properties": {
        "schemaVersion": {"const": 1},
        "contract": {"const": "managed-ci-sandbox-attestation-v1"},
        "binding": {"$ref": "#/$defs/binding"},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/signature"}}
      }
    }
  }
}
