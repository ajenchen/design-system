{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/deep-audit-evidence-contract.schema.json",
  "title": "Deep-audit immutable run and evidence envelope contract",
  "oneOf": [
    {"$ref": "#/$defs/runManifest"},
    {"$ref": "#/$defs/historicalRunManifest"},
    {"$ref": "#/$defs/activePointer"},
    {"$ref": "#/$defs/evidenceEnvelope"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "providerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "isoTime": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["blocking", "material", "marginal"]},
    "inventoryRow": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "mode", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "kind": {"enum": ["file", "symlink", "missing"]}, "mode": {"enum": ["100644", "100755", "120000", "160000"]}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "runtimeCertification": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["certificationId", "certificationStatus", "providerId", "runtimeProviderId", "runtimeKind", "surface", "repositoryRole", "targetId", "targetDigest", "certifiedAt", "expiresAt", "recordDigest", "artifactSha256", "evidenceDigest", "reference"],
      "properties": {
        "certificationId": {"$ref": "#/$defs/nonEmpty"}, "certificationStatus": {"enum": ["certified", "conditional"]}, "providerId": {"$ref": "#/$defs/providerId"}, "runtimeProviderId": {"$ref": "#/$defs/providerId"}, "runtimeKind": {"$ref": "#/$defs/nonEmpty"}, "surface": {"$ref": "#/$defs/providerId"}, "repositoryRole": {"const": "authority"}, "targetId": {"$ref": "#/$defs/nonEmpty"}, "targetDigest": {"$ref": "#/$defs/sha256"}, "certifiedAt": {"$ref": "#/$defs/isoTime"}, "expiresAt": {"$ref": "#/$defs/isoTime"}, "recordDigest": {"$ref": "#/$defs/sha256"}, "artifactSha256": {"$ref": "#/$defs/sha256"}, "evidenceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "reference": {"type": "string", "pattern": "^infra/governance/evidence/(?:provider-runtime|external-runtime)/[a-f0-9]{64}\\.json$"}
      }
    },
    "manifestProvider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "providerKind", "runtimeIdentity", "runtimeSurface", "runtimeProfileId", "reviewTransport", "reviewSkill", "reviewPeerId", "certificationContract", "reviewBindingDigest", "registryRecordDigest", "runtimeCertification"],
      "properties": {"id": {"$ref": "#/$defs/providerId"}, "displayName": {"$ref": "#/$defs/nonEmpty"}, "providerKind": {"const": "concrete-runtime"}, "runtimeIdentity": {"$ref": "#/$defs/providerId"}, "runtimeSurface": {"$ref": "#/$defs/providerId"}, "runtimeProfileId": {"$ref": "#/$defs/providerId"}, "reviewTransport": {"$ref": "#/$defs/nonEmpty"}, "reviewSkill": {"const": "deep-audit-cross-codex"}, "reviewPeerId": {"oneOf": [{"$ref": "#/$defs/providerId"}, {"type": "null"}]}, "certificationContract": {"const": "exact-provider-runtime-surface-role-target-v1"}, "reviewBindingDigest": {"$ref": "#/$defs/sha256"}, "registryRecordDigest": {"$ref": "#/$defs/sha256"}, "runtimeCertification": {"$ref": "#/$defs/runtimeCertification"}}
    },
    "historicalRunManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "evidenceKind", "runId", "createdAt", "head", "tree", "indexDigest", "inventoryDigest", "rubricDigest", "worktreeFingerprint", "authorProvider", "providerIdentityDigest", "providers", "inventory", "rubricPaths", "components"],
      "properties": {
        "schemaVersion": {"const": 3}, "contractVersion": {"const": 1}, "evidenceKind": {"const": "deep-audit-run-manifest"}, "runId": {"$ref": "#/$defs/runId"}, "createdAt": {"$ref": "#/$defs/isoTime"}, "head": {"$ref": "#/$defs/gitOid"}, "tree": {"$ref": "#/$defs/gitOid"}, "indexDigest": {"$ref": "#/$defs/sha256"}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "rubricDigest": {"$ref": "#/$defs/sha256"}, "worktreeFingerprint": {"$ref": "#/$defs/sha256"}, "authorProvider": {"$ref": "#/$defs/providerId"}, "providerIdentityDigest": {"$ref": "#/$defs/sha256"},
        "providers": {"type": "object", "additionalProperties": false, "required": ["self", "peer"], "properties": {"self": {"$ref": "#/$defs/manifestProvider"}, "peer": {"$ref": "#/$defs/manifestProvider"}}},
        "inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventoryRow"}},
        "rubricPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
        "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "paths", "digest"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}, "digest": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "reviewSelection": {
      "oneOf": [
        {"$ref": "#/$defs/selectedReviewSelection"},
        {"$ref": "#/$defs/blockedReviewSelection"},
        {"$ref": "#/$defs/waivedReviewSelection"}
      ]
    },
    "reviewSelectionBaseProperties": {
      "type": "object"
    },
    "entitlementAvailabilityRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["providerId", "invocationProfileId", "entitlementId", "source", "status", "observedAt", "expiresAt", "runtimeProviderId", "runtimeProfileId", "runtimeKind", "runtimeSurface", "repositoryRole", "target", "targetDigest", "runtimeCertificationId", "runtimeCertificationDigest", "runtimeEvidenceDigest", "adapterReadbackDigest", "evidence"],
      "properties": {
        "providerId": {"$ref": "#/$defs/providerId"}, "invocationProfileId": {"$ref": "#/$defs/providerId"}, "entitlementId": {"$ref": "#/$defs/providerId"}, "source": {"const": "verified-provider-adapter-readback"}, "status": {"const": "available"}, "observedAt": {"$ref": "#/$defs/isoTime"}, "expiresAt": {"$ref": "#/$defs/isoTime"}, "runtimeProviderId": {"$ref": "#/$defs/providerId"}, "runtimeProfileId": {"$ref": "#/$defs/providerId"}, "runtimeKind": {"$ref": "#/$defs/providerId"}, "runtimeSurface": {"$ref": "#/$defs/providerId"}, "repositoryRole": {"$ref": "#/$defs/providerId"},
        "target": {"type": "object", "additionalProperties": false, "required": ["id", "operatingSystem", "platform", "arch", "executionEnvironment", "distributionVersion", "pathClass"], "properties": {"id": {"$ref": "#/$defs/providerId"}, "operatingSystem": {"$ref": "#/$defs/nonEmpty"}, "platform": {"$ref": "#/$defs/nonEmpty"}, "arch": {"$ref": "#/$defs/nonEmpty"}, "executionEnvironment": {"$ref": "#/$defs/nonEmpty"}, "distributionVersion": {"$ref": "#/$defs/nonEmpty"}, "pathClass": {"$ref": "#/$defs/nonEmpty"}}},
        "targetDigest": {"$ref": "#/$defs/sha256"}, "runtimeCertificationId": {"$ref": "#/$defs/providerId"}, "runtimeCertificationDigest": {"$ref": "#/$defs/sha256"}, "runtimeEvidenceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "adapterReadbackDigest": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["reference", "sha256"], "properties": {"reference": {"$ref": "#/$defs/nonEmpty"}, "sha256": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "selectedReviewSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "skill", "authorProviderId", "selfProviderId", "selectionPolicy", "reviewClass", "requiredAssuranceTier", "requiredReasoningTier", "requiredComputeTier", "requiredEntitlementId", "entitlementAvailability", "entitlementAvailabilityDigest", "selected", "bindingDigest", "selectionPolicyDigest", "providerRegistryDigest", "capabilityRegistryDigest", "capabilityCertificationLedgerDigest", "invocationRegistryDigest", "modelReleaseRegistryDigest", "selectedProviderRecordDigest", "selectedProfileDigest", "selectedInvocationProfileDigest", "selectedModelReleaseDigest", "selectedCapabilityCertificationDigest", "selectionDigest"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "provider-review-capability-selection"}, "skill": {"const": "deep-audit-cross-codex"}, "authorProviderId": {"$ref": "#/$defs/providerId"}, "selfProviderId": {"$ref": "#/$defs/providerId"}, "selectionPolicy": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"}, "reviewClass": {"$ref": "#/$defs/providerId"}, "requiredAssuranceTier": {"enum": ["standard", "high", "maximum"]}, "requiredReasoningTier": {"enum": ["standard", "high", "maximum"]}, "requiredComputeTier": {"enum": ["standard", "high", "maximum"]}, "requiredEntitlementId": {"oneOf": [{"$ref": "#/$defs/providerId"}, {"type": "null"}]}, "entitlementAvailability": {"type": "array", "items": {"$ref": "#/$defs/entitlementAvailabilityRecord"}}, "entitlementAvailabilityDigest": {"$ref": "#/$defs/sha256"},
        "selected": {
          "type": "object", "additionalProperties": false,
          "required": ["providerId", "reviewProfileId", "invocationProfileId", "routeClass", "entitlementId", "modelReleaseId", "requestModelId", "assuranceTier", "reasoningTier", "computeTier", "capabilityCertificationId", "capabilityCertificationExpiresAt", "capabilityEvidenceDigest"],
          "properties": {"providerId": {"$ref": "#/$defs/providerId"}, "reviewProfileId": {"$ref": "#/$defs/providerId"}, "invocationProfileId": {"$ref": "#/$defs/providerId"}, "routeClass": {"enum": ["managed-api", "subscription-entitlement"]}, "entitlementId": {"oneOf": [{"$ref": "#/$defs/providerId"}, {"type": "null"}]}, "modelReleaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "requestModelId": {"$ref": "#/$defs/nonEmpty"}, "assuranceTier": {"enum": ["standard", "high", "maximum"]}, "reasoningTier": {"enum": ["standard", "high", "maximum"]}, "computeTier": {"enum": ["standard", "high", "maximum"]}, "capabilityCertificationId": {"$ref": "#/$defs/providerId"}, "capabilityCertificationExpiresAt": {"$ref": "#/$defs/isoTime"}, "capabilityEvidenceDigest": {"$ref": "#/$defs/sha256"}}
        },
        "bindingDigest": {"$ref": "#/$defs/sha256"}, "selectionPolicyDigest": {"$ref": "#/$defs/sha256"}, "providerRegistryDigest": {"$ref": "#/$defs/sha256"}, "capabilityRegistryDigest": {"$ref": "#/$defs/sha256"}, "capabilityCertificationLedgerDigest": {"$ref": "#/$defs/sha256"}, "invocationRegistryDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"}, "selectedProviderRecordDigest": {"$ref": "#/$defs/sha256"}, "selectedProfileDigest": {"$ref": "#/$defs/sha256"}, "selectedInvocationProfileDigest": {"$ref": "#/$defs/sha256"}, "selectedModelReleaseDigest": {"$ref": "#/$defs/sha256"}, "selectedCapabilityCertificationDigest": {"$ref": "#/$defs/sha256"}, "selectionDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "blockedReviewSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "selectionStatus", "selectionReasonCode", "skill", "authorProviderId", "selfProviderId", "selectionPolicy", "reviewClass", "requiredAssuranceTier", "requiredReasoningTier", "requiredComputeTier", "requiredEntitlementId", "entitlementAvailability", "entitlementAvailabilityDigest", "bindingDigest", "selectionPolicyDigest", "providerRegistryDigest", "capabilityRegistryDigest", "capabilityCertificationLedgerDigest", "invocationRegistryDigest", "modelReleaseRegistryDigest", "selectionDigest"],
      "properties": {
        "schemaVersion": {"const": 1}, "kind": {"const": "provider-review-capability-selection-blocked"}, "selectionStatus": {"const": "REVIEW-BLOCKED"}, "selectionReasonCode": {"enum": ["REVIEW_CAPABILITY_UNAVAILABLE", "REVIEW_ENTITLEMENT_UNAVAILABLE"]}, "skill": {"const": "deep-audit-cross-codex"}, "authorProviderId": {"$ref": "#/$defs/providerId"}, "selfProviderId": {"$ref": "#/$defs/providerId"}, "selectionPolicy": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"}, "reviewClass": {"$ref": "#/$defs/providerId"}, "requiredAssuranceTier": {"enum": ["standard", "high", "maximum"]}, "requiredReasoningTier": {"enum": ["standard", "high", "maximum"]}, "requiredComputeTier": {"enum": ["standard", "high", "maximum"]}, "requiredEntitlementId": {"oneOf": [{"$ref": "#/$defs/providerId"}, {"type": "null"}]}, "entitlementAvailability": {"type": "array", "items": {"$ref": "#/$defs/entitlementAvailabilityRecord"}}, "entitlementAvailabilityDigest": {"$ref": "#/$defs/sha256"}, "bindingDigest": {"$ref": "#/$defs/sha256"}, "selectionPolicyDigest": {"$ref": "#/$defs/sha256"}, "providerRegistryDigest": {"$ref": "#/$defs/sha256"}, "capabilityRegistryDigest": {"$ref": "#/$defs/sha256"}, "capabilityCertificationLedgerDigest": {"$ref": "#/$defs/sha256"}, "invocationRegistryDigest": {"$ref": "#/$defs/sha256"}, "modelReleaseRegistryDigest": {"$ref": "#/$defs/sha256"}, "selectionDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "waivedReviewSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "selectionStatus", "selectionReasonCode", "waiverAuthority", "waiverScope", "waivedAt", "skill", "authorProviderId", "selfProviderId", "bindingDigest", "underlyingSelection", "selectionDigest"],
      "properties": {
        "schemaVersion": {"const": 1},
        "kind": {"const": "provider-review-capability-selection-waived"},
        "selectionStatus": {"const": "REVIEW-WAIVED"},
        "selectionReasonCode": {"const": "USER_WAIVER"},
        "waiverAuthority": {"const": "user"},
        "waiverScope": {"const": "second-opinion-this-run"},
        "waivedAt": {"$ref": "#/$defs/isoTime"},
        "skill": {"const": "deep-audit-cross-codex"},
        "authorProviderId": {"$ref": "#/$defs/providerId"},
        "selfProviderId": {"$ref": "#/$defs/providerId"},
        "bindingDigest": {"$ref": "#/$defs/sha256"},
        "underlyingSelection": {"oneOf": [{"$ref": "#/$defs/selectedReviewSelection"}, {"$ref": "#/$defs/blockedReviewSelection"}]},
        "selectionDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "runManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "evidenceKind", "runId", "createdAt", "head", "tree", "indexDigest", "inventoryDigest", "rubricDigest", "worktreeFingerprint", "authorProvider", "providerIdentityDigest", "providers", "reviewSelection", "inventory", "rubricPaths", "components"],
      "properties": {
        "schemaVersion": {"const": 4}, "contractVersion": {"const": 1}, "evidenceKind": {"const": "deep-audit-run-manifest"}, "runId": {"$ref": "#/$defs/runId"}, "createdAt": {"$ref": "#/$defs/isoTime"}, "head": {"$ref": "#/$defs/gitOid"}, "tree": {"$ref": "#/$defs/gitOid"}, "indexDigest": {"$ref": "#/$defs/sha256"}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "rubricDigest": {"$ref": "#/$defs/sha256"}, "worktreeFingerprint": {"$ref": "#/$defs/sha256"}, "authorProvider": {"$ref": "#/$defs/providerId"}, "providerIdentityDigest": {"$ref": "#/$defs/sha256"},
        "providers": {"type": "object", "additionalProperties": false, "required": ["self", "peer"], "properties": {"self": {"$ref": "#/$defs/manifestProvider"}, "peer": {"oneOf": [{"$ref": "#/$defs/manifestProvider"}, {"type": "null"}]}}},
        "reviewSelection": {"$ref": "#/$defs/reviewSelection"},
        "inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventoryRow"}},
        "rubricPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
        "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "paths", "digest"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}, "digest": {"$ref": "#/$defs/sha256"}}}}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewSelection": {
                "type": "object",
                "properties": {"kind": {"enum": ["provider-review-capability-selection-blocked", "provider-review-capability-selection-waived"]}},
                "required": ["kind"]
              }
            },
            "required": ["reviewSelection"]
          },
          "then": {
            "properties": {
              "providers": {
                "type": "object",
                "properties": {
                  "self": {"type": "object", "properties": {"reviewPeerId": {"type": "null"}}},
                  "peer": {"type": "null"}
                }
              }
            }
          },
          "else": {
            "properties": {
              "providers": {
                "type": "object",
                "properties": {
                  "self": {"type": "object", "properties": {"reviewPeerId": {"$ref": "#/$defs/providerId"}}},
                  "peer": {"$ref": "#/$defs/manifestProvider"}
                }
              }
            }
          }
        }
      ]
    },
    "activePointer": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "evidenceKind", "runId", "manifestSha256"],
      "properties": {"schemaVersion": {"const": 1}, "evidenceKind": {"const": "deep-audit-active-run"}, "runId": {"$ref": "#/$defs/runId"}, "manifestSha256": {"$ref": "#/$defs/sha256"}}
    },
    "genericProducer": {
      "type": "object", "additionalProperties": false, "required": ["providerId", "runtime", "runtimeSurface", "runtimeProfileId", "model", "transport", "runtimeCertificationDigest"],
      "properties": {"providerId": {"const": "generic"}, "runtime": {"const": "deterministic-script"}, "runtimeSurface": {"const": "local"}, "runtimeProfileId": {"type": "null"}, "model": {"const": "none"}, "transport": {"const": "local-process"}, "runtimeCertificationDigest": {"type": "null"}}
    },
    "concreteProducer": {
      "type": "object", "additionalProperties": false, "required": ["providerId", "runtime", "runtimeSurface", "runtimeProfileId", "model", "transport", "runtimeCertificationDigest"],
      "properties": {"providerId": {"allOf": [{"$ref": "#/$defs/providerId"}, {"not": {"const": "generic"}}]}, "runtime": {"$ref": "#/$defs/providerId"}, "runtimeSurface": {"$ref": "#/$defs/providerId"}, "runtimeProfileId": {"$ref": "#/$defs/providerId"}, "model": {"$ref": "#/$defs/nonEmpty"}, "transport": {"$ref": "#/$defs/nonEmpty"}, "runtimeCertificationDigest": {"$ref": "#/$defs/sha256"}}
    },
    "producerAny": {"oneOf": [{"$ref": "#/$defs/genericProducer"}, {"$ref": "#/$defs/concreteProducer"}]},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "cwd", "exitCode", "startedAt", "finishedAt"],
      "properties": {"argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "cwd": {"const": "."}, "exitCode": {"type": "integer"}, "startedAt": {"$ref": "#/$defs/isoTime"}, "finishedAt": {"$ref": "#/$defs/isoTime"}}
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["nodeVersion", "npmVersion", "platform", "arch", "lockfilePath", "lockfileSha256"],
      "properties": {"nodeVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "npmVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "platform": {"$ref": "#/$defs/nonEmpty"}, "arch": {"$ref": "#/$defs/nonEmpty"}, "lockfilePath": {"const": "package-lock.json"}, "lockfileSha256": {"$ref": "#/$defs/sha256"}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["inventoryPaths", "inventoryDigest", "filesScanned"],
      "properties": {"inventoryPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}, "inventoryDigest": {"$ref": "#/$defs/sha256"}, "filesScanned": {"type": "integer", "minimum": 1}}
    },
    "localSandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["materialization", "manifestVerificationBeforeDigest", "manifestVerificationAfterDigest", "callerFingerprintBeforeDigest", "callerFingerprintAfterDigest", "dependencyViewBeforeDigest", "dependencyViewAfterDigest", "dependencyLockfileSha256", "installedLockfileSha256", "installedDependencyIdentityDigest", "dependencyProvenance", "dependencyTrust", "executionIsolation", "containmentBackend", "externalWriteContainment", "cleanup"],
      "properties": {
        "materialization": {"const": "inode-independent-copy-on-write-or-byte-copy"}, "manifestVerificationBeforeDigest": {"$ref": "#/$defs/sha256"}, "manifestVerificationAfterDigest": {"$ref": "#/$defs/sha256"}, "callerFingerprintBeforeDigest": {"$ref": "#/$defs/sha256"}, "callerFingerprintAfterDigest": {"$ref": "#/$defs/sha256"}, "dependencyViewBeforeDigest": {"$ref": "#/$defs/sha256"}, "dependencyViewAfterDigest": {"$ref": "#/$defs/sha256"}, "dependencyLockfileSha256": {"$ref": "#/$defs/sha256"}, "installedLockfileSha256": {"$ref": "#/$defs/sha256"}, "installedDependencyIdentityDigest": {"$ref": "#/$defs/sha256"}, "dependencyProvenance": {"const": "caller-node-modules-copy"}, "dependencyTrust": {"const": "untrusted-local-copy"}, "executionIsolation": {"const": "disposable-repository-copy"}, "containmentBackend": {"const": "none"}, "externalWriteContainment": {"const": "unverified"}, "cleanup": {"const": true}
      }
    },
    "managedSandbox": {"$ref": "https://qijenchen.dev/schemas/managed-ci-sandbox-receipt-v1.json"},
    "sandbox": {"oneOf": [{"$ref": "#/$defs/localSandbox"}, {"$ref": "#/$defs/managedSandbox"}]},
    "generatedOutputReceipt": {
      "type": "object", "additionalProperties": false, "required": ["declaredRoots", "beforeDigest", "afterDigest", "changedPaths"],
      "properties": {"declaredRoots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}, "beforeDigest": {"$ref": "#/$defs/sha256"}, "afterDigest": {"$ref": "#/$defs/sha256"}, "changedPaths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}}
    },
    "deterministicCommand": {
      "type": "object", "additionalProperties": false, "required": ["argv", "exitCode", "startedAt", "finishedAt", "stdoutSha256", "stderrSha256", "stdoutTail", "stderrTail", "generatedOutputReceipt"],
      "properties": {"argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "exitCode": {"type": "integer"}, "startedAt": {"$ref": "#/$defs/isoTime"}, "finishedAt": {"$ref": "#/$defs/isoTime"}, "stdoutSha256": {"$ref": "#/$defs/sha256"}, "stderrSha256": {"$ref": "#/$defs/sha256"}, "stdoutTail": {"type": "string"}, "stderrTail": {"type": "string"}, "generatedOutputReceipt": {"$ref": "#/$defs/generatedOutputReceipt"}}
    },
    "deterministicPayload": {
      "type": "object", "additionalProperties": false, "required": ["dim", "name", "planDigest", "capabilities", "commandIds", "commands", "findings", "summary", "sandboxReceipt"],
      "properties": {"dim": {"type": "integer", "minimum": 1, "maximum": 91}, "name": {"$ref": "#/$defs/nonEmpty"}, "planDigest": {"$ref": "#/$defs/sha256"}, "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "commandIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deterministicCommand"}}, "findings": {"type": "array"}, "summary": {"$ref": "#/$defs/nonEmpty"}, "sandboxReceipt": {"$ref": "#/$defs/sandbox"}}
    },
    "judgmentFinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "severity", "rule", "problem", "recommendation"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "line": {"type": "integer", "minimum": 1}, "severity": {"$ref": "#/$defs/severity"}, "rule": {"$ref": "#/$defs/nonEmpty"}, "problem": {"$ref": "#/$defs/nonEmpty"}, "recommendation": {"$ref": "#/$defs/nonEmpty"}}
    },
