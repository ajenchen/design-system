{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/deep-audit-deterministic-plan.schema.json",
  "title": "Deterministic deep-audit execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "evidenceKind",
    "capabilityOrder",
    "commands",
    "dimensions"
  ],
  "properties": {
    "$schema": { "const": "./schemas/deep-audit-deterministic-plan.schema.json" },
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "deep-audit-deterministic-execution-plan" },
    "capabilityOrder": {
      "const": ["local", "build", "network", "published-release"]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dimension" }
    }
  },
  "$defs": {
    "capability": {
      "enum": ["local", "build", "network", "published-release"]
    },
    "safeString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    },
    "outputMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "minimum"],
      "properties": {
        "pattern": { "$ref": "#/$defs/safeString" },
        "minimum": { "type": "integer", "minimum": 1 }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedExitCodes", "minimumOutputMatches", "rejectOutputPatterns"],
      "properties": {
        "acceptedExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "minimumOutputMatches": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputMatch" }
        },
        "rejectOutputPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeString" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "outputRoots",
        "capabilities",
        "timeoutSeconds",
        "completion"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/safeString" }
        },
        "cwd": { "const": "." },
        "outputRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.@/-]+$" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "completion": { "$ref": "#/$defs/completion" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeString" }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeString" }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dim", "name", "commandIds", "coverage"],
      "properties": {
        "dim": { "type": "integer", "minimum": 1, "maximum": 999 },
        "name": { "$ref": "#/$defs/safeString" },
        "commandIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    }
  }
}
