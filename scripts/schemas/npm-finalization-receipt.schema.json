{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qijenchen.dev/schemas/npm-finalization-receipt.schema.json",
  "title": "Immutable-release npm finalization audit evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "source", "releaseTrust", "releaseSetSha256", "bomSha256", "stageReceiptSha256", "stageRun", "finalizerRun", "stagingTag", "targetTag", "targetVersion", "publishOrder", "stageIds", "isolatedTags", "targetTags", "packages", "certifiedAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 3},
    "state": {"const": "certified"},
    "source": {"$ref": "npm-stage-receipt.schema.json#/$defs/source"},
    "releaseTrust": {"$ref": "npm-stage-receipt.schema.json#/$defs/releaseTrust"},
    "releaseSetSha256": {"$ref": "#/$defs/sha256"},
    "bomSha256": {"$ref": "#/$defs/sha256"},
    "stageReceiptSha256": {"$ref": "#/$defs/sha256"},
    "stageRun": {"$ref": "#/$defs/stageRun"},
    "finalizerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "event", "runId", "runAttempt"],
      "properties": {
        "workflow": {"const": ".github/workflows/release-finalize.yml"},
        "event": {"const": "repository_dispatch"},
        "runId": {"$ref": "#/$defs/positiveIntegerString"},
        "runAttempt": {"type": "integer", "minimum": 1}
      }
    },
    "stagingTag": {"type": "string", "pattern": "^governance-stage-[0-9A-Za-z._-]+$"},
    "targetTag": {"enum": ["beta", "latest"]},
    "targetVersion": {"$ref": "#/$defs/semver"},
    "publishOrder": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stageIds": {"$ref": "#/$defs/stageIds"},
    "isolatedTags": {"$ref": "#/$defs/tagMap"},
    "targetTags": {"$ref": "#/$defs/tagMap"},
    "packages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "integrity", "shasum"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"$ref": "#/$defs/semver"},
          "integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
          "shasum": {"$ref": "#/$defs/sha1"}
        }
      }
    },
    "certifiedAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "uuid": {"type": "string", "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"},
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "digest", "sizeInBytes", "createdAt", "expiresAt"],
      "properties": {
        "id": {"$ref": "#/$defs/positiveIntegerString"},
        "name": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sizeInBytes": {"type": "integer", "minimum": 1},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "stageRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "repository", "workflow", "artifact", "releaseTrustArtifact"],
      "properties": {
        "schemaVersion": {"const": 2},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "event", "headBranch", "runId", "runAttempt", "headSha", "status", "conclusion"],
          "properties": {
            "path": {"const": ".github/workflows/release.yml"},
            "event": {"const": "repository_dispatch"},
            "headBranch": {"const": "main"},
            "runId": {"$ref": "#/$defs/positiveIntegerString"},
            "runAttempt": {"type": "integer", "minimum": 1},
            "headSha": {"$ref": "#/$defs/sha1"},
            "status": {"const": "completed"},
            "conclusion": {"const": "success"}
          }
        },
        "artifact": {"$ref": "#/$defs/artifactIdentity"},
        "releaseTrustArtifact": {"$ref": "#/$defs/artifactIdentity"}
      }
    },
    "stageIds": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/uuid"}
    },
    "tagMap": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/semver"}
    }
  }
}
