{
  "schemaVersion": 1,
  "kind": "standard-five-step-ci-evidence-plan",
  "profile": "PRODUCTION_GRADE_SINGLE_OWNER_SMALL_TEAM",
  "workflowPlan": "infra/governance/release-workflow.json",
  "steps": ["pr-checks", "merge", "publish", "readback", "consumer"],
  "dimensions": [
    {
      "dim": 64,
      "capability": "protected-release-propagation",
      "workflow": ".github/workflows/release.yml",
      "event": "repository_dispatch"
    },
    {
      "dim": 66,
      "capability": "cross-repo-visual-parity",
      "workflow": ".github/workflows/mirror-to-published-template.yml",
      "event": "repository_dispatch"
    }
  ],
  "authority": {
    "repositoryId": "design-system",
    "requiredCheck": "Verify(tsc + tests + compile + build)"
  },
  "consumerSelection": {
    "note": "consumers 列的是「可能被升級」的 consumer 全集與各自的證據規則。每次發版只要求「實際被選中、而且是第五步完成條件」的 consumer 交「已合併、已讀回」的升級證據:template(upgrade: automatic、合併由 orchestrator 負責)恆是。產品 canary ajenchen/workspace 是 upgrade: automatic、merge: consumer-owned —— 發版只替它開升級 PR,合不合由它自己決定,所以記成 observation.consumerSelection.consumerOwned,不要求它的升級證據,也不得為了讓 dim 64/66 變綠而去合併它的 PR。upgrade: on-request 的 consumer 只在 user 明確要求、以 RELEASE_REQUESTED_CONSUMERS=<owner>/<repo> 帶進來時才被選中,沒被選中的記成 observation.consumerSelection.notRequested;這個值是為 work-management 加的(user 2026-11-05 原話:「以後WM的升級都不要自動做除非我有特別要求」),該 repo 已於 2026-11-25 退場,目前沒有 consumer 使用。兩種紀錄都不得默默消失。",
    "source": "infra/governance/release-workflow.json#/automation/consumers/*/upgrade",
    "implementation": "scripts/lib/release-consumer-selection.mjs",
    "requestEnv": "RELEASE_REQUESTED_CONSUMERS",
    "notRequestedStatus": "not-requested-this-release",
    "consumerOwnedStatus": "pull-request-only-not-a-completion-condition"
  },
  "consumers": [
    {
      "repositoryId": "ds-product-template",
      "role": "template-mirror",
      "sourceWorkflow": ".github/workflows/mirror-to-published-template.yml",
      "sourceEvent": "repository_dispatch",
      "requiredCheck": "Verify consumer"
    },
    {
      "repositoryId": "workspace",
      "role": "product-consumer",
      "sourceWorkflow": ".github/workflows/sync-design-system.yml",
      "sourceEvent": "repository_dispatch",
      "requiredCheck": "Verify consumer"
    }
  ],
  "legacyMaximumAssurance": {
    "blocking": false,
    "status": "retired-2026-08-04-with-activation-cluster"
  }
}
